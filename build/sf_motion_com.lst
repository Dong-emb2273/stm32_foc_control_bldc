 128:Lib/SF_MOTION_COM/sf_motion_com.c ****             com->plotter[i].addr = com->plotter[i + 1].addr;
 129:Lib/SF_MOTION_COM/sf_motion_com.c ****           }
 130:Lib/SF_MOTION_COM/sf_motion_com.c ****           com->plotter_line--;
