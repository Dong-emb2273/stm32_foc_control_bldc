 116:Lib/SF_MOTION_COM/sf_motion_com.c **** 
 117:Lib/SF_MOTION_COM/sf_motion_com.c ****     case SFM_COM_TYPE_DISABLE_STREAMING: {
 118:Lib/SF_MOTION_COM/sf_motion_com.c ****       if (streaming == SFM_COM_STREAM_ENA) {
 119:Lib/SF_MOTION_COM/sf_motion_com.c ****         int start_idx = -1;
