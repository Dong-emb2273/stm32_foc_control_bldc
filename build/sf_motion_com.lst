  98:Lib/SF_MOTION_COM/sf_motion_com.c **** 
  99:Lib/SF_MOTION_COM/sf_motion_com.c ****     case SFM_COM_TYPE_ENABLE_STREAMING: {
 100:Lib/SF_MOTION_COM/sf_motion_com.c ****       if (streaming == SFM_COM_STREAM_ENA) {
 101:Lib/SF_MOTION_COM/sf_motion_com.c ****         _Bool already_enabled = 0;
 102:Lib/SF_MOTION_COM/sf_motion_com.c ****         for (int i = 0; i < com->plotter_line; i++) {
 103:Lib/SF_MOTION_COM/sf_motion_com.c ****           if (com->plotter[i].addr == addr) {
 104:Lib/SF_MOTION_COM/sf_motion_com.c ****             already_enabled = 1;
 105:Lib/SF_MOTION_COM/sf_motion_com.c ****             break;
 106:Lib/SF_MOTION_COM/sf_motion_com.c ****           }
 107:Lib/SF_MOTION_COM/sf_motion_com.c ****         }
 108:Lib/SF_MOTION_COM/sf_motion_com.c ****         if (!already_enabled && com->plotter_line < MAX_PLOTTER_LINE) {
 109:Lib/SF_MOTION_COM/sf_motion_com.c ****           com->plotter[com->plotter_line].addr = addr;
 110:Lib/SF_MOTION_COM/sf_motion_com.c ****           com->plotter_line++;
 111:Lib/SF_MOTION_COM/sf_motion_com.c ****           ret_val = 0;
 112:Lib/SF_MOTION_COM/sf_motion_com.c ****         }
 113:Lib/SF_MOTION_COM/sf_motion_com.c ****       }
 114:Lib/SF_MOTION_COM/sf_motion_com.c ****       break;
