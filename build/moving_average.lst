  40:Lib/Digital_Filter/moving_average.c ****             data[i]   = sum * inv_win;    /* write smoothed value in place */
  41:Lib/Digital_Filter/moving_average.c ****             sum      += add - drop;
  42:Lib/Digital_Filter/moving_average.c **** 
