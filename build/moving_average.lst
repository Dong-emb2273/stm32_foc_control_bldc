  33:Lib/Digital_Filter/moving_average.c ****                                   : data[i - r + n];     /* tail, still original */
  34:Lib/Digital_Filter/moving_average.c **** 
  35:Lib/Digital_Filter/moving_average.c ****             /* Sample entering the window: x[i + r + 1] */
