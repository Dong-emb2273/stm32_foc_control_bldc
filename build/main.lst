 347:Core/Src/main.c **** static void event_update(void) {
 348:Core/Src/main.c ****   foc_error_t error_code = FOC_ERROR_NONE;
 349:Core/Src/main.c ****   if (foc_get_error_flag(&hfoc1, &error_code)) {
 350:Core/Src/main.c ****     switch (error_code) {
 351:Core/Src/main.c ****       case FOC_ERROR_I2T_TRIPPED: {
 352:Core/Src/main.c ****         sfm_com_send_event(&husb_com, SFM_EVENT_I2T_TRIPPED);
 353:Core/Src/main.c ****         sfm_com_send_event(&hcan_com, SFM_EVENT_I2T_TRIPPED);
 354:Core/Src/main.c ****         break;
 355:Core/Src/main.c ****       }
 356:Core/Src/main.c ****       case FOC_ERROR_OVER_VOLTAGE: {
 357:Core/Src/main.c ****         sfm_com_send_event(&husb_com, SFM_EVENT_OVER_VOLTAGE);
 358:Core/Src/main.c ****         sfm_com_send_event(&hcan_com, SFM_EVENT_OVER_VOLTAGE);
 359:Core/Src/main.c ****         break;
 360:Core/Src/main.c ****       }
 361:Core/Src/main.c ****       case FOC_ERROR_UNDER_VOLTAGE: {
 362:Core/Src/main.c ****         sfm_com_send_event(&husb_com, SFM_EVENT_UNDER_VOLTAGE);
 363:Core/Src/main.c ****         sfm_com_send_event(&hcan_com, SFM_EVENT_UNDER_VOLTAGE);
 364:Core/Src/main.c ****         break;
 365:Core/Src/main.c ****       }
 366:Core/Src/main.c ****       default:
 367:Core/Src/main.c ****         break;
 368:Core/Src/main.c ****     }
 369:Core/Src/main.c ****   }
 370:Core/Src/main.c **** }
