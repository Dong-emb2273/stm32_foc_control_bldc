 276:Core/Src/main.c **** static void self_commissioning_update(void) {
 277:Core/Src/main.c ****   if (sc_is_measure_done(&hsc1)) {
 278:Core/Src/main.c ****     switch(sc_get_seq(&hsc1)) {
 279:Core/Src/main.c ****       case SC_SEQUENCE_START_MEASURE_RS:
 280:Core/Src/main.c ****         foc_set_motor_Rs(&hfoc1, sc_get_Rs(&hsc1));
 281:Core/Src/main.c ****         break;
 282:Core/Src/main.c ****       case SC_SEQUENCE_START_MEASURE_LD:
 283:Core/Src/main.c ****         foc_set_motor_Ld(&hfoc1, sc_get_Ld(&hsc1));
 284:Core/Src/main.c ****         break;
 285:Core/Src/main.c ****       case SC_SEQUENCE_START_MEASURE_LQ:
 286:Core/Src/main.c ****         foc_set_motor_Lq(&hfoc1, sc_get_Lq(&hsc1));
 287:Core/Src/main.c ****         break;
 288:Core/Src/main.c ****       case SC_SEQUENCE_START_CALIBRATE_ABS_ENCODER:
 289:Core/Src/main.c ****         break;
 290:Core/Src/main.c ****       case SC_SEQUENCE_START_CALC_POLE_PAIRS:
 291:Core/Src/main.c ****         break;
ARM GAS  /tmp/ccKj9n2o.s 			page 7


 292:Core/Src/main.c ****       case SC_SEQUENCE_START_MEASURE_COGGING_TORQUE:
 293:Core/Src/main.c ****         husb_com.show_cogging_torque_lut = 1;
 294:Core/Src/main.c ****         break;
 295:Core/Src/main.c ****       default:
 296:Core/Src/main.c ****         break;
 297:Core/Src/main.c ****     }
 298:Core/Src/main.c ****     sfm_com_send_event(&hcan_com, SFM_EVENT_SELFCOM_DONE);
 299:Core/Src/main.c ****   }
 300:Core/Src/main.c **** }
 301:Core/Src/main.c **** 
 302:Core/Src/main.c **** static void event_update(void) {
 303:Core/Src/main.c ****   foc_error_t error_code = FOC_ERROR_NONE;
 304:Core/Src/main.c ****   if (foc_get_error_flag(&hfoc1, &error_code)) {
 305:Core/Src/main.c ****     switch (error_code) {
 306:Core/Src/main.c ****       case FOC_ERROR_I2T_TRIPPED: {
 307:Core/Src/main.c ****         sfm_com_send_event(&husb_com, SFM_EVENT_I2T_TRIPPED);
 308:Core/Src/main.c ****         sfm_com_send_event(&hcan_com, SFM_EVENT_I2T_TRIPPED);
 309:Core/Src/main.c ****         break;
 310:Core/Src/main.c ****       }
 311:Core/Src/main.c ****       case FOC_ERROR_OVER_VOLTAGE: {
 312:Core/Src/main.c ****         sfm_com_send_event(&husb_com, SFM_EVENT_OVER_VOLTAGE);
 313:Core/Src/main.c ****         sfm_com_send_event(&hcan_com, SFM_EVENT_OVER_VOLTAGE);
 314:Core/Src/main.c ****         break;
 315:Core/Src/main.c ****       }
 316:Core/Src/main.c ****       case FOC_ERROR_UNDER_VOLTAGE: {
 317:Core/Src/main.c ****         sfm_com_send_event(&husb_com, SFM_EVENT_UNDER_VOLTAGE);
 318:Core/Src/main.c ****         sfm_com_send_event(&hcan_com, SFM_EVENT_UNDER_VOLTAGE);
 319:Core/Src/main.c ****         break;
 320:Core/Src/main.c ****       }
 321:Core/Src/main.c ****       default:
 322:Core/Src/main.c ****         break;
 323:Core/Src/main.c ****     }
 324:Core/Src/main.c ****   }
 325:Core/Src/main.c **** }
