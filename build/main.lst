 320:Core/Src/main.c **** static void self_commissioning_update(void) {
 321:Core/Src/main.c ****   if (sc_is_measure_done(&hsc1)) {
 322:Core/Src/main.c ****     switch(sc_get_seq(&hsc1)) {
 323:Core/Src/main.c ****       case SC_SEQUENCE_START_MEASURE_RS:
 324:Core/Src/main.c ****         foc_set_motor_Rs(&hfoc1, sc_get_Rs(&hsc1));
 325:Core/Src/main.c ****         break;
 326:Core/Src/main.c ****       case SC_SEQUENCE_START_MEASURE_LD:
 327:Core/Src/main.c ****         foc_set_motor_Ld(&hfoc1, sc_get_Ld(&hsc1));
 328:Core/Src/main.c ****         break;
 329:Core/Src/main.c ****       case SC_SEQUENCE_START_MEASURE_LQ:
 330:Core/Src/main.c ****         foc_set_motor_Lq(&hfoc1, sc_get_Lq(&hsc1));
 331:Core/Src/main.c ****         break;
 332:Core/Src/main.c ****       case SC_SEQUENCE_START_CALIBRATE_ABS_ENCODER:
 333:Core/Src/main.c ****         break;
 334:Core/Src/main.c ****       case SC_SEQUENCE_START_CALC_POLE_PAIRS:
 335:Core/Src/main.c ****         break;
 336:Core/Src/main.c ****       case SC_SEQUENCE_START_MEASURE_COGGING_TORQUE:
 337:Core/Src/main.c ****         husb_com.show_cogging_torque_lut = 1;
 338:Core/Src/main.c ****         break;
 339:Core/Src/main.c ****       default:
 340:Core/Src/main.c ****         break;
 341:Core/Src/main.c ****     }
 342:Core/Src/main.c ****     sfm_com_send_event(&husb_com, SFM_EVENT_SELFCOM_DONE);
 343:Core/Src/main.c ****     sfm_com_send_event(&hcan_com, SFM_EVENT_SELFCOM_DONE);
 344:Core/Src/main.c ****   }
 345:Core/Src/main.c **** }
