  29:Core/Src/fsm.c **** void run_fsm(FSMStruct * fsmstate){
  30:Core/Src/fsm.c **** 	/* run_fsm is run every commutation interrupt cycle */
  31:Core/Src/fsm.c **** 
  32:Core/Src/fsm.c **** 	/* state transition management */
  33:Core/Src/fsm.c **** 	if(fsmstate->next_state != fsmstate->state){
  34:Core/Src/fsm.c **** 		fsm_exit_state(fsmstate);		// safely exit the old state
  35:Core/Src/fsm.c **** 		if(fsmstate->ready){			// if the previous state is ready, enter the new state
  36:Core/Src/fsm.c **** 			fsmstate->state = fsmstate->next_state;
  37:Core/Src/fsm.c **** 			fsm_enter_state(fsmstate);
  38:Core/Src/fsm.c **** 		}
  39:Core/Src/fsm.c **** 	}
  40:Core/Src/fsm.c **** 
  41:Core/Src/fsm.c **** 	switch(fsmstate->state){
  42:Core/Src/fsm.c **** 		case MENU_MODE:
  43:Core/Src/fsm.c **** 			break;
  44:Core/Src/fsm.c **** 
  45:Core/Src/fsm.c **** 		case CALIBRATION_MODE:
  46:Core/Src/fsm.c **** 			// if(!hfoc.done_orderphase){foc_auto_calibration_update(&hfoc);}
  47:Core/Src/fsm.c **** 			// else if(!hfoc.done_cal_encoder){foc_auto_cal_encoder_update(&hfoc);}
  48:Core/Src/fsm.c ****             
  49:Core/Src/fsm.c ****         
  50:Core/Src/fsm.c ****             if(hfoc.done_cal_encoder == 1 && hfoc.done_orderphase == 1){
  51:Core/Src/fsm.c ****                 
  52:Core/Src/fsm.c ****                 printf("Calibration Successful!\r\n");
  53:Core/Src/fsm.c ****                 
  54:Core/Src/fsm.c ****                 
  55:Core/Src/fsm.c ****                 update_fsm(fsmstate, 27);
  56:Core/Src/fsm.c **** 				
  57:Core/Src/fsm.c ****             }
