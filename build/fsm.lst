 153:Core/Src/fsm.c **** void update_fsm(FSMStruct * fsmstate, char fsm_input){
 154:Core/Src/fsm.c **** 	/*update_fsm is only run when new state-change information is received
 155:Core/Src/fsm.c **** 	* on serial terminal input or CAN input
 156:Core/Src/fsm.c **** 	*/
 157:Core/Src/fsm.c **** 	if(fsm_input == MENU_CMD){	// escape to exit to rest mode
 158:Core/Src/fsm.c **** 		fsmstate->next_state = MENU_MODE;
 159:Core/Src/fsm.c **** 		fsmstate->ready = 0;
 160:Core/Src/fsm.c **** 		return;
 161:Core/Src/fsm.c **** 	}
 162:Core/Src/fsm.c **** 	switch(fsmstate->state){
 163:Core/Src/fsm.c **** 		case MENU_MODE:
 164:Core/Src/fsm.c **** 			switch (fsm_input){
 165:Core/Src/fsm.c **** 				case CAL_CMD:
 166:Core/Src/fsm.c **** 					fsmstate->next_state = CALIBRATION_MODE;
 167:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 168:Core/Src/fsm.c **** 					break;
 169:Core/Src/fsm.c **** 				case MOTOR_CMD:
 170:Core/Src/fsm.c **** 					fsmstate->next_state = MOTOR_MODE;
 171:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 172:Core/Src/fsm.c **** 					break;
 173:Core/Src/fsm.c **** 				case ENCODER_CMD:
 174:Core/Src/fsm.c **** 					fsmstate->next_state = ENCODER_MODE;
 175:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 176:Core/Src/fsm.c **** 					break;
 177:Core/Src/fsm.c **** 				case SETUP_CMD:
 178:Core/Src/fsm.c **** 					fsmstate->next_state = SETUP_MODE;
 179:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 180:Core/Src/fsm.c **** 					break;
 181:Core/Src/fsm.c **** 				case TEST_CMD:
 182:Core/Src/fsm.c **** 					fsmstate->next_state = TEST_MODE;
 183:Core/Src/fsm.c **** 					fsmstate->ready = 0;
ARM GAS  /tmp/ccsLTzd2.s 			page 8


 184:Core/Src/fsm.c **** 					break;
 185:Core/Src/fsm.c **** 				case ZERO_CMD:
 186:Core/Src/fsm.c **** 					M_ZERO = ENCODER_GetActualDegree(&encoder); 
 187:Core/Src/fsm.c **** 					
 188:Core/Src/fsm.c **** 					SPOINT_POS = 0.0f;
 189:Core/Src/fsm.c **** 					// hfoc.sPoint_Pos = 0.0f;
 190:Core/Src/fsm.c **** 					printf("\n\r new zero position: %.3f deg\r\n", M_ZERO);
 191:Core/Src/fsm.c **** 					
 192:Core/Src/fsm.c **** 					break;
 193:Core/Src/fsm.c **** 				}
 194:Core/Src/fsm.c **** 			break;
 195:Core/Src/fsm.c **** 		case SETUP_MODE:
