  78:Core/Src/fsm.c **** void fsm_enter_state(FSMStruct * fsmstate){
  79:Core/Src/fsm.c **** 	/* Called when entering a new state
  80:Core/Src/fsm.c **** 	* Do necessary setup   */
  81:Core/Src/fsm.c **** 	STATE = fsmstate->state;
  82:Core/Src/fsm.c **** 	NEXT_STATE = fsmstate->next_state;
  83:Core/Src/fsm.c **** 	switch(fsmstate->state){
  84:Core/Src/fsm.c **** 			case MENU_MODE:
  85:Core/Src/fsm.c **** 			//printf("Entering Main Menu\r\n");
  86:Core/Src/fsm.c **** 			CF_RUNNING;
  87:Core/Src/fsm.c **** 			DRV8323RS_Disnable;
  88:Core/Src/fsm.c **** 			enter_menu_state();
  89:Core/Src/fsm.c **** 			break;
  90:Core/Src/fsm.c **** 		case SETUP_MODE:
  91:Core/Src/fsm.c **** 			printf("Entering Setup\r\n");
  92:Core/Src/fsm.c **** 			enter_setup_state();
  93:Core/Src/fsm.c **** 			break;
  94:Core/Src/fsm.c **** 		case TEST_MODE:
  95:Core/Src/fsm.c **** 			DRV8323RS_Disnable;
  96:Core/Src/fsm.c **** 			CF_RUNNING;
  97:Core/Src/fsm.c **** 			enter_test_state();
  98:Core/Src/fsm.c **** 			break;
  99:Core/Src/fsm.c **** 		case ENCODER_MODE:
 100:Core/Src/fsm.c **** 			//printf("Entering Encoder Mode\r\n");
 101:Core/Src/fsm.c **** 			break;
 102:Core/Src/fsm.c **** 		case MOTOR_MODE:
 103:Core/Src/fsm.c **** 			printf("Entering Motor Mode\r\n");
 104:Core/Src/fsm.c **** 			DRV8323RS_Enable;
 105:Core/Src/fsm.c **** 			SF_RUNNING;
 106:Core/Src/fsm.c **** 			break;
 107:Core/Src/fsm.c **** 		case CALIBRATION_MODE:
 108:Core/Src/fsm.c **** 			printf("Starting Calibration Mode\r\n");
 109:Core/Src/fsm.c **** 			DRV8323RS_Enable;
 110:Core/Src/fsm.c ****             foc_start_calibration(&hfoc);  
 111:Core/Src/fsm.c **** 			break;
 112:Core/Src/fsm.c **** 
 113:Core/Src/fsm.c **** 	}
 114:Core/Src/fsm.c **** }
