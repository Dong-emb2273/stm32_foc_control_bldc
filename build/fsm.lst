 149:Core/Src/fsm.c **** void update_fsm(FSMStruct * fsmstate, char fsm_input){
 150:Core/Src/fsm.c **** 	/*update_fsm is only run when new state-change information is received
 151:Core/Src/fsm.c **** 	* on serial terminal input or CAN input
 152:Core/Src/fsm.c **** 	*/
 153:Core/Src/fsm.c **** 	if(fsm_input == MENU_CMD){	// escape to exit to rest mode
 154:Core/Src/fsm.c **** 		fsmstate->next_state = MENU_MODE;
 155:Core/Src/fsm.c **** 		fsmstate->ready = 0;
 156:Core/Src/fsm.c **** 		return;
 157:Core/Src/fsm.c **** 	}
 158:Core/Src/fsm.c **** 	switch(fsmstate->state){
 159:Core/Src/fsm.c **** 		case MENU_MODE:
 160:Core/Src/fsm.c **** 			switch (fsm_input){
ARM GAS  /tmp/ccSxgCqe.s 			page 11


 161:Core/Src/fsm.c **** 				case CAL_CMD:
 162:Core/Src/fsm.c **** 					fsmstate->next_state = CALIBRATION_MODE;
 163:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 164:Core/Src/fsm.c **** 					break;
 165:Core/Src/fsm.c **** 				case MOTOR_CMD:
 166:Core/Src/fsm.c **** 					fsmstate->next_state = MOTOR_MODE;
 167:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 168:Core/Src/fsm.c **** 					break;
 169:Core/Src/fsm.c **** 				case ENCODER_CMD:
 170:Core/Src/fsm.c **** 					fsmstate->next_state = ENCODER_MODE;
 171:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 172:Core/Src/fsm.c **** 					break;
 173:Core/Src/fsm.c **** 				case SETUP_CMD:
 174:Core/Src/fsm.c **** 					fsmstate->next_state = SETUP_MODE;
 175:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 176:Core/Src/fsm.c **** 					break;
 177:Core/Src/fsm.c **** 				case TEST_CMD:
 178:Core/Src/fsm.c **** 					fsmstate->next_state = TEST_MODE;
 179:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 180:Core/Src/fsm.c **** 					break;
 181:Core/Src/fsm.c **** 				case ZERO_CMD:
 182:Core/Src/fsm.c **** 					M_ZERO = ENCODER_GetActualDegree(&encoder); 
 183:Core/Src/fsm.c **** 					
 184:Core/Src/fsm.c **** 					SPOINT_POS = 0.0f;
 185:Core/Src/fsm.c **** 					// hfoc.sPoint_Pos = 0.0f;
 186:Core/Src/fsm.c **** 					printf("\n\r new zero position: %.3f deg\r\n", M_ZERO);
 187:Core/Src/fsm.c **** 					
 188:Core/Src/fsm.c **** 					break;
 189:Core/Src/fsm.c **** 				}
 190:Core/Src/fsm.c **** 			break;
 191:Core/Src/fsm.c **** 		case SETUP_MODE:
 192:Core/Src/fsm.c **** 			if(fsm_input == 10 || fsm_input == ' '){ 
 193:Core/Src/fsm.c ****         		break; 
 194:Core/Src/fsm.c ****     		}	
 195:Core/Src/fsm.c **** 			if(fsm_input == ENTER_CMD){
 196:Core/Src/fsm.c **** 				process_user_input(fsmstate);
 197:Core/Src/fsm.c **** 				break;
 198:Core/Src/fsm.c **** 			}
 199:Core/Src/fsm.c **** 			if(fsmstate->bytecount == 0){fsmstate->cmd_id = fsm_input;}
 200:Core/Src/fsm.c **** 			else{
 201:Core/Src/fsm.c **** 				fsmstate->cmd_buff[fsmstate->bytecount-1] = fsm_input;
 202:Core/Src/fsm.c **** 				//fsmstate->bytecount = fsmstate->bytecount%(sizeof(fsmstate->cmd_buff)/sizeof(fsmstate->cmd_bu
 203:Core/Src/fsm.c **** 			}
 204:Core/Src/fsm.c **** 			fsmstate->bytecount++;
 205:Core/Src/fsm.c **** 			/* If enter is typed, process user input */
 206:Core/Src/fsm.c **** 
 207:Core/Src/fsm.c **** 			break;
 208:Core/Src/fsm.c **** 		case TEST_MODE:
 209:Core/Src/fsm.c **** 			if(fsm_input == 10 || fsm_input == ' '){ 
 210:Core/Src/fsm.c ****         		break; 
 211:Core/Src/fsm.c ****     		}	
 212:Core/Src/fsm.c **** 			if(fsm_input == ENTER_CMD){
 213:Core/Src/fsm.c **** 				set_pid_mode(fsmstate);
 214:Core/Src/fsm.c **** 				break;
 215:Core/Src/fsm.c **** 			}
 216:Core/Src/fsm.c **** 			if(fsmstate->bytecount == 0){fsmstate->cmd_id = fsm_input;}
 217:Core/Src/fsm.c **** 			else{
