  73:Core/Src/fsm.c **** void fsm_enter_state(FSMStruct * fsmstate){
  74:Core/Src/fsm.c **** 	/* Called when entering a new state
  75:Core/Src/fsm.c **** 	* Do necessary setup   */
  76:Core/Src/fsm.c **** 	STATE = fsmstate->state;
  77:Core/Src/fsm.c **** 	NEXT_STATE = fsmstate->next_state;
  78:Core/Src/fsm.c **** 	switch(fsmstate->state){
  79:Core/Src/fsm.c **** 			case MENU_MODE:
  80:Core/Src/fsm.c **** 			//printf("Entering Main Menu\r\n");
  81:Core/Src/fsm.c **** 			DRV8323RS_Disnable;
  82:Core/Src/fsm.c **** 			enter_menu_state();
  83:Core/Src/fsm.c **** 			break;
  84:Core/Src/fsm.c **** 		case SETUP_MODE:
  85:Core/Src/fsm.c **** 			DRV8323RS_Disnable;
  86:Core/Src/fsm.c **** 			printf("Entering Setup\r\n");
  87:Core/Src/fsm.c **** 			enter_setup_state();
  88:Core/Src/fsm.c **** 			break;
  89:Core/Src/fsm.c **** 		case TEST_MODE:
  90:Core/Src/fsm.c **** 			DRV8323RS_Enable;
  91:Core/Src/fsm.c **** 			enter_test_mode();
  92:Core/Src/fsm.c **** 			break;
  93:Core/Src/fsm.c **** 		case ENCODER_MODE:
  94:Core/Src/fsm.c **** 			//printf("Entering Encoder Mode\r\n");
  95:Core/Src/fsm.c **** 			break;
  96:Core/Src/fsm.c **** 		case MOTOR_MODE:
  97:Core/Src/fsm.c **** 			printf("Entering Motor Mode\r\n");
  98:Core/Src/fsm.c **** 			DRV8323RS_Enable;
  99:Core/Src/fsm.c **** 			break;
 100:Core/Src/fsm.c **** 		case CALIBRATION_MODE:
 101:Core/Src/fsm.c **** 			printf("Starting Calibration Mode\r\n");
 102:Core/Src/fsm.c **** 			DRV8323RS_Enable;
 103:Core/Src/fsm.c ****             foc_start_calibration(&hfoc);  
 104:Core/Src/fsm.c **** 			break;
 105:Core/Src/fsm.c **** 
 106:Core/Src/fsm.c **** 	}
 107:Core/Src/fsm.c **** }
