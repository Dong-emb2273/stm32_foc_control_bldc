  77:Core/Src/fsm.c **** void fsm_enter_state(FSMStruct * fsmstate){
  78:Core/Src/fsm.c **** 	/* Called when entering a new state
  79:Core/Src/fsm.c **** 	* Do necessary setup   */
  80:Core/Src/fsm.c **** 	STATE = fsmstate->state;
  81:Core/Src/fsm.c **** 	NEXT_STATE = fsmstate->next_state;
  82:Core/Src/fsm.c **** 	switch(fsmstate->state){
  83:Core/Src/fsm.c **** 			case MENU_MODE:
  84:Core/Src/fsm.c **** 			//printf("Entering Main Menu\r\n");
  85:Core/Src/fsm.c **** 			MOTOR_RUNNING = 0;
  86:Core/Src/fsm.c **** 			DRV8323RS_Disnable;
  87:Core/Src/fsm.c **** 			enter_menu_state();
  88:Core/Src/fsm.c **** 			break;
  89:Core/Src/fsm.c **** 		case SETUP_MODE:
  90:Core/Src/fsm.c **** 			printf("Entering Setup\r\n");
  91:Core/Src/fsm.c **** 			enter_setup_state();
  92:Core/Src/fsm.c **** 			break;
  93:Core/Src/fsm.c **** 		case TEST_MODE:
  94:Core/Src/fsm.c **** 			DRV8323RS_Disnable;
  95:Core/Src/fsm.c **** 			MOTOR_RUNNING = 0;
  96:Core/Src/fsm.c **** 			enter_test_state();
  97:Core/Src/fsm.c **** 			break;
  98:Core/Src/fsm.c **** 		case ENCODER_MODE:
  99:Core/Src/fsm.c **** 			//printf("Entering Encoder Mode\r\n");
 100:Core/Src/fsm.c **** 			break;
 101:Core/Src/fsm.c **** 		case MOTOR_MODE:
 102:Core/Src/fsm.c **** 			printf("Entering Motor Mode\r\n");
 103:Core/Src/fsm.c **** 			DRV8323RS_Enable;
 104:Core/Src/fsm.c **** 			MOTOR_RUNNING = 1;
 105:Core/Src/fsm.c **** 			break;
 106:Core/Src/fsm.c **** 		case CALIBRATION_MODE:
 107:Core/Src/fsm.c **** 			printf("Starting Calibration Mode\r\n");
 108:Core/Src/fsm.c **** 			DRV8323RS_Enable;
 109:Core/Src/fsm.c ****             foc_start_calibration(&hfoc);  
 110:Core/Src/fsm.c **** 			break;
 111:Core/Src/fsm.c **** 
 112:Core/Src/fsm.c **** 	}
 113:Core/Src/fsm.c **** }
