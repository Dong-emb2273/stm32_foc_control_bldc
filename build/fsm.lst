 186:Core/Src/fsm.c **** void update_fsm(FSMStruct * fsmstate, char fsm_input){
 187:Core/Src/fsm.c **** 	/*update_fsm is only run when new state-change information is received
 188:Core/Src/fsm.c **** 	* on serial terminal input or CAN input
 189:Core/Src/fsm.c **** 	*/
 190:Core/Src/fsm.c **** 	if(fsm_input == MENU_CMD){	// escape to exit to rest mode
 191:Core/Src/fsm.c **** 		fsmstate->next_state = MENU_MODE;
 192:Core/Src/fsm.c **** 		fsmstate->ready = 0;
 193:Core/Src/fsm.c **** 		return;
 194:Core/Src/fsm.c **** 	}
 195:Core/Src/fsm.c **** 	switch(fsmstate->state){
 196:Core/Src/fsm.c **** 		case MENU_MODE:
 197:Core/Src/fsm.c **** 			switch (fsm_input){
 198:Core/Src/fsm.c **** 				case CAL_CMD:
 199:Core/Src/fsm.c **** 					fsmstate->next_state = CALIBRATION_MODE;
 200:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 201:Core/Src/fsm.c **** 					break;
 202:Core/Src/fsm.c **** 				case MOTOR_CMD:
 203:Core/Src/fsm.c **** 					fsmstate->next_state = MOTOR_MODE;
 204:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 205:Core/Src/fsm.c **** 					break;
 206:Core/Src/fsm.c **** 				case ENCODER_CMD:
 207:Core/Src/fsm.c **** 					fsmstate->next_state = ENCODER_MODE;
 208:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 209:Core/Src/fsm.c **** 					break;
 210:Core/Src/fsm.c **** 				case SETUP_CMD:
 211:Core/Src/fsm.c **** 					fsmstate->next_state = SETUP_MODE;
 212:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 213:Core/Src/fsm.c **** 					break;
 214:Core/Src/fsm.c **** 				case TEST_CMD:
 215:Core/Src/fsm.c **** 					fsmstate->next_state = TEST_MODE;
 216:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 217:Core/Src/fsm.c **** 					break;
 218:Core/Src/fsm.c **** 				case ZERO_CMD:
 219:Core/Src/fsm.c **** 					
 220:Core/Src/fsm.c **** 					printf("\n\r  Saved new zero position: ");
 221:Core/Src/fsm.c **** 					break;
 222:Core/Src/fsm.c **** 				}
 223:Core/Src/fsm.c **** 			break;
 224:Core/Src/fsm.c **** 		case SETUP_MODE:
 225:Core/Src/fsm.c **** 			if(fsm_input == 10 || fsm_input == ' '){ 
 226:Core/Src/fsm.c ****         		break; // Bỏ qua ký tự Line Feed (\n) và phím Space để không bị nhiễu
 227:Core/Src/fsm.c ****     		}	
 228:Core/Src/fsm.c **** 			if(fsm_input == ENTER_CMD){
 229:Core/Src/fsm.c **** 				process_user_input(fsmstate);
 230:Core/Src/fsm.c **** 				break;
 231:Core/Src/fsm.c **** 			}
 232:Core/Src/fsm.c **** 			if(fsmstate->bytecount == 0){fsmstate->cmd_id = fsm_input;}
 233:Core/Src/fsm.c **** 			else{
 234:Core/Src/fsm.c **** 				fsmstate->cmd_buff[fsmstate->bytecount-1] = fsm_input;
 235:Core/Src/fsm.c **** 				//fsmstate->bytecount = fsmstate->bytecount%(sizeof(fsmstate->cmd_buff)/sizeof(fsmstate->cmd_bu
 236:Core/Src/fsm.c **** 			}
 237:Core/Src/fsm.c **** 			fsmstate->bytecount++;
 238:Core/Src/fsm.c **** 			/* If enter is typed, process user input */
 239:Core/Src/fsm.c **** 
 240:Core/Src/fsm.c **** 			break;
 241:Core/Src/fsm.c **** 		case TEST_MODE:
 242:Core/Src/fsm.c **** 			if(fsm_input == 10 || fsm_input == ' '){ 
ARM GAS  /tmp/ccMYDc3W.s 			page 11


 243:Core/Src/fsm.c ****         		break; // Bỏ qua ký tự Line Feed (\n) và phím Space để không bị nhiễu
 244:Core/Src/fsm.c ****     		}	
 245:Core/Src/fsm.c **** 			if(fsm_input == ENTER_CMD){
 246:Core/Src/fsm.c **** 				switch (fsmstate->cmd_id){
 247:Core/Src/fsm.c **** 					case 't': {
 248:Core/Src/fsm.c **** 						float mode_val = atof(fsmstate->cmd_buff);
 249:Core/Src/fsm.c **** 						hfoc.sPoint_Vel = mode_val;
 250:Core/Src/fsm.c **** 						printf("\n\r  Updated velocity Setpoint: %.3f\r\n", hfoc.sPoint_Vel);
 251:Core/Src/fsm.c **** 						break;
 252:Core/Src/fsm.c **** 					}
 253:Core/Src/fsm.c **** 				}
 254:Core/Src/fsm.c **** 				fsmstate->bytecount = 0;
 255:Core/Src/fsm.c **** 				fsmstate->cmd_id = 0;
 256:Core/Src/fsm.c **** 				memset(&fsmstate->cmd_buff, 0, sizeof(fsmstate->cmd_buff));
 257:Core/Src/fsm.c **** 				return;
 258:Core/Src/fsm.c **** 			}
 259:Core/Src/fsm.c **** 			if(fsmstate->bytecount == 0){fsmstate->cmd_id = fsm_input;}
 260:Core/Src/fsm.c **** 			else{
 261:Core/Src/fsm.c **** 				fsmstate->cmd_buff[fsmstate->bytecount-1] = fsm_input;
 262:Core/Src/fsm.c **** 				//fsmstate->bytecount = fsmstate->bytecount%(sizeof(fsmstate->cmd_buff)/sizeof(fsmstate->cmd_bu
 263:Core/Src/fsm.c **** 			}
 264:Core/Src/fsm.c **** 			fsmstate->bytecount++;
 265:Core/Src/fsm.c **** 			/* If enter is typed, process user input */
 266:Core/Src/fsm.c **** 
 267:Core/Src/fsm.c **** 			break;	
 268:Core/Src/fsm.c **** 
 269:Core/Src/fsm.c **** 		case ENCODER_MODE:
 270:Core/Src/fsm.c **** 			break;
 271:Core/Src/fsm.c **** 		case MOTOR_MODE:
 272:Core/Src/fsm.c **** 			break;
 273:Core/Src/fsm.c **** 	}
 274:Core/Src/fsm.c **** //printf("FSM State: %d  %d\r\n", fsmstate.state, fsmstate.state_change);
 275:Core/Src/fsm.c **** }
