 180:Core/Src/fsm.c **** 					break;
 181:Core/Src/fsm.c **** 				case ENCODER_CMD:
 182:Core/Src/fsm.c **** 					fsmstate->next_state = ENCODER_MODE;
 183:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 184:Core/Src/fsm.c **** 					break;
 185:Core/Src/fsm.c **** 				case SETUP_CMD:
