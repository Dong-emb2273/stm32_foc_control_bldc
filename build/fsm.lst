 202:Core/Src/fsm.c **** 
 203:Core/Src/fsm.c **** void update_fsm(FSMStruct * fsmstate, char fsm_input){
 204:Core/Src/fsm.c **** 	/*update_fsm is only run when new state-change information is received
 205:Core/Src/fsm.c **** 	* on serial terminal input or CAN input
 206:Core/Src/fsm.c **** 	*/
 207:Core/Src/fsm.c **** 	if(fsm_input == MENU_CMD){	// escape to exit to rest mode
 208:Core/Src/fsm.c **** 		fsmstate->next_state = MENU_MODE;
 209:Core/Src/fsm.c **** 		fsmstate->ready = 0;
 210:Core/Src/fsm.c **** 		return;
 211:Core/Src/fsm.c **** 	}
 212:Core/Src/fsm.c **** 	switch(fsmstate->state){
 213:Core/Src/fsm.c **** 		case MENU_MODE:
 214:Core/Src/fsm.c **** 			switch (fsm_input){
 215:Core/Src/fsm.c **** 				case CAL_CMD:
 216:Core/Src/fsm.c **** 					fsmstate->next_state = CALIBRATION_MODE;
 217:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 218:Core/Src/fsm.c **** 					break;
 219:Core/Src/fsm.c **** 				case MOTOR_CMD:
 220:Core/Src/fsm.c **** 					fsmstate->next_state = MOTOR_MODE;
 221:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 222:Core/Src/fsm.c **** 					break;
 223:Core/Src/fsm.c **** 				case ENCODER_CMD:
 224:Core/Src/fsm.c **** 					fsmstate->next_state = ENCODER_MODE;
ARM GAS  /tmp/ccvLV3P6.s 			page 9


 225:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 226:Core/Src/fsm.c **** 					break;
 227:Core/Src/fsm.c **** 				case SETUP_CMD:
 228:Core/Src/fsm.c **** 					fsmstate->next_state = SETUP_MODE;
 229:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 230:Core/Src/fsm.c **** 					break;
 231:Core/Src/fsm.c **** 				case ZERO_CMD:
 232:Core/Src/fsm.c **** 					
 233:Core/Src/fsm.c **** 					printf("\n\r  Saved new zero position: ");
 234:Core/Src/fsm.c **** 					break;
 235:Core/Src/fsm.c **** 				}
 236:Core/Src/fsm.c **** 			break;
 237:Core/Src/fsm.c **** 		case SETUP_MODE:
 238:Core/Src/fsm.c **** 			if(fsm_input == 10 || fsm_input == ' '){ 
 239:Core/Src/fsm.c ****         		break; // Bỏ qua ký tự Line Feed (\n) và phím Space để không bị nhiễu
 240:Core/Src/fsm.c ****     		}	
 241:Core/Src/fsm.c **** 			if(fsm_input == ENTER_CMD){
 242:Core/Src/fsm.c **** 				process_user_input(fsmstate);
 243:Core/Src/fsm.c **** 				break;
 244:Core/Src/fsm.c **** 			}
 245:Core/Src/fsm.c **** 			if(fsmstate->bytecount == 0){fsmstate->cmd_id = fsm_input;}
 246:Core/Src/fsm.c **** 			else{
 247:Core/Src/fsm.c **** 				fsmstate->cmd_buff[fsmstate->bytecount-1] = fsm_input;
 248:Core/Src/fsm.c **** 				//fsmstate->bytecount = fsmstate->bytecount%(sizeof(fsmstate->cmd_buff)/sizeof(fsmstate->cmd_bu
 249:Core/Src/fsm.c **** 			}
 250:Core/Src/fsm.c **** 			fsmstate->bytecount++;
 251:Core/Src/fsm.c **** 			/* If enter is typed, process user input */
 252:Core/Src/fsm.c **** 
 253:Core/Src/fsm.c **** 			break;
 254:Core/Src/fsm.c **** 
 255:Core/Src/fsm.c **** 		case ENCODER_MODE:
 256:Core/Src/fsm.c **** 			break;
 257:Core/Src/fsm.c **** 		case MOTOR_MODE:
 258:Core/Src/fsm.c **** 			break;
 259:Core/Src/fsm.c **** }
 260:Core/Src/fsm.c **** //printf("FSM State: %d  %d\r\n", fsmstate.state, fsmstate.state_change);
 261:Core/Src/fsm.c **** }
