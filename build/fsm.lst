  96:Core/Src/fsm.c **** void fsm_enter_state(FSMStruct * fsmstate){
  97:Core/Src/fsm.c **** 	/* Called when entering a new state
  98:Core/Src/fsm.c **** 	* Do necessary setup   */
  99:Core/Src/fsm.c **** 	STATE = fsmstate->state;
 100:Core/Src/fsm.c **** 	NEXT_STATE = fsmstate->next_state;
 101:Core/Src/fsm.c **** 	switch(fsmstate->state){
 102:Core/Src/fsm.c **** 			case MENU_MODE:
 103:Core/Src/fsm.c **** 			//printf("Entering Main Menu\r\n");
 104:Core/Src/fsm.c **** 			enter_menu_state();
 105:Core/Src/fsm.c **** 			break;
 106:Core/Src/fsm.c **** 		case SETUP_MODE:
 107:Core/Src/fsm.c **** 			printf("Entering Setup\r\n");
ARM GAS  /tmp/ccMYDc3W.s 			page 4


 108:Core/Src/fsm.c **** 			enter_setup_state();
 109:Core/Src/fsm.c **** 			break;
 110:Core/Src/fsm.c **** 		case TEST_MODE:
 111:Core/Src/fsm.c **** 			printf("Entering Test Mode\r\n");
 112:Core/Src/fsm.c **** 			// enter_test_state();
 113:Core/Src/fsm.c **** 			printf(" Type 't' + value to set Position Setpoint (e.g. t10.5)\r\n");
 114:Core/Src/fsm.c **** 			printf(" Press ESC to exit\r\n\r\n");
 115:Core/Src/fsm.c **** 			DRV8323RS_Enable;
 116:Core/Src/fsm.c **** 			break;
 117:Core/Src/fsm.c **** 		case ENCODER_MODE:
 118:Core/Src/fsm.c **** 			//printf("Entering Encoder Mode\r\n");
 119:Core/Src/fsm.c **** 			break;
 120:Core/Src/fsm.c **** 		case MOTOR_MODE:
 121:Core/Src/fsm.c **** 			printf("Entering Motor Mode\r\n");
 122:Core/Src/fsm.c **** 			DRV8323RS_Enable;
 123:Core/Src/fsm.c **** 			break;
 124:Core/Src/fsm.c **** 		case CALIBRATION_MODE:
 125:Core/Src/fsm.c **** 			printf("Starting Calibration Mode\r\n");
 126:Core/Src/fsm.c **** 			DRV8323RS_Enable;
 127:Core/Src/fsm.c ****             foc_start_calibration(&hfoc);  
 128:Core/Src/fsm.c **** 			break;
 129:Core/Src/fsm.c **** 
 130:Core/Src/fsm.c **** 	}
 131:Core/Src/fsm.c **** }
