 146:Core/Src/fsm.c **** void update_fsm(FSMStruct * fsmstate, char fsm_input){
 147:Core/Src/fsm.c **** 	/*update_fsm is only run when new state-change information is received
 148:Core/Src/fsm.c **** 	* on serial terminal input or CAN input
 149:Core/Src/fsm.c **** 	*/
 150:Core/Src/fsm.c **** 	if(fsm_input == MENU_CMD){	// escape to exit to rest mode
 151:Core/Src/fsm.c **** 		fsmstate->next_state = MENU_MODE;
 152:Core/Src/fsm.c **** 		fsmstate->ready = 0;
 153:Core/Src/fsm.c **** 		return;
 154:Core/Src/fsm.c **** 	}
 155:Core/Src/fsm.c **** 	switch(fsmstate->state){
 156:Core/Src/fsm.c **** 		case MENU_MODE:
 157:Core/Src/fsm.c **** 			switch (fsm_input){
 158:Core/Src/fsm.c **** 				case CAL_CMD:
 159:Core/Src/fsm.c **** 					fsmstate->next_state = CALIBRATION_MODE;
 160:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 161:Core/Src/fsm.c **** 					break;
 162:Core/Src/fsm.c **** 				case MOTOR_CMD:
 163:Core/Src/fsm.c **** 					fsmstate->next_state = MOTOR_MODE;
 164:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 165:Core/Src/fsm.c **** 					break;
 166:Core/Src/fsm.c **** 				case ENCODER_CMD:
ARM GAS  /tmp/ccqzlezO.s 			page 8


 167:Core/Src/fsm.c **** 					fsmstate->next_state = ENCODER_MODE;
 168:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 169:Core/Src/fsm.c **** 					break;
 170:Core/Src/fsm.c **** 				case SETUP_CMD:
 171:Core/Src/fsm.c **** 					fsmstate->next_state = SETUP_MODE;
 172:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 173:Core/Src/fsm.c **** 					break;
 174:Core/Src/fsm.c **** 				case TEST_CMD:
 175:Core/Src/fsm.c **** 					fsmstate->next_state = TEST_MODE;
 176:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 177:Core/Src/fsm.c **** 					break;
 178:Core/Src/fsm.c **** 				case ZERO_CMD:
 179:Core/Src/fsm.c **** 					M_ZERO = ENCODER_GetActualDegree(&encoder); 
