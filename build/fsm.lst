  76:Core/Src/fsm.c **** void fsm_enter_state(FSMStruct * fsmstate){
  77:Core/Src/fsm.c **** 	/* Called when entering a new state
  78:Core/Src/fsm.c **** 	* Do necessary setup   */
  79:Core/Src/fsm.c **** 	switch(fsmstate->state){
  80:Core/Src/fsm.c **** 			case MENU_MODE:
  81:Core/Src/fsm.c **** 			//printf("Entering Main Menu\r\n");
  82:Core/Src/fsm.c **** 			CF_RUNNING;
  83:Core/Src/fsm.c **** 			DRV8323RS_Disnable;
  84:Core/Src/fsm.c **** 			enter_menu_state();
  85:Core/Src/fsm.c **** 			break;
  86:Core/Src/fsm.c **** 		case SETUP_MODE:
  87:Core/Src/fsm.c **** 			printf("Entering Setup\r\n");
  88:Core/Src/fsm.c **** 			enter_setup_state();
  89:Core/Src/fsm.c **** 			break;
  90:Core/Src/fsm.c **** 		case TEST_MODE:
  91:Core/Src/fsm.c **** 			DRV8323RS_Disnable;
  92:Core/Src/fsm.c **** 			CF_RUNNING;
  93:Core/Src/fsm.c **** 			enter_test_state();
  94:Core/Src/fsm.c **** 			break;
  95:Core/Src/fsm.c **** 		case ENCODER_MODE:
  96:Core/Src/fsm.c **** 			//printf("Entering Encoder Mode\r\n");
  97:Core/Src/fsm.c **** 			break;
  98:Core/Src/fsm.c **** 		case MOTOR_MODE:
  99:Core/Src/fsm.c **** 			printf("Entering Motor Mode\r\n");
 100:Core/Src/fsm.c **** 			DRV8323RS_Enable;
 101:Core/Src/fsm.c **** 			SF_RUNNING;
 102:Core/Src/fsm.c **** 			break;
 103:Core/Src/fsm.c **** 		case CALIBRATION_MODE:
 104:Core/Src/fsm.c **** 			printf("Starting Calibration Mode\r\n");
 105:Core/Src/fsm.c **** 			DRV8323RS_Enable;
 106:Core/Src/fsm.c ****             foc_start_calibration(&hfoc);  
 107:Core/Src/fsm.c **** 			break;
 108:Core/Src/fsm.c **** 
 109:Core/Src/fsm.c **** 	}
 110:Core/Src/fsm.c **** }
