  34:Core/Src/fsm.c **** void run_fsm(FSMStruct * fsmstate){
  35:Core/Src/fsm.c **** 	/* run_fsm is run every commutation interrupt cycle */
  36:Core/Src/fsm.c **** 
  37:Core/Src/fsm.c **** 	/* state transition management */
  38:Core/Src/fsm.c **** 	if(fsmstate->next_state != fsmstate->state){
  39:Core/Src/fsm.c **** 		fsm_exit_state(fsmstate);		// safely exit the old state
  40:Core/Src/fsm.c **** 		if(fsmstate->ready){			// if the previous state is ready, enter the new state
  41:Core/Src/fsm.c **** 			fsmstate->state = fsmstate->next_state;
  42:Core/Src/fsm.c **** 			fsm_enter_state(fsmstate);
  43:Core/Src/fsm.c **** 		}
  44:Core/Src/fsm.c **** 	}
  45:Core/Src/fsm.c **** 
  46:Core/Src/fsm.c **** 	switch(fsmstate->state){
  47:Core/Src/fsm.c **** 		case MENU_MODE:
  48:Core/Src/fsm.c **** 			
  49:Core/Src/fsm.c **** 			break;
  50:Core/Src/fsm.c **** 
  51:Core/Src/fsm.c **** 		case CALIBRATION_MODE:
  52:Core/Src/fsm.c **** 			meas_inj_dq_process(&hfoc, FOC_TS);
  53:Core/Src/fsm.c **** 			break;
  54:Core/Src/fsm.c **** 
  55:Core/Src/fsm.c **** 		case MOTOR_MODE:
  56:Core/Src/fsm.c **** 			/* If CAN has timed out, reset all commands */
  57:Core/Src/fsm.c **** 			foc_control_loop(&hfoc);
  58:Core/Src/fsm.c **** 			break;
  59:Core/Src/fsm.c **** 
  60:Core/Src/fsm.c **** 		case TEST_MODE:
  61:Core/Src/fsm.c **** 			/* If CAN has timed out, reset all commands */
  62:Core/Src/fsm.c **** 			
  63:Core/Src/fsm.c **** 			foc_control_loop(&hfoc);
  64:Core/Src/fsm.c **** 			break;
ARM GAS  /tmp/ccV1yxOg.s 			page 3


  65:Core/Src/fsm.c **** 		case SETUP_MODE:
  66:Core/Src/fsm.c **** 			break;
  67:Core/Src/fsm.c **** 
  68:Core/Src/fsm.c **** 		case ENCODER_MODE:
  69:Core/Src/fsm.c **** 			
  70:Core/Src/fsm.c **** 			break;
  71:Core/Src/fsm.c **** 
  72:Core/Src/fsm.c **** 		case SET_PID_MODE:
  73:Core/Src/fsm.c **** 			break;
  74:Core/Src/fsm.c **** 	}
  75:Core/Src/fsm.c **** 
  76:Core/Src/fsm.c **** }
