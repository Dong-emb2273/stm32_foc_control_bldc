  31:Core/Src/fsm.c **** void run_fsm(FSMStruct * fsmstate){
  32:Core/Src/fsm.c **** 	/* run_fsm is run every commutation interrupt cycle */
  33:Core/Src/fsm.c **** 
  34:Core/Src/fsm.c **** 	/* state transition management */
  35:Core/Src/fsm.c **** 	if(fsmstate->next_state != fsmstate->state){
  36:Core/Src/fsm.c **** 		fsm_exit_state(fsmstate);		// safely exit the old state
  37:Core/Src/fsm.c **** 		if(fsmstate->ready){			// if the previous state is ready, enter the new state
  38:Core/Src/fsm.c **** 			fsmstate->state = fsmstate->next_state;
  39:Core/Src/fsm.c **** 			fsm_enter_state(fsmstate);
  40:Core/Src/fsm.c **** 		}
  41:Core/Src/fsm.c **** 	}
  42:Core/Src/fsm.c **** 
  43:Core/Src/fsm.c **** 	switch(fsmstate->state){
  44:Core/Src/fsm.c **** 		case MENU_MODE:
  45:Core/Src/fsm.c **** 			// motor_turn_off(&hfoc);
  46:Core/Src/fsm.c **** 			break;
  47:Core/Src/fsm.c **** 
  48:Core/Src/fsm.c **** 		case CALIBRATION_MODE:
  49:Core/Src/fsm.c **** 			meas_inj_dq_process(&hfoc, FOC_TS);
  50:Core/Src/fsm.c **** 			break;
  51:Core/Src/fsm.c **** 
  52:Core/Src/fsm.c **** 		case MOTOR_MODE:
  53:Core/Src/fsm.c **** 			/* If CAN has timed out, reset all commands */
  54:Core/Src/fsm.c **** 			foc_control_loop(&hfoc);
  55:Core/Src/fsm.c **** 			break;
  56:Core/Src/fsm.c **** 
  57:Core/Src/fsm.c **** 		case TEST_MODE:
  58:Core/Src/fsm.c **** 			/* If CAN has timed out, reset all commands */
  59:Core/Src/fsm.c **** 			
  60:Core/Src/fsm.c **** 				foc_control_loop(&hfoc);
  61:Core/Src/fsm.c **** 			
  62:Core/Src/fsm.c **** 			
  63:Core/Src/fsm.c **** 			break;
  64:Core/Src/fsm.c **** 		case SETUP_MODE:
ARM GAS  /tmp/ccsLTzd2.s 			page 3


  65:Core/Src/fsm.c **** 			break;
  66:Core/Src/fsm.c **** 
  67:Core/Src/fsm.c **** 		case ENCODER_MODE:
  68:Core/Src/fsm.c **** 			
  69:Core/Src/fsm.c **** 			break;
  70:Core/Src/fsm.c **** 
  71:Core/Src/fsm.c **** 		case SET_PID_MODE:
  72:Core/Src/fsm.c **** 			break;
  73:Core/Src/fsm.c **** 	}
  74:Core/Src/fsm.c **** 
  75:Core/Src/fsm.c **** }
