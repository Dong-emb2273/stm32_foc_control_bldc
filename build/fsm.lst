 207:Core/Src/fsm.c **** void update_fsm(FSMStruct * fsmstate, char fsm_input){
 208:Core/Src/fsm.c **** 	/*update_fsm is only run when new state-change information is received
 209:Core/Src/fsm.c **** 	* on serial terminal input or CAN input
 210:Core/Src/fsm.c **** 	*/
 211:Core/Src/fsm.c **** 	if(fsm_input == MENU_CMD){	// escape to exit to rest mode
 212:Core/Src/fsm.c **** 		fsmstate->next_state = MENU_MODE;
 213:Core/Src/fsm.c **** 		fsmstate->ready = 0;
 214:Core/Src/fsm.c **** 		return;
 215:Core/Src/fsm.c **** 	}
 216:Core/Src/fsm.c **** 	switch(fsmstate->state){
 217:Core/Src/fsm.c **** 		case MENU_MODE:
 218:Core/Src/fsm.c **** 			switch (fsm_input){
 219:Core/Src/fsm.c **** 				case CAL_CMD:
 220:Core/Src/fsm.c **** 					fsmstate->next_state = CALIBRATION_MODE;
 221:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 222:Core/Src/fsm.c **** 					break;
 223:Core/Src/fsm.c **** 				case MOTOR_CMD:
 224:Core/Src/fsm.c **** 					fsmstate->next_state = MOTOR_MODE;
 225:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 226:Core/Src/fsm.c **** 					break;
 227:Core/Src/fsm.c **** 				case ENCODER_CMD:
 228:Core/Src/fsm.c **** 					fsmstate->next_state = ENCODER_MODE;
 229:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 230:Core/Src/fsm.c **** 					break;
 231:Core/Src/fsm.c **** 				case SETUP_CMD:
 232:Core/Src/fsm.c **** 					fsmstate->next_state = SETUP_MODE;
 233:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 234:Core/Src/fsm.c **** 					break;
 235:Core/Src/fsm.c **** 				case ZERO_CMD:
 236:Core/Src/fsm.c **** 					
 237:Core/Src/fsm.c **** 					printf("\n\r  Saved new zero position: ");
 238:Core/Src/fsm.c **** 					break;
 239:Core/Src/fsm.c **** 				}
 240:Core/Src/fsm.c **** 			break;
 241:Core/Src/fsm.c **** 		case SETUP_MODE:
 242:Core/Src/fsm.c **** 			if(fsm_input == 10 || fsm_input == ' '){ 
 243:Core/Src/fsm.c ****         		break; // Bỏ qua ký tự Line Feed (\n) và phím Space để không bị nhiễu
 244:Core/Src/fsm.c ****     		}	
 245:Core/Src/fsm.c **** 			if(fsm_input == ENTER_CMD){
 246:Core/Src/fsm.c **** 				process_user_input(fsmstate);
 247:Core/Src/fsm.c **** 				break;
 248:Core/Src/fsm.c **** 			}
 249:Core/Src/fsm.c **** 			if(fsmstate->bytecount == 0){fsmstate->cmd_id = fsm_input;}
 250:Core/Src/fsm.c **** 			else{
