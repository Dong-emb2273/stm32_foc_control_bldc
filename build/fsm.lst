 220:Core/Src/fsm.c **** 			}
 221:Core/Src/fsm.c **** 			fsmstate->bytecount++;
 222:Core/Src/fsm.c **** 			/* If enter is typed, process user input */
 223:Core/Src/fsm.c **** 
 224:Core/Src/fsm.c **** 			break;
 225:Core/Src/fsm.c **** 		
 226:Core/Src/fsm.c **** 
