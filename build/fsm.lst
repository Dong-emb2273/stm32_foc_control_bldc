 158:Core/Src/fsm.c **** void update_fsm(FSMStruct * fsmstate, char fsm_input){
 159:Core/Src/fsm.c **** 	/*update_fsm is only run when new state-change information is received
 160:Core/Src/fsm.c **** 	* on serial terminal input or CAN input
 161:Core/Src/fsm.c **** 	*/
 162:Core/Src/fsm.c **** 	if(fsm_input == MENU_CMD){	// escape to exit to rest mode
 163:Core/Src/fsm.c **** 		fsmstate->next_state = MENU_MODE;
 164:Core/Src/fsm.c **** 		fsmstate->ready = 0;
 165:Core/Src/fsm.c **** 		return;
 166:Core/Src/fsm.c **** 	}
 167:Core/Src/fsm.c **** 	switch(fsmstate->state){
 168:Core/Src/fsm.c **** 		case MENU_MODE:
 169:Core/Src/fsm.c **** 			switch (fsm_input){
 170:Core/Src/fsm.c **** 				case CAL_CMD:
 171:Core/Src/fsm.c **** 					fsmstate->next_state = CALIBRATION_MODE;
 172:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 173:Core/Src/fsm.c **** 					break;
 174:Core/Src/fsm.c **** 				case MOTOR_CMD:
 175:Core/Src/fsm.c **** 					fsmstate->next_state = MOTOR_MODE;
 176:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 177:Core/Src/fsm.c **** 					break;
 178:Core/Src/fsm.c **** 				case ENCODER_CMD:
 179:Core/Src/fsm.c **** 					fsmstate->next_state = ENCODER_MODE;
 180:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 181:Core/Src/fsm.c **** 					break;
 182:Core/Src/fsm.c **** 				case SETUP_CMD:
 183:Core/Src/fsm.c **** 					fsmstate->next_state = SETUP_MODE;
 184:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 185:Core/Src/fsm.c **** 					break;
 186:Core/Src/fsm.c **** 				case ZERO_CMD:
 187:Core/Src/fsm.c **** 					
 188:Core/Src/fsm.c **** 					printf("\n\r  Saved new zero position: ");
 189:Core/Src/fsm.c **** 					break;
 190:Core/Src/fsm.c **** 				}
 191:Core/Src/fsm.c **** 			break;
 192:Core/Src/fsm.c **** 		case SETUP_MODE:
ARM GAS  /tmp/ccVvFV2v.s 			page 7


 193:Core/Src/fsm.c **** 			if(fsm_input == 10 || fsm_input == ' '){ 
 194:Core/Src/fsm.c ****         		break; // Bỏ qua ký tự Line Feed (\n) và phím Space để không bị nhiễu
 195:Core/Src/fsm.c ****     		}	
 196:Core/Src/fsm.c **** 			if(fsm_input == ENTER_CMD){
 197:Core/Src/fsm.c **** 				process_user_input(fsmstate);
 198:Core/Src/fsm.c **** 				break;
 199:Core/Src/fsm.c **** 			}
 200:Core/Src/fsm.c **** 			if(fsmstate->bytecount == 0){fsmstate->cmd_id = fsm_input;}
 201:Core/Src/fsm.c **** 			else{
 202:Core/Src/fsm.c **** 				fsmstate->cmd_buff[fsmstate->bytecount-1] = fsm_input;
 203:Core/Src/fsm.c **** 				//fsmstate->bytecount = fsmstate->bytecount%(sizeof(fsmstate->cmd_buff)/sizeof(fsmstate->cmd_bu
 204:Core/Src/fsm.c **** 			}
 205:Core/Src/fsm.c **** 			fsmstate->bytecount++;
 206:Core/Src/fsm.c **** 			/* If enter is typed, process user input */
 207:Core/Src/fsm.c **** 
 208:Core/Src/fsm.c **** 			break;
 209:Core/Src/fsm.c **** 
 210:Core/Src/fsm.c **** 		case ENCODER_MODE:
 211:Core/Src/fsm.c **** 			break;
 212:Core/Src/fsm.c **** 		case MOTOR_MODE:
 213:Core/Src/fsm.c **** 			break;
 214:Core/Src/fsm.c **** }
 215:Core/Src/fsm.c **** //printf("FSM State: %d  %d\r\n", fsmstate.state, fsmstate.state_change);
 216:Core/Src/fsm.c **** }
