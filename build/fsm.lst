 145:Core/Src/fsm.c **** void update_fsm(FSMStruct * fsmstate, char fsm_input){
 146:Core/Src/fsm.c **** 	/*update_fsm is only run when new state-change information is received
 147:Core/Src/fsm.c **** 	* on serial terminal input or CAN input
 148:Core/Src/fsm.c **** 	*/
 149:Core/Src/fsm.c **** 	if(fsm_input == MENU_CMD){	// escape to exit to rest mode
 150:Core/Src/fsm.c **** 		fsmstate->next_state = MENU_MODE;
 151:Core/Src/fsm.c **** 		fsmstate->ready = 0;
 152:Core/Src/fsm.c **** 		return;
 153:Core/Src/fsm.c **** 	}
 154:Core/Src/fsm.c **** 	switch(fsmstate->state){
 155:Core/Src/fsm.c **** 		case MENU_MODE:
 156:Core/Src/fsm.c **** 			switch (fsm_input){
 157:Core/Src/fsm.c **** 				case CAL_CMD:
 158:Core/Src/fsm.c **** 					fsmstate->next_state = CALIBRATION_MODE;
 159:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 160:Core/Src/fsm.c **** 					break;
 161:Core/Src/fsm.c **** 				case MOTOR_CMD:
 162:Core/Src/fsm.c **** 					fsmstate->next_state = MOTOR_MODE;
 163:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 164:Core/Src/fsm.c **** 					break;
 165:Core/Src/fsm.c **** 				case ENCODER_CMD:
 166:Core/Src/fsm.c **** 					fsmstate->next_state = ENCODER_MODE;
 167:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 168:Core/Src/fsm.c **** 					break;
 169:Core/Src/fsm.c **** 				case SETUP_CMD:
 170:Core/Src/fsm.c **** 					fsmstate->next_state = SETUP_MODE;
 171:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 172:Core/Src/fsm.c **** 					break;
 173:Core/Src/fsm.c **** 				case ZERO_CMD:
 174:Core/Src/fsm.c **** 					
 175:Core/Src/fsm.c **** 					printf("\n\r  Saved new zero position: ");
 176:Core/Src/fsm.c **** 					break;
 177:Core/Src/fsm.c **** 				}
 178:Core/Src/fsm.c **** 			break;
 179:Core/Src/fsm.c **** 		case SETUP_MODE:
 180:Core/Src/fsm.c **** 			if(fsm_input == 10 || fsm_input == ' '){ 
 181:Core/Src/fsm.c ****         		break; // Bỏ qua ký tự Line Feed (\n) và phím Space để không bị nhiễu
 182:Core/Src/fsm.c ****     		}	
 183:Core/Src/fsm.c **** 			if(fsm_input == ENTER_CMD){
 184:Core/Src/fsm.c **** 				process_user_input(fsmstate);
 185:Core/Src/fsm.c **** 				break;
 186:Core/Src/fsm.c **** 			}
 187:Core/Src/fsm.c **** 			if(fsmstate->bytecount == 0){fsmstate->cmd_id = fsm_input;}
 188:Core/Src/fsm.c **** 			else{
 189:Core/Src/fsm.c **** 				fsmstate->cmd_buff[fsmstate->bytecount-1] = fsm_input;
 190:Core/Src/fsm.c **** 				//fsmstate->bytecount = fsmstate->bytecount%(sizeof(fsmstate->cmd_buff)/sizeof(fsmstate->cmd_bu
 191:Core/Src/fsm.c **** 			}
 192:Core/Src/fsm.c **** 			fsmstate->bytecount++;
 193:Core/Src/fsm.c **** 			/* If enter is typed, process user input */
 194:Core/Src/fsm.c **** 
ARM GAS  /tmp/ccLPEaEQ.s 			page 7


 195:Core/Src/fsm.c **** 			break;
 196:Core/Src/fsm.c **** 
 197:Core/Src/fsm.c **** 		case ENCODER_MODE:
 198:Core/Src/fsm.c **** 			break;
 199:Core/Src/fsm.c **** 		case MOTOR_MODE:
 200:Core/Src/fsm.c **** 			break;
 201:Core/Src/fsm.c **** }
 202:Core/Src/fsm.c **** //printf("FSM State: %d  %d\r\n", fsmstate.state, fsmstate.state_change);
 203:Core/Src/fsm.c **** }
