 136:Core/Src/fsm.c **** void fsm_enter_state(FSMStruct * fsmstate){
 137:Core/Src/fsm.c **** 	/* Called when entering a new state
 138:Core/Src/fsm.c **** 	* Do necessary setup   */
 139:Core/Src/fsm.c **** 
 140:Core/Src/fsm.c **** 	switch(fsmstate->state){
 141:Core/Src/fsm.c **** 			case MENU_MODE:
 142:Core/Src/fsm.c **** 			//printf("Entering Main Menu\r\n");
 143:Core/Src/fsm.c **** 			enter_menu_state();
ARM GAS  /tmp/cc4l737S.s 			page 4


 144:Core/Src/fsm.c **** 			break;
 145:Core/Src/fsm.c **** 		case SETUP_MODE:
 146:Core/Src/fsm.c **** 			printf("Entering Setup\r\n");
 147:Core/Src/fsm.c **** 			enter_setup_state();
 148:Core/Src/fsm.c **** 			break;
 149:Core/Src/fsm.c **** 		case ENCODER_MODE:
 150:Core/Src/fsm.c **** 			//printf("Entering Encoder Mode\r\n");
 151:Core/Src/fsm.c **** 			break;
 152:Core/Src/fsm.c **** 		case MOTOR_MODE:
 153:Core/Src/fsm.c **** 
 154:Core/Src/fsm.c **** 			printf("Entering Motor Mode\r\n");
 155:Core/Src/fsm.c **** //				HAL_GPIO_WritePin(LED, GPIO_PIN_SET );
 156:Core/Src/fsm.c **** //				reset_foc(&controller);
 157:Core/Src/fsm.c **** //				drv_enable_gd(drv);
 158:Core/Src/fsm.c **** 			break;
 159:Core/Src/fsm.c **** 		case CALIBRATION_MODE:
 160:Core/Src/fsm.c **** 			printf("Entering Calibration Mode\r\n");
 161:Core/Src/fsm.c **** 			
 162:Core/Src/fsm.c ****             is_calibrating = 1;       // 1. Chặn các ngắt tính toán FOC
 163:Core/Src/fsm.c ****             foc_start_calibration();  // 2. Kích hoạt bộ đếm thời gian
 164:Core/Src/fsm.c ****             
 165:Core/Src/fsm.c **** 			break;
 166:Core/Src/fsm.c **** 
 167:Core/Src/fsm.c **** 	}
 168:Core/Src/fsm.c **** }
