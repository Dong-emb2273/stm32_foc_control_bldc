 160:Core/Src/fsm.c **** 
 161:Core/Src/fsm.c **** void update_fsm(FSMStruct * fsmstate, char fsm_input){
 162:Core/Src/fsm.c **** 	/*update_fsm is only run when new state-change information is received
 163:Core/Src/fsm.c **** 	* on serial terminal input or CAN input
 164:Core/Src/fsm.c **** 	*/
 165:Core/Src/fsm.c **** 	if(fsm_input == MENU_CMD){	// escape to exit to rest mode
 166:Core/Src/fsm.c **** 		fsmstate->next_state = MENU_MODE;
 167:Core/Src/fsm.c **** 		fsmstate->ready = 0;
 168:Core/Src/fsm.c **** 		return;
 169:Core/Src/fsm.c **** 	}
 170:Core/Src/fsm.c **** 	switch(fsmstate->state){
 171:Core/Src/fsm.c **** 		case MENU_MODE:
 172:Core/Src/fsm.c **** 			switch (fsm_input){
 173:Core/Src/fsm.c **** 				case CAL_CMD:
