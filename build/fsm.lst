  17:Core/Src/fsm.c ****  void run_fsm(FSMStruct * fsmstate){
  18:Core/Src/fsm.c **** 	 /* run_fsm is run every commutation interrupt cycle */
  19:Core/Src/fsm.c **** 
  20:Core/Src/fsm.c **** 	 /* state transition management */
  21:Core/Src/fsm.c **** 	 if(fsmstate->next_state != fsmstate->state){
  22:Core/Src/fsm.c **** 		 fsm_exit_state(fsmstate);		// safely exit the old state
  23:Core/Src/fsm.c **** 		 if(fsmstate->ready){			// if the previous state is ready, enter the new state
  24:Core/Src/fsm.c **** 			 fsmstate->state = fsmstate->next_state;
  25:Core/Src/fsm.c **** 			 fsm_enter_state(fsmstate);
  26:Core/Src/fsm.c **** 		 }
  27:Core/Src/fsm.c **** 	 }
