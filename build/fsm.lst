  87:Core/Src/fsm.c **** void fsm_enter_state(FSMStruct * fsmstate){
  88:Core/Src/fsm.c **** 	/* Called when entering a new state
  89:Core/Src/fsm.c **** 	* Do necessary setup   */
  90:Core/Src/fsm.c **** 
  91:Core/Src/fsm.c **** 	switch(fsmstate->state){
  92:Core/Src/fsm.c **** 			case MENU_MODE:
  93:Core/Src/fsm.c **** 			//printf("Entering Main Menu\r\n");
  94:Core/Src/fsm.c **** 			enter_menu_state();
  95:Core/Src/fsm.c **** 			break;
  96:Core/Src/fsm.c **** 		case SETUP_MODE:
  97:Core/Src/fsm.c **** 			printf("Entering Setup\r\n");
  98:Core/Src/fsm.c **** 			enter_setup_state();
  99:Core/Src/fsm.c **** 			break;
 100:Core/Src/fsm.c **** 		case ENCODER_MODE:
 101:Core/Src/fsm.c **** 			//printf("Entering Encoder Mode\r\n");
 102:Core/Src/fsm.c **** 			break;
 103:Core/Src/fsm.c **** 		case MOTOR_MODE:
 104:Core/Src/fsm.c **** 
 105:Core/Src/fsm.c **** 			//printf("Entering Motor Mode\r\n");
 106:Core/Src/fsm.c **** //				HAL_GPIO_WritePin(LED, GPIO_PIN_SET );
 107:Core/Src/fsm.c **** //				reset_foc(&controller);
 108:Core/Src/fsm.c **** //				drv_enable_gd(drv);
 109:Core/Src/fsm.c **** 			break;
 110:Core/Src/fsm.c **** 		case CALIBRATION_MODE:
 111:Core/Src/fsm.c **** 			printf("Entering Calibration Mode\r\n");
 112:Core/Src/fsm.c **** 			
 113:Core/Src/fsm.c ****             is_calibrating = 1;       // 1. Chặn các ngắt tính toán FOC
 114:Core/Src/fsm.c ****             foc_start_calibration();  // 2. Kích hoạt bộ đếm thời gian
 115:Core/Src/fsm.c ****             
 116:Core/Src/fsm.c **** 			break;
 117:Core/Src/fsm.c **** 
 118:Core/Src/fsm.c **** 	}
 119:Core/Src/fsm.c **** }
