  73:Core/Src/fsm.c **** 			break;
  74:Core/Src/fsm.c **** 
  75:Core/Src/fsm.c **** 		case MOTOR_MODE:
  76:Core/Src/fsm.c **** 			/* If CAN has timed out, reset all commands */
  77:Core/Src/fsm.c **** 		
