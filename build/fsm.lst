 201:Core/Src/fsm.c **** 			break;
 202:Core/Src/fsm.c **** 		case SETUP_MODE:
 203:Core/Src/fsm.c **** 			if(fsm_input == 10 || fsm_input == ' '){ 
 204:Core/Src/fsm.c ****         		break; 
 205:Core/Src/fsm.c ****     		}	
 206:Core/Src/fsm.c **** 			if(fsm_input == ENTER_CMD){
 207:Core/Src/fsm.c **** 				process_user_input(fsmstate);
 208:Core/Src/fsm.c **** 				break;
 209:Core/Src/fsm.c **** 			}
 210:Core/Src/fsm.c **** 			if(fsmstate->bytecount == 0){fsmstate->cmd_id = fsm_input;}
 211:Core/Src/fsm.c **** 			else{
 212:Core/Src/fsm.c **** 				fsmstate->cmd_buff[fsmstate->bytecount-1] = fsm_input;
 213:Core/Src/fsm.c **** 				fsmstate->bytecount = fsmstate->bytecount%(sizeof(fsmstate->cmd_buff)/sizeof(fsmstate->cmd_buff
 214:Core/Src/fsm.c **** 			}
 215:Core/Src/fsm.c **** 			HAL_UART_Transmit(&huart, (uint8_t *)&fsm_input, 1, 2);
 216:Core/Src/fsm.c **** 			fsmstate->bytecount++;
 217:Core/Src/fsm.c **** 			/* If enter is typed, process user input */
 218:Core/Src/fsm.c **** 
 219:Core/Src/fsm.c **** 			break;
 220:Core/Src/fsm.c **** 		case TEST_MODE:
 221:Core/Src/fsm.c **** 			if(fsm_input == 10 || fsm_input == ' '){ 
 222:Core/Src/fsm.c ****         		break; 
 223:Core/Src/fsm.c ****     		}	
 224:Core/Src/fsm.c **** 			if(fsm_input == ENTER_CMD){
 225:Core/Src/fsm.c **** 				set_pid_mode(fsmstate);
 226:Core/Src/fsm.c **** 				break;
 227:Core/Src/fsm.c **** 			}
 228:Core/Src/fsm.c **** 			if(fsmstate->bytecount == 0){fsmstate->cmd_id = fsm_input;}
 229:Core/Src/fsm.c **** 			else{
 230:Core/Src/fsm.c **** 				fsmstate->cmd_buff[fsmstate->bytecount-1] = fsm_input;
 231:Core/Src/fsm.c **** 				fsmstate->bytecount = fsmstate->bytecount%(sizeof(fsmstate->cmd_buff)/sizeof(fsmstate->cmd_buff
 232:Core/Src/fsm.c **** 			}
 233:Core/Src/fsm.c **** 			HAL_UART_Transmit(&huart, (uint8_t *)&fsm_input, 1, 2);
 234:Core/Src/fsm.c **** 			fsmstate->bytecount++;
 235:Core/Src/fsm.c **** 			/* If enter is typed, process user input */
 236:Core/Src/fsm.c **** 
 237:Core/Src/fsm.c **** 			break;
 238:Core/Src/fsm.c **** 		
 239:Core/Src/fsm.c **** 
 240:Core/Src/fsm.c **** 		case ENCODER_MODE:
 241:Core/Src/fsm.c **** 			break;
 242:Core/Src/fsm.c **** 		case MOTOR_MODE:
 243:Core/Src/fsm.c **** 			switch (fsm_input){
 244:Core/Src/fsm.c **** 				case ZERO_CMD:
 245:Core/Src/fsm.c **** 					M_ZERO = ENCODER_GetActualDegree(&encoder); 
 246:Core/Src/fsm.c **** 					
 247:Core/Src/fsm.c **** 					SPOINT_POS = 0.0f;
