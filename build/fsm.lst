  20:Core/Src/fsm.c **** void run_fsm(FSMStruct * fsmstate){
  21:Core/Src/fsm.c **** 	/* run_fsm is run every commutation interrupt cycle */
  22:Core/Src/fsm.c **** 
  23:Core/Src/fsm.c **** 	/* state transition management */
  24:Core/Src/fsm.c **** 	if(fsmstate->next_state != fsmstate->state){
  25:Core/Src/fsm.c **** 		fsm_exit_state(fsmstate);		// safely exit the old state
  26:Core/Src/fsm.c **** 		if(fsmstate->ready){			// if the previous state is ready, enter the new state
  27:Core/Src/fsm.c **** 			fsmstate->state = fsmstate->next_state;
  28:Core/Src/fsm.c **** 			fsm_enter_state(fsmstate);
  29:Core/Src/fsm.c **** 		}
  30:Core/Src/fsm.c **** 	}
  31:Core/Src/fsm.c **** 
  32:Core/Src/fsm.c **** 	switch(fsmstate->state){
  33:Core/Src/fsm.c **** 		case MENU_MODE:
  34:Core/Src/fsm.c **** 			
  35:Core/Src/fsm.c **** 			break;
  36:Core/Src/fsm.c **** 
  37:Core/Src/fsm.c **** 		case CALIBRATION_MODE:
  38:Core/Src/fsm.c **** 			meas_inj_dq_process(&hfoc, FOC_TS);
  39:Core/Src/fsm.c **** 			break;
  40:Core/Src/fsm.c **** 
  41:Core/Src/fsm.c **** 		case MOTOR_MODE:
  42:Core/Src/fsm.c **** 			/* If CAN has timed out, reset all commands */
  43:Core/Src/fsm.c **** 			foc_control_loop(&hfoc);
  44:Core/Src/fsm.c **** 			break;
  45:Core/Src/fsm.c **** 
  46:Core/Src/fsm.c **** 		case TEST_MODE:
  47:Core/Src/fsm.c **** 			/* If CAN has timed out, reset all commands */
  48:Core/Src/fsm.c **** 			
  49:Core/Src/fsm.c **** 			foc_control_loop(&hfoc);
  50:Core/Src/fsm.c **** 			break;
  51:Core/Src/fsm.c **** 		case SETUP_MODE:
  52:Core/Src/fsm.c **** 			break;
  53:Core/Src/fsm.c **** 
  54:Core/Src/fsm.c **** 		case ENCODER_MODE:
  55:Core/Src/fsm.c **** 			
  56:Core/Src/fsm.c **** 			break;
  57:Core/Src/fsm.c **** 
  58:Core/Src/fsm.c **** 		case SET_PID_MODE:
  59:Core/Src/fsm.c **** 			break;
  60:Core/Src/fsm.c **** 	}
  61:Core/Src/fsm.c **** 
  62:Core/Src/fsm.c **** }
