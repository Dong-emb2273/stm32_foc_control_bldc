 205:Core/Src/fsm.c **** 
 206:Core/Src/fsm.c **** void update_fsm(FSMStruct * fsmstate, char fsm_input){
 207:Core/Src/fsm.c **** 	/*update_fsm is only run when new state-change information is received
 208:Core/Src/fsm.c **** 	* on serial terminal input or CAN input
 209:Core/Src/fsm.c **** 	*/
 210:Core/Src/fsm.c **** 	if(fsm_input == MENU_CMD){	// escape to exit to rest mode
 211:Core/Src/fsm.c **** 		fsmstate->next_state = MENU_MODE;
 212:Core/Src/fsm.c **** 		fsmstate->ready = 0;
 213:Core/Src/fsm.c **** 		return;
 214:Core/Src/fsm.c **** 	}
 215:Core/Src/fsm.c **** 	switch(fsmstate->state){
 216:Core/Src/fsm.c **** 		case MENU_MODE:
 217:Core/Src/fsm.c **** 			switch (fsm_input){
 218:Core/Src/fsm.c **** 				case CAL_CMD:
 219:Core/Src/fsm.c **** 					fsmstate->next_state = CALIBRATION_MODE;
 220:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 221:Core/Src/fsm.c **** 					break;
 222:Core/Src/fsm.c **** 				case MOTOR_CMD:
 223:Core/Src/fsm.c **** 					fsmstate->next_state = MOTOR_MODE;
 224:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 225:Core/Src/fsm.c **** 					break;
 226:Core/Src/fsm.c **** 				case ENCODER_CMD:
 227:Core/Src/fsm.c **** 					fsmstate->next_state = ENCODER_MODE;
 228:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 229:Core/Src/fsm.c **** 					break;
 230:Core/Src/fsm.c **** 				case SETUP_CMD:
 231:Core/Src/fsm.c **** 					fsmstate->next_state = SETUP_MODE;
 232:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 233:Core/Src/fsm.c **** 					break;
 234:Core/Src/fsm.c **** 				case ZERO_CMD:
 235:Core/Src/fsm.c **** 					
 236:Core/Src/fsm.c **** 					printf("\n\r  Saved new zero position: ");
 237:Core/Src/fsm.c **** 					break;
 238:Core/Src/fsm.c **** 				}
 239:Core/Src/fsm.c **** 			break;
 240:Core/Src/fsm.c **** 		case SETUP_MODE:
 241:Core/Src/fsm.c **** 			if(fsm_input == 10 || fsm_input == ' '){ 
 242:Core/Src/fsm.c ****         		break; // Bỏ qua ký tự Line Feed (\n) và phím Space để không bị nhiễu
 243:Core/Src/fsm.c ****     		}	
 244:Core/Src/fsm.c **** 			if(fsm_input == ENTER_CMD){
 245:Core/Src/fsm.c **** 				process_user_input(fsmstate);
 246:Core/Src/fsm.c **** 				break;
 247:Core/Src/fsm.c **** 			}
 248:Core/Src/fsm.c **** 			if(fsmstate->bytecount == 0){fsmstate->cmd_id = fsm_input;}
 249:Core/Src/fsm.c **** 			else{
ARM GAS  /tmp/ccnARHof.s 			page 10


 250:Core/Src/fsm.c **** 				fsmstate->cmd_buff[fsmstate->bytecount-1] = fsm_input;
 251:Core/Src/fsm.c **** 				//fsmstate->bytecount = fsmstate->bytecount%(sizeof(fsmstate->cmd_buff)/sizeof(fsmstate->cmd_bu
 252:Core/Src/fsm.c **** 			}
 253:Core/Src/fsm.c **** 			fsmstate->bytecount++;
 254:Core/Src/fsm.c **** 			/* If enter is typed, process user input */
 255:Core/Src/fsm.c **** 
 256:Core/Src/fsm.c **** 			break;
 257:Core/Src/fsm.c **** 
 258:Core/Src/fsm.c **** 		case ENCODER_MODE:
 259:Core/Src/fsm.c **** 			break;
 260:Core/Src/fsm.c **** 		case MOTOR_MODE:
 261:Core/Src/fsm.c **** 			break;
 262:Core/Src/fsm.c **** }
 263:Core/Src/fsm.c **** //printf("FSM State: %d  %d\r\n", fsmstate.state, fsmstate.state_change);
 264:Core/Src/fsm.c **** }
