 160:Core/Src/fsm.c **** void update_fsm(FSMStruct * fsmstate, char fsm_input){
 161:Core/Src/fsm.c **** 	/*update_fsm is only run when new state-change information is received
 162:Core/Src/fsm.c **** 	* on serial terminal input or CAN input
 163:Core/Src/fsm.c **** 	*/
 164:Core/Src/fsm.c **** 	if(fsm_input == MENU_CMD){	// escape to exit to rest mode
 165:Core/Src/fsm.c **** 		fsmstate->next_state = MENU_MODE;
 166:Core/Src/fsm.c **** 		fsmstate->ready = 0;
ARM GAS  /tmp/cccutdE1.s 			page 8


 167:Core/Src/fsm.c **** 		return;
 168:Core/Src/fsm.c **** 	}
 169:Core/Src/fsm.c **** 	switch(fsmstate->state){
 170:Core/Src/fsm.c **** 		case MENU_MODE:
 171:Core/Src/fsm.c **** 			switch (fsm_input){
 172:Core/Src/fsm.c **** 				case CAL_CMD:
 173:Core/Src/fsm.c **** 					fsmstate->next_state = CALIBRATION_MODE;
 174:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 175:Core/Src/fsm.c **** 					break;
 176:Core/Src/fsm.c **** 				case MOTOR_CMD:
 177:Core/Src/fsm.c **** 					fsmstate->next_state = MOTOR_MODE;
 178:Core/Src/fsm.c **** 					fsmstate->ready = 0;
 179:Core/Src/fsm.c **** 					break;
