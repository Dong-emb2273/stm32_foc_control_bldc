 135:Core/Src/fsm.c **** void fsm_enter_state(FSMStruct * fsmstate){
 136:Core/Src/fsm.c **** 	/* Called when entering a new state
 137:Core/Src/fsm.c **** 	* Do necessary setup   */
 138:Core/Src/fsm.c **** 
 139:Core/Src/fsm.c **** 	switch(fsmstate->state){
 140:Core/Src/fsm.c **** 			case MENU_MODE:
 141:Core/Src/fsm.c **** 			//printf("Entering Main Menu\r\n");
 142:Core/Src/fsm.c **** 			enter_menu_state();
 143:Core/Src/fsm.c **** 			break;
 144:Core/Src/fsm.c **** 		case SETUP_MODE:
 145:Core/Src/fsm.c **** 			printf("Entering Setup\r\n");
 146:Core/Src/fsm.c **** 			enter_setup_state();
 147:Core/Src/fsm.c **** 			break;
 148:Core/Src/fsm.c **** 		case ENCODER_MODE:
 149:Core/Src/fsm.c **** 			//printf("Entering Encoder Mode\r\n");
 150:Core/Src/fsm.c **** 			break;
 151:Core/Src/fsm.c **** 		case MOTOR_MODE:
 152:Core/Src/fsm.c **** 			printf("Entering Motor Mode\r\n");
 153:Core/Src/fsm.c **** 	
 154:Core/Src/fsm.c **** 			break;
 155:Core/Src/fsm.c **** 		case CALIBRATION_MODE:
 156:Core/Src/fsm.c **** 			printf("Entering Calibration Mode\r\n");
 157:Core/Src/fsm.c ****             foc_start_calibration(&hfoc);  
 158:Core/Src/fsm.c **** 			break;
 159:Core/Src/fsm.c **** 
 160:Core/Src/fsm.c **** 	}
 161:Core/Src/fsm.c **** }
