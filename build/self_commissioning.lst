 242:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->i_buffer[idx - 1] = iq;
 243:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->Lq = sc_estimate_inductance(sc, Ts);
 244:Lib/SELF_COMMISSIONING/self_commissioning.c ****         foc_set_open_loop_voltage(sc->p_foc, 0, 0, 0);
 245:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->signal_flag = 0;
 246:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->measure_done_flag = 1;
