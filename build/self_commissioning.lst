 251:Lib/SELF_COMMISSIONING/self_commissioning.c ****     vq = sc->signal_amplitude * fast_sin(rad);
 252:Lib/SELF_COMMISSIONING/self_commissioning.c ****     vd = 1.0f;
 253:Lib/SELF_COMMISSIONING/self_commissioning.c ****     sc->v_buffer[idx] = vq;
 254:Lib/SELF_COMMISSIONING/self_commissioning.c ****     if (idx > 0) {
 255:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->i_buffer[idx - 1] = iq;
 256:Lib/SELF_COMMISSIONING/self_commissioning.c ****     }
 257:Lib/SELF_COMMISSIONING/self_commissioning.c ****     foc_set_open_loop_voltage(sc->p_foc, vd, vq, 0);
