 105:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 106:Lib/SELF_COMMISSIONING/self_commissioning.c **** float sc_estimate_resistance(self_commissioning_t *sc) {
 107:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float mean_vd = 0, mean_id = 0;
 108:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 109:Lib/SELF_COMMISSIONING/self_commissioning.c ****     for (int i = 0; i < MAX_DATA_ACQ_BUFFER; i++) {
 110:Lib/SELF_COMMISSIONING/self_commissioning.c ****         mean_vd += sc->v_buffer[i];
 111:Lib/SELF_COMMISSIONING/self_commissioning.c ****         mean_id += sc->i_buffer[i];
 112:Lib/SELF_COMMISSIONING/self_commissioning.c ****     }
 113:Lib/SELF_COMMISSIONING/self_commissioning.c ****     mean_vd /= MAX_DATA_ACQ_BUFFER;
 114:Lib/SELF_COMMISSIONING/self_commissioning.c ****     mean_id /= MAX_DATA_ACQ_BUFFER;
 115:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 116:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float Rs = mean_vd / mean_id;
 117:Lib/SELF_COMMISSIONING/self_commissioning.c ****     return fabsf(Rs);
 118:Lib/SELF_COMMISSIONING/self_commissioning.c **** }
 119:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 120:Lib/SELF_COMMISSIONING/self_commissioning.c **** float sc_estimate_inductance(self_commissioning_t *sc, float Ts) {
 121:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float Vc = 0, Vs = 0, Ic = 0, Is = 0;
 122:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float mean_v = 0, mean_i = 0;
 123:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 124:Lib/SELF_COMMISSIONING/self_commissioning.c ****     // Remove DC offset
 125:Lib/SELF_COMMISSIONING/self_commissioning.c ****     for (int i = 0; i < MAX_DATA_ACQ_BUFFER; i++) {
 126:Lib/SELF_COMMISSIONING/self_commissioning.c ****         mean_v += sc->v_buffer[i];
 127:Lib/SELF_COMMISSIONING/self_commissioning.c ****         mean_i += sc->i_buffer[i];
 128:Lib/SELF_COMMISSIONING/self_commissioning.c ****     }
 129:Lib/SELF_COMMISSIONING/self_commissioning.c ****     mean_v /= MAX_DATA_ACQ_BUFFER;
 130:Lib/SELF_COMMISSIONING/self_commissioning.c ****     mean_i /= MAX_DATA_ACQ_BUFFER;
 131:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 132:Lib/SELF_COMMISSIONING/self_commissioning.c ****     // Single-frequency DFT
 133:Lib/SELF_COMMISSIONING/self_commissioning.c ****     for (int i = 0; i < MAX_DATA_ACQ_BUFFER; i++) {
 134:Lib/SELF_COMMISSIONING/self_commissioning.c ****         float angle = sc->signal_omega * i * Ts;
 135:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 136:Lib/SELF_COMMISSIONING/self_commissioning.c ****         float voltage = sc->v_buffer[i] - mean_v;
 137:Lib/SELF_COMMISSIONING/self_commissioning.c ****         float current = sc->i_buffer[i] - mean_i;
 138:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 139:Lib/SELF_COMMISSIONING/self_commissioning.c ****         Vc += voltage * fast_cos(angle);
 140:Lib/SELF_COMMISSIONING/self_commissioning.c ****         Vs += voltage * fast_sin(angle);
 141:Lib/SELF_COMMISSIONING/self_commissioning.c ****         Ic += current * fast_cos(angle);
 142:Lib/SELF_COMMISSIONING/self_commissioning.c ****         Is += current * fast_sin(angle);
 143:Lib/SELF_COMMISSIONING/self_commissioning.c ****     }
 144:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
ARM GAS  /tmp/ccBpYxlV.s 			page 4


 145:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float norm = 2.0f / MAX_DATA_ACQ_BUFFER;
 146:Lib/SELF_COMMISSIONING/self_commissioning.c ****     Vc *= norm; 
 147:Lib/SELF_COMMISSIONING/self_commissioning.c ****     Vs *= norm;
 148:Lib/SELF_COMMISSIONING/self_commissioning.c ****     Ic *= norm; 
 149:Lib/SELF_COMMISSIONING/self_commissioning.c ****     Is *= norm;
 150:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 151:Lib/SELF_COMMISSIONING/self_commissioning.c ****     // V & I amplitude
 152:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float V_mag = sqrtf(Vc * Vc + Vs * Vs);
 153:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float I_mag = sqrtf(Ic * Ic + Is * Is);
 154:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 155:Lib/SELF_COMMISSIONING/self_commissioning.c ****     // (phi = arctan(Vs/Vc) - arctan(Is/Ic))
 156:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float phi = atan2f(Vs, Vc) - atan2f(Is, Ic);
 157:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 158:Lib/SELF_COMMISSIONING/self_commissioning.c ****     // Impedansi & parameters
 159:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float Z_mag = V_mag / I_mag;
 160:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 161:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float L_est = (Z_mag * fast_sin(phi)) / sc->signal_omega;
 162:Lib/SELF_COMMISSIONING/self_commissioning.c ****     return fabsf(L_est);
 163:Lib/SELF_COMMISSIONING/self_commissioning.c **** }
 164:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 165:Lib/SELF_COMMISSIONING/self_commissioning.c **** void sc_measure_Rs_update(self_commissioning_t *sc) {
 166:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float vd = 0, vq = 0;
 167:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float id = 0, iq = 0;
 168:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 169:Lib/SELF_COMMISSIONING/self_commissioning.c ****     uint32_t idx = 0;
 170:Lib/SELF_COMMISSIONING/self_commissioning.c ****     if (sc->signal_t < sc->signal_delay_t) {
 171:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->signal_start_t = sc->signal_t;
 172:Lib/SELF_COMMISSIONING/self_commissioning.c ****     }
 173:Lib/SELF_COMMISSIONING/self_commissioning.c ****     else {
 174:Lib/SELF_COMMISSIONING/self_commissioning.c ****         idx = sc->signal_t - sc->signal_start_t;
 175:Lib/SELF_COMMISSIONING/self_commissioning.c ****     }
 176:Lib/SELF_COMMISSIONING/self_commissioning.c ****     foc_get_idiq(sc->p_foc, &id, &iq);
 177:Lib/SELF_COMMISSIONING/self_commissioning.c ****     
 178:Lib/SELF_COMMISSIONING/self_commissioning.c ****     if (idx >= MAX_DATA_ACQ_BUFFER) {
 179:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->i_buffer[idx - 1] = id;
 180:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->Rs = sc_estimate_resistance(sc);
 181:Lib/SELF_COMMISSIONING/self_commissioning.c ****         foc_set_open_loop_voltage(sc->p_foc, 0, 0, 0);
 182:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->signal_flag = 0;
 183:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->measure_done_flag = 1;
 184:Lib/SELF_COMMISSIONING/self_commissioning.c ****         return;
 185:Lib/SELF_COMMISSIONING/self_commissioning.c ****     }
 186:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 187:Lib/SELF_COMMISSIONING/self_commissioning.c ****     vd = sc->signal_offset;
 188:Lib/SELF_COMMISSIONING/self_commissioning.c ****     sc->v_buffer[idx] = vd;
 189:Lib/SELF_COMMISSIONING/self_commissioning.c ****     if (idx > 0) {
 190:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->i_buffer[idx - 1] = id;
 191:Lib/SELF_COMMISSIONING/self_commissioning.c ****     }
 192:Lib/SELF_COMMISSIONING/self_commissioning.c ****     foc_set_open_loop_voltage(sc->p_foc, vd, vq, 0);
 193:Lib/SELF_COMMISSIONING/self_commissioning.c ****     sc->signal_t++;
 194:Lib/SELF_COMMISSIONING/self_commissioning.c **** }
 195:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 196:Lib/SELF_COMMISSIONING/self_commissioning.c **** void sc_measure_Ld_update(self_commissioning_t *sc, float Ts) {
 197:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float vd = 0, vq = 0;
 198:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float id = 0, iq = 0;
 199:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 200:Lib/SELF_COMMISSIONING/self_commissioning.c ****     uint32_t idx = 0;
 201:Lib/SELF_COMMISSIONING/self_commissioning.c ****     if (sc->signal_t < sc->signal_delay_t) {
ARM GAS  /tmp/ccBpYxlV.s 			page 5


 202:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->signal_start_t = sc->signal_t;
 203:Lib/SELF_COMMISSIONING/self_commissioning.c ****     }
 204:Lib/SELF_COMMISSIONING/self_commissioning.c ****     else {
 205:Lib/SELF_COMMISSIONING/self_commissioning.c ****         idx = sc->signal_t - sc->signal_start_t;
 206:Lib/SELF_COMMISSIONING/self_commissioning.c ****     }
 207:Lib/SELF_COMMISSIONING/self_commissioning.c ****     foc_get_idiq(sc->p_foc, &id, &iq);
 208:Lib/SELF_COMMISSIONING/self_commissioning.c ****     
 209:Lib/SELF_COMMISSIONING/self_commissioning.c ****     if (idx >= MAX_DATA_ACQ_BUFFER) {
 210:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->i_buffer[idx - 1] = id;
 211:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->Ld = sc_estimate_inductance(sc, Ts);
 212:Lib/SELF_COMMISSIONING/self_commissioning.c ****         foc_set_open_loop_voltage(sc->p_foc, 0, 0, 0);
 213:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->signal_flag = 0;
 214:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->measure_done_flag = 1;
 215:Lib/SELF_COMMISSIONING/self_commissioning.c ****         return;
 216:Lib/SELF_COMMISSIONING/self_commissioning.c ****     }
 217:Lib/SELF_COMMISSIONING/self_commissioning.c **** 
 218:Lib/SELF_COMMISSIONING/self_commissioning.c ****     float rad = sc->signal_omega * (float)sc->signal_t * Ts;
 219:Lib/SELF_COMMISSIONING/self_commissioning.c ****     vd = sc->signal_amplitude * fast_sin(rad);
 220:Lib/SELF_COMMISSIONING/self_commissioning.c ****     sc->v_buffer[idx] = vd;
 221:Lib/SELF_COMMISSIONING/self_commissioning.c ****     if (idx > 0) {
 222:Lib/SELF_COMMISSIONING/self_commissioning.c ****         sc->i_buffer[idx - 1] = id;
 223:Lib/SELF_COMMISSIONING/self_commissioning.c ****     }
 224:Lib/SELF_COMMISSIONING/self_commissioning.c ****     foc_set_open_loop_voltage(sc->p_foc, vd, vq, 0);
