   3:Lib/FOC/i2t.c **** int i2t_init(i2t_t *hi2t, float dt) {
   4:Lib/FOC/i2t.c ****   if (hi2t == 0 || dt <= 0.0f) {
   5:Lib/FOC/i2t.c ****     return -1;
   6:Lib/FOC/i2t.c ****   }
   7:Lib/FOC/i2t.c **** 
   8:Lib/FOC/i2t.c ****   hi2t->dt = dt;
   9:Lib/FOC/i2t.c ****   hi2t->cool_gain = 1.0f;
  10:Lib/FOC/i2t.c ****   hi2t->warn_ratio = 0.8f;
  11:Lib/FOC/i2t.c ****   hi2t->reset_ratio = 0.5f;
  12:Lib/FOC/i2t.c **** 
  13:Lib/FOC/i2t.c ****   i2t_reset(hi2t);
  14:Lib/FOC/i2t.c ****   return 0;
  15:Lib/FOC/i2t.c **** }
  16:Lib/FOC/i2t.c **** 
  17:Lib/FOC/i2t.c **** int i2t_set_config(i2t_t *hi2t, float i_rated, float i_max, float t_max) {
  18:Lib/FOC/i2t.c ****   if (i_rated <= 0 || i_max <= 0 || t_max <= 0) {
  19:Lib/FOC/i2t.c ****     return -1;
  20:Lib/FOC/i2t.c ****   }
  21:Lib/FOC/i2t.c **** 
  22:Lib/FOC/i2t.c ****   hi2t->i_rated = i_rated;
  23:Lib/FOC/i2t.c ****   hi2t->i_max = i_max;
  24:Lib/FOC/i2t.c ****   hi2t->t_max = t_max;
  25:Lib/FOC/i2t.c **** 
  26:Lib/FOC/i2t.c ****   hi2t->i2_rated = i_rated * i_rated;
  27:Lib/FOC/i2t.c ****   hi2t->acc_limit = (i_max * i_max - hi2t->i2_rated) * t_max;
  28:Lib/FOC/i2t.c **** 
  29:Lib/FOC/i2t.c ****   i2t_reset(hi2t);
