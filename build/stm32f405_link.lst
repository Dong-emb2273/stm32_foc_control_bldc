  56:Lib/LINK/stm32f405_link.c ****   if (HAL_TIMEx_PWMN_Start(htim, TIM_CHANNEL_3) != HAL_OK) return -1;
  57:Lib/LINK/stm32f405_link.c ****   // channel 4 is used to trigger the ADC
  58:Lib/LINK/stm32f405_link.c ****   if (HAL_TIM_PWM_Start(htim, TIM_CHANNEL_4) != HAL_OK) return -1;
