  29:Lib/LINK/stm32f405_link.c **** 
  30:Lib/LINK/stm32f405_link.c **** void link_set_pwm_freq(TIM_HandleTypeDef *htim, uint32_t freq) {
  31:Lib/LINK/stm32f405_link.c ****   const uint32_t timer_clock = get_timer_clock(htim);
  32:Lib/LINK/stm32f405_link.c **** 
  33:Lib/LINK/stm32f405_link.c ****   // prescaler and period for center-aligned mode
  34:Lib/LINK/stm32f405_link.c ****   uint32_t prescaler = 0;
  35:Lib/LINK/stm32f405_link.c ****   uint32_t period = (timer_clock / (2 * freq)) - 1;
  36:Lib/LINK/stm32f405_link.c **** 
  37:Lib/LINK/stm32f405_link.c ****   if (period > 0xFFFF) {
  38:Lib/LINK/stm32f405_link.c ****     prescaler = period / 0xFFFF;
  39:Lib/LINK/stm32f405_link.c ****     period = (timer_clock / (2 * freq * (prescaler + 1))) - 1;
  40:Lib/LINK/stm32f405_link.c ****   }
  41:Lib/LINK/stm32f405_link.c **** 
  42:Lib/LINK/stm32f405_link.c ****   htim->Instance->PSC = prescaler;
  43:Lib/LINK/stm32f405_link.c ****   htim->Instance->ARR = period;
  44:Lib/LINK/stm32f405_link.c **** }
