 433:Core/Src/config.c **** #ifdef __TIM_CONFIG__
 434:Core/Src/config.c **** 
 435:Core/Src/config.c **** void TIM1_PWM_DMA_CONFIG(void) {
 436:Core/Src/config.c **** 	// 1. B?t Clock 
 437:Core/Src/config.c **** 	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN | RCC_AHB1ENR_GPIOBEN | RCC_AHB1ENR_GPIOCEN;
 438:Core/Src/config.c **** 	RCC->AHB1ENR |= RCC_AHB1ENR_DMA2EN; 
 439:Core/Src/config.c **** 	RCC->APB2ENR |= RCC_APB2ENR_TIM1EN;
 440:Core/Src/config.c **** 
 441:Core/Src/config.c **** 	// 2. GPIO Config 
 442:Core/Src/config.c **** 
 443:Core/Src/config.c **** 	GPIO_TIM_PWM_INIT();
 444:Core/Src/config.c **** 	
 445:Core/Src/config.c **** 	TIM1->CR1 &= ~TIM_CR1_CEN;
 446:Core/Src/config.c **** 	
 447:Core/Src/config.c **** 
 448:Core/Src/config.c **** 	TIM1->CR1 &= ~TIM_CR1_CMS;
 449:Core/Src/config.c **** 	TIM1->CR1 |= TIM_CR1_CMS_0; 
 450:Core/Src/config.c **** 	
 451:Core/Src/config.c **** 	// Auto-reload preload enable (ARPE)
 452:Core/Src/config.c **** 	TIM1->CR1 |= TIM_CR1_ARPE;
 453:Core/Src/config.c **** 
 454:Core/Src/config.c **** 	TIM1->RCR = 0;
 455:Core/Src/config.c **** 
 456:Core/Src/config.c **** 	TIM1->CCMR1 = 0;
 457:Core/Src/config.c **** 	TIM1->CCMR2 = 0;
 458:Core/Src/config.c **** // CH4 ở chế độ PWM Mode 1 (110)
 459:Core/Src/config.c **** 	TIM1->CCMR2 &= ~TIM_CCMR2_OC4M;
 460:Core/Src/config.c **** 	TIM1->CCMR2 |= (6U << TIM_CCMR2_OC4M_Pos);
 461:Core/Src/config.c **** 	// CH1: PWM Mode 1 (110), Preload Enable (OC1PE)
 462:Core/Src/config.c **** 	TIM1->CCMR1 |= (6U << TIM_CCMR1_OC1M_Pos) | TIM_CCMR1_OC1PE;
ARM GAS  /tmp/cc0IhMcm.s 			page 18


 463:Core/Src/config.c **** 	// CH2: PWM Mode 1 (110), Preload Enable (OC2PE)
 464:Core/Src/config.c **** 	TIM1->CCMR1 |= (6U << TIM_CCMR1_OC2M_Pos) | TIM_CCMR1_OC2PE;
 465:Core/Src/config.c **** 	// CH3: PWM Mode 1 (110), Preload Enable (OC3PE)
 466:Core/Src/config.c **** 	TIM1->CCMR2 |= (6U << TIM_CCMR1_OC1M_Pos) | TIM_CCMR2_OC3PE; 
 467:Core/Src/config.c **** 
 468:Core/Src/config.c **** 	// 5. Channel Enable (CCER)
 469:Core/Src/config.c **** 	// CH1, CH1N, CH2, CH2N, CH3, CH3N, CH4
 470:Core/Src/config.c **** 
 471:Core/Src/config.c **** 	TIM1->CCER |= (TIM_CCER_CC1E | TIM_CCER_CC1NE |
 472:Core/Src/config.c **** 								 TIM_CCER_CC2E | TIM_CCER_CC2NE | 
 473:Core/Src/config.c **** 								 TIM_CCER_CC3E | TIM_CCER_CC3NE |
 474:Core/Src/config.c **** 								 TIM_CCER_CC4E);
 475:Core/Src/config.c **** 
 476:Core/Src/config.c **** 	// 6. Break & Deadtime (BDTR)
 477:Core/Src/config.c **** 	TIM1->BDTR = 0; // Reset
 478:Core/Src/config.c **** 	
 479:Core/Src/config.c **** 	TIM1->BDTR |= TIM_BDTR_OSSI | TIM_BDTR_OSSR;
 480:Core/Src/config.c **** 
 481:Core/Src/config.c **** 	// DEADTIME (DTG):
 482:Core/Src/config.c **** 	TIM1->BDTR &= ~TIM_BDTR_DTG; 
 483:Core/Src/config.c **** 	TIM1->BDTR |= (5 << TIM_BDTR_DTG_Pos);
 484:Core/Src/config.c **** 	// MOE: Main Output Enable 
 485:Core/Src/config.c **** 	TIM1->BDTR |= TIM_BDTR_MOE;
 486:Core/Src/config.c **** 	// 7. Interrupt & DMA Request
 487:Core/Src/config.c **** 	TIM1->EGR |= TIM_EGR_UG;
 488:Core/Src/config.c ****     
 489:Core/Src/config.c **** 	// 2. PHẢI XÓA CỜ NGẮT NGAY LẬP TỨC
 490:Core/Src/config.c **** 	// Để tránh việc CPU nhảy vào ngắt ngay khi cho phép NVIC
 491:Core/Src/config.c **** 	TIM1->SR = 0; // Xóa sạch mọi cờ báo trạng thái (đặc biệt là TIM_SR_UIF)
 492:Core/Src/config.c **** 
 493:Core/Src/config.c **** 	// 3. Bây giờ mới được phép bật ngắt trong Timer
 494:Core/Src/config.c **** //	TIM1->DIER |= TIM_DIER_UIE;
 495:Core/Src/config.c **** // 9. Enable Counter
 496:Core/Src/config.c **** //	TIM1->CR1 |= TIM_CR1_CEN;
 497:Core/Src/config.c **** 	
 498:Core/Src/config.c **** 	// NVIC Config
 499:Core/Src/config.c **** //	NVIC_SetPriority(TIM1_UP_TIM10_IRQn, 4);
 500:Core/Src/config.c **** //	NVIC_EnableIRQ(TIM1_UP_TIM10_IRQn);
 501:Core/Src/config.c **** }
 502:Core/Src/config.c **** //
 503:Core/Src/config.c **** 
 504:Core/Src/config.c **** void TIM_COUNTER_ENABLE(TIM_TypeDef *Timx){
 505:Core/Src/config.c **** 	Timx->CR1 |= TIM_CR1_CEN;
 506:Core/Src/config.c **** 	
 507:Core/Src/config.c **** }
 508:Core/Src/config.c **** //
 509:Core/Src/config.c **** 
 510:Core/Src/config.c **** void TIM_COUNT_US_CONFIG(void){
 511:Core/Src/config.c **** 	RCC->APB2ENR |= RCC_APB2ENR_TIM10EN;
 512:Core/Src/config.c **** 
 513:Core/Src/config.c **** 	TIM10->PSC = 167;
 514:Core/Src/config.c **** 	TIM10->ARR = 0xFFFF;
 515:Core/Src/config.c **** 	TIM10->EGR |= TIM_EGR_UG;
 516:Core/Src/config.c **** 
 517:Core/Src/config.c **** }
 518:Core/Src/config.c **** //
