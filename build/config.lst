 520:Core/Src/config.c **** void TIM_IQR_MS_CONGFIG(){
 521:Core/Src/config.c **** 	RCC->APB1ENR |= RCC_APB1ENR_TIM3EN;
 522:Core/Src/config.c **** 	TIM3->PSC = 839;  
 523:Core/Src/config.c **** 	TIM3->ARR = 999;  
 524:Core/Src/config.c **** 	TIM3->EGR |= TIM_EGR_UG;
 525:Core/Src/config.c **** 	TIM3->SR &= ~TIM_SR_UIF;
 526:Core/Src/config.c **** 	TIM3->DIER |= TIM_DIER_UIE; 
 527:Core/Src/config.c **** 	NVIC_SetPriority(TIM3_IRQn, 6);
 528:Core/Src/config.c **** 	NVIC_EnableIRQ(TIM3_IRQn);     
