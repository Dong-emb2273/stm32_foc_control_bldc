 533:Core/Src/config.c **** 
 534:Core/Src/config.c **** 
 535:Core/Src/config.c **** // ==========================================================
 536:Core/Src/config.c **** //				  CONFIG ADC & DMA ( EDIT HERE )
 537:Core/Src/config.c **** // ==========================================================
 538:Core/Src/config.c **** #ifdef __ADC_CONFIG__
 539:Core/Src/config.c **** 
 540:Core/Src/config.c **** void ADC1_DMA_CONFIG3(void) {
 541:Core/Src/config.c **** 	// 1. Bật Clock cho cả 3 ADC
 542:Core/Src/config.c **** 	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
 543:Core/Src/config.c **** 	RCC->APB2ENR |= RCC_APB2ENR_ADC1EN | RCC_APB2ENR_ADC2EN | RCC_APB2ENR_ADC3EN;
 544:Core/Src/config.c **** 
 545:Core/Src/config.c **** 	// 2. Cấu hình GPIO (PA0, PA1, PA2) -> Analog
 546:Core/Src/config.c **** 	GPIOA->MODER |= 0x3FFF; 
 547:Core/Src/config.c **** 	GPIOA->PUPDR &= ~0x3FFF;
 548:Core/Src/config.c **** 
 549:Core/Src/config.c **** 	// 3. Cấu hình chung cho khối ADC (ADC_CCR)
 550:Core/Src/config.c **** 	// ADCPRE = 01 (Chia 4 -> 21MHz)
 551:Core/Src/config.c **** 	// MULTI = 10101 (Triple Injected simultaneous mode only) - Xem RM0090 Table 62
 552:Core/Src/config.c **** 	// DMA = 0 (Không cần DMA cho Injected)
 553:Core/Src/config.c **** 	ADC->CCR = (1 << ADC_CCR_ADCPRE_Pos) | 
 554:Core/Src/config.c **** 						 (0x15 << ADC_CCR_MULTI_Pos); 
 555:Core/Src/config.c **** 
 556:Core/Src/config.c **** 	// --- CẤU HÌNH ADC1 (Master - Pha A) ---
 557:Core/Src/config.c **** 	ADC1->CR1 = ADC_CR1_SCAN | ADC_CR1_JEOCIE; // Bật ngắt JEOC ở Master
 558:Core/Src/config.c **** 	ADC1->CR2 = 0; // Trigger cài bên dưới
 559:Core/Src/config.c **** 	
 560:Core/Src/config.c **** 	// Trigger từ TIM1_CC4, Rising Edge
 561:Core/Src/config.c **** 	ADC1->CR2 |= (0 << ADC_CR2_JEXTSEL_Pos) | (2 << ADC_CR2_JEXTEN_Pos); 
 562:Core/Src/config.c **** 	
 563:Core/Src/config.c **** 	// Chuỗi Injected: 3 chuyển đổi (JL = 2)
 564:Core/Src/config.c **** 	ADC1->JSQR = (2 << ADC_JSQR_JL_Pos)   |  // JL = 2 (Đọc 3 kênh)
 565:Core/Src/config.c **** 	             (0 << ADC_JSQR_JSQ2_Pos) |  // Lượt 1: Channel 0 (PA0)
 566:Core/Src/config.c **** 	             (4 << ADC_JSQR_JSQ3_Pos) |  // Lượt 2: Channel 4 (PA4)
 567:Core/Src/config.c **** 	             (6 << ADC_JSQR_JSQ4_Pos);   // Lượt 3: Channel 6 (PA6)
 568:Core/Src/config.c **** 	
 569:Core/Src/config.c **** 	// Sample Time: 15 Cycles (010)
