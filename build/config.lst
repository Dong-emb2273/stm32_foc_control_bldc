 869:Core/Src/config.c **** /**
 870:Core/Src/config.c ****  * @brief  Doc nhiet do tu cam bien TMP117 su dung I2C1 va DMA.
 871:Core/Src/config.c ****  * @note   Ham nay gia dinh ban da co ham I2C1_DMA_Read_From_Reg.
 872:Core/Src/config.c ****  * @param  temperature_celsius Con tro toi mot bien float de luu gia tri nhiet do.
 873:Core/Src/config.c ****  * @retval I2C_DmaStatus_t Tra ve I2C_DMA_OK neu thanh cong, hoac ma loi neu that bai.
 874:Core/Src/config.c ****  */
 875:Core/Src/config.c **** // Dinh nghia dia chi I2C mac dinh cua TMP117 (khi chan ADD0 noi dat)
 876:Core/Src/config.c **** #define TMP117_I2C_ADDRESS 0x48
 877:Core/Src/config.c **** 
 878:Core/Src/config.c **** // Dinh nghia thanh ghi nhiet do (Temperature Register)
 879:Core/Src/config.c **** #define TMP117_TEMP_REGISTER 0x00
