 207:Core/Src/can.c **** /// 16 bit position, between -4*pi and 4*pi
ARM GAS  /tmp/ccuv8v1W.s 			page 17


 208:Core/Src/can.c **** /// 12 bit velocity, between -30 and 30 rad/s
 209:Core/Src/can.c **** /// 12 bit current, between -40 and 40;
 210:Core/Src/can.c **** /// CAN Packet is 5 8-bit words
 211:Core/Src/can.c **** /// Formatted as follows.  For each quantity, bit 0 is LSB
 212:Core/Src/can.c **** /// 0: [position[15-8]]
 213:Core/Src/can.c **** /// 1: [position[7-0]]
 214:Core/Src/can.c **** /// 2: [velocity[11-4]]
 215:Core/Src/can.c **** /// 3: [velocity[3-0], current[11-8]]
 216:Core/Src/can.c **** /// 4: [current[7-0]]
