  56:Core/Src/can.c **** //
  57:Core/Src/can.c **** 
  58:Core/Src/can.c **** 
  59:Core/Src/can.c **** /// CAN Command Packet Structure ///
  60:Core/Src/can.c **** /// 16 bit position command, between -4*pi and 4*pi
  61:Core/Src/can.c **** /// 12 bit velocity command, between -30 and 30 rad/s
  62:Core/Src/can.c **** /// 12 bit kp, between 0 and 500 N-m/rad
  63:Core/Src/can.c **** /// 12 bit kd, between 0 and 100 N-m*s/rad
  64:Core/Src/can.c **** /// 12 bit feed forward torque, between -18 and 18 N-m
  65:Core/Src/can.c **** /// CAN Packet is 8 8-bit words
  66:Core/Src/can.c **** /// Formatted as follows.  For each quantity, bit 0 is LSB
  67:Core/Src/can.c **** /// 0: [position[15-8]]
  68:Core/Src/can.c **** /// 1: [position[7-0]]
  69:Core/Src/can.c **** /// 2: [velocity[11-4]]
  70:Core/Src/can.c **** /// 3: [velocity[3-0], kp[11-8]]
  71:Core/Src/can.c **** /// 4: [kp[7-0]]
  72:Core/Src/can.c **** /// 5: [kd[11-4]]
  73:Core/Src/can.c **** /// 6: [kd[3-0], torque[11-8]]
  74:Core/Src/can.c **** /// 7: [torque[7-0]]
  75:Core/Src/can.c **** /* =========================================================================
  76:Core/Src/can.c ****  * CÁC HÀM DÀNH CHO MASTER
  77:Core/Src/can.c ****  * ========================================================================= */
  78:Core/Src/can.c **** 
  79:Core/Src/can.c **** // MASTER GỬI LỆNH: Đóng gói dữ liệu điều khiển để gửi xuống Slave
