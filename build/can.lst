 151:Core/Src/can.c **** 
 152:Core/Src/can.c **** 
 153:Core/Src/can.c **** /// CAN Command Packet Structure ///
 154:Core/Src/can.c **** /// 16 bit position command, between -4*pi and 4*pi
 155:Core/Src/can.c **** /// 12 bit velocity command, between -30 and 30 rad/s
 156:Core/Src/can.c **** /// 12 bit kp, between 0 and 500 N-m/rad
 157:Core/Src/can.c **** /// 12 bit kd, between 0 and 100 N-m*s/rad
 158:Core/Src/can.c **** /// 12 bit feed forward torque, between -18 and 18 N-m
 159:Core/Src/can.c **** /// CAN Packet is 8 8-bit words
 160:Core/Src/can.c **** /// Formatted as follows.  For each quantity, bit 0 is LSB
 161:Core/Src/can.c **** /// 0: [position[15-8]]
 162:Core/Src/can.c **** /// 1: [position[7-0]]
 163:Core/Src/can.c **** /// 2: [velocity[11-4]]
 164:Core/Src/can.c **** /// 3: [velocity[3-0], kp[11-8]]
 165:Core/Src/can.c **** /// 4: [kp[7-0]]
 166:Core/Src/can.c **** /// 5: [kd[11-4]]
 167:Core/Src/can.c **** /// 6: [kd[3-0], torque[11-8]]
 168:Core/Src/can.c **** /// 7: [torque[7-0]]
 169:Core/Src/can.c **** /* =========================================================================
 170:Core/Src/can.c ****  * CÁC HÀM DÀNH CHO MASTER
ARM GAS  /tmp/ccj7tLg8.s 			page 12


 171:Core/Src/can.c ****  * ========================================================================= */
