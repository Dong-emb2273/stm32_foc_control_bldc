 113:Core/Src/can.c **** /// unpack_cmd Reply Packet Structure ///
 114:Core/Src/can.c **** /// 16 bit position, between -4*pi and 4*pi
 115:Core/Src/can.c **** /// 12 bit velocity, between -30 and 30 rad/s
ARM GAS  /tmp/ccL1KasG.s 			page 10


 116:Core/Src/can.c **** /// 12 bit current, between -40 and 40;
 117:Core/Src/can.c **** /// CAN Packet is 5 8-bit words
 118:Core/Src/can.c **** /// Formatted as follows.  For each quantity, bit 0 is LSB
 119:Core/Src/can.c **** /// 0: [position[15-8]]
 120:Core/Src/can.c **** /// 1: [position[7-0]]
 121:Core/Src/can.c **** /// 2: [velocity[11-4]]
 122:Core/Src/can.c **** /// 3: [velocity[3-0], current[11-8]]
 123:Core/Src/can.c **** /// 4: [current[7-0]]
 124:Core/Src/can.c **** /* =========================================================================
 125:Core/Src/can.c ****  * CÁC HÀM DÀNH CHO SLAVE (MOTOR CONTROLLER)
 126:Core/Src/can.c ****  * ========================================================================= */
