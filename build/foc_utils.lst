 471:Core/Src/foc_utils.c **** 
 472:Core/Src/foc_utils.c **** void foc_auto_calibration(foc_t *hfoc) {
 473:Core/Src/foc_utils.c ****     printf("Starting Pole Pairs And Order Phase...\r\n");
 474:Core/Src/foc_utils.c **** 
 475:Core/Src/foc_utils.c ****     const float SWEEP_CYCLES = 20.0f; 
 476:Core/Src/foc_utils.c ****     const float W_CAL = TWO_PI / 0.2f; 
 477:Core/Src/foc_utils.c ****     const float SWEEP_TIME_SEC = (SWEEP_CYCLES * TWO_PI) / W_CAL; 
 478:Core/Src/foc_utils.c ****     const uint32_t step_delay_ms = 5; 
 479:Core/Src/foc_utils.c ****     const uint32_t total_steps = (uint32_t)(SWEEP_TIME_SEC * 1000.0f / step_delay_ms);
 480:Core/Src/foc_utils.c **** 
 481:Core/Src/foc_utils.c ****     // ==========================================
 482:Core/Src/foc_utils.c ****    for(int i = 0; i < 50; i++) {
 483:Core/Src/foc_utils.c ****         ENCODER_GetActualDegree(&encoder);
 484:Core/Src/foc_utils.c ****         osDelay(1); 
 485:Core/Src/foc_utils.c ****     }
 486:Core/Src/foc_utils.c **** 
 487:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, VD_CAL, 0.0f, 0.0f);
 488:Core/Src/foc_utils.c **** 
 489:Core/Src/foc_utils.c ****     osDelay(1000); 
 490:Core/Src/foc_utils.c ****     
 491:Core/Src/foc_utils.c ****     // ==========================================
