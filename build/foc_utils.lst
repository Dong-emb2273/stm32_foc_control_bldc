 414:Core/Src/foc_utils.c ****         
 415:Core/Src/foc_utils.c ****         float lut_pos = (mech_rad / TWO_PI) * ERROR_LUT_SIZE;
 416:Core/Src/foc_utils.c ****         int index = (int)(lut_pos);
 417:Core/Src/foc_utils.c **** 
 418:Core/Src/foc_utils.c ****         while (index < 0) {
