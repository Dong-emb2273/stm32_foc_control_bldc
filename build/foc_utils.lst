 391:Core/Src/foc_utils.c **** void foc_auto_calibration(foc_t *hfoc) {
 392:Core/Src/foc_utils.c ****     printf("Starting Order Phase Calibration Task...\r\n");
 393:Core/Src/foc_utils.c **** 
 394:Core/Src/foc_utils.c ****     const float SWEEP_CYCLES = 20.0f; 
 395:Core/Src/foc_utils.c ****     const float W_CAL = TWO_PI / 0.2f; 
 396:Core/Src/foc_utils.c ****     const float SWEEP_TIME_SEC = (SWEEP_CYCLES * TWO_PI) / W_CAL; 
 397:Core/Src/foc_utils.c ****     const uint32_t step_delay_ms = 5; 
 398:Core/Src/foc_utils.c ****     const uint32_t total_steps = (uint32_t)(SWEEP_TIME_SEC * 1000.0f / step_delay_ms);
 399:Core/Src/foc_utils.c **** 
 400:Core/Src/foc_utils.c ****     // ==========================================
 401:Core/Src/foc_utils.c ****    for(int i = 0; i < 50; i++) {
 402:Core/Src/foc_utils.c ****         ENCODER_GetActualDegree(&encoder);
 403:Core/Src/foc_utils.c ****         osDelay(1); 
 404:Core/Src/foc_utils.c ****     }
ARM GAS  /tmp/ccB9BjqW.s 			page 32


 405:Core/Src/foc_utils.c **** 
 406:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, VD_CAL, 0.0f, 0.0f);
 407:Core/Src/foc_utils.c **** 
 408:Core/Src/foc_utils.c ****     osDelay(1000); 
 409:Core/Src/foc_utils.c ****     
 410:Core/Src/foc_utils.c ****     // ==========================================
 411:Core/Src/foc_utils.c ****     encoder.output_angle_ovf = 0;
 412:Core/Src/foc_utils.c ****     encoder.output_prev_angle = encoder.angle_filtered; // Góc thô sau khi lọc nội bộ
 413:Core/Src/foc_utils.c ****     encoder.output_angle_filtered = encoder.angle_filtered; // Ép biến actual nhảy thẳng đ�
 414:Core/Src/foc_utils.c **** 
 415:Core/Src/foc_utils.c **** 
 416:Core/Src/foc_utils.c ****     float actual_theta_start = ENCODER_GetActualDegree(&encoder);
 417:Core/Src/foc_utils.c ****     
 418:Core/Src/foc_utils.c ****     
 419:Core/Src/foc_utils.c ****     for (uint32_t i = 0; i < total_steps; i++) {
 420:Core/Src/foc_utils.c ****         float elapsed_sec = (float)i * step_delay_ms / 1000.0f; 
 421:Core/Src/foc_utils.c ****         float elec_angle = W_CAL * elapsed_sec;
 422:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, 0.0f, elec_angle);
 423:Core/Src/foc_utils.c ****         ENCODER_GetActualDegree(&encoder); // Gọi liên tục để bù tràn
 424:Core/Src/foc_utils.c ****         osDelay(step_delay_ms); 
 425:Core/Src/foc_utils.c ****     }
 426:Core/Src/foc_utils.c **** 
 427:Core/Src/foc_utils.c ****   
 428:Core/Src/foc_utils.c ****     float actual_theta_end = ENCODER_GetActualDegree(&encoder);
 429:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, 0.0f, 0.0f, 0.0f); // Tắt áp
 430:Core/Src/foc_utils.c ****     
 431:Core/Src/foc_utils.c **** 
 432:Core/Src/foc_utils.c ****     float delta_mech = actual_theta_end - actual_theta_start;
 433:Core/Src/foc_utils.c ****     
 434:Core/Src/foc_utils.c ****     if (fabs(delta_mech) > 0.1f) {
 435:Core/Src/foc_utils.c ****         PPAIRS = round((SWEEP_CYCLES * 360.0f) / fabs(delta_mech));
 436:Core/Src/foc_utils.c ****         printf("Pole Pairs: %d\r\n", PPAIRS);
 437:Core/Src/foc_utils.c ****     }
 438:Core/Src/foc_utils.c ****     
 439:Core/Src/foc_utils.c ****    
 440:Core/Src/foc_utils.c ****     if (delta_mech > 0) {
 441:Core/Src/foc_utils.c ****         DIR_PHASE = NORMAL_DIR;
 442:Core/Src/foc_utils.c ****         printf("Phase order & Sensor match (NORMAL)\r\n");
 443:Core/Src/foc_utils.c ****     } else {
 444:Core/Src/foc_utils.c ****         DIR_PHASE = REVERSE_DIR;
 445:Core/Src/foc_utils.c ****         printf("Phase order & Sensor mismatched! Swapping (REVERSE)\r\n");
 446:Core/Src/foc_utils.c ****     }
 447:Core/Src/foc_utils.c **** 
 448:Core/Src/foc_utils.c ****     hfoc->done_orderphase = 1; 
 449:Core/Src/foc_utils.c ****     printf("Calibration Complete!\r\n");
 450:Core/Src/foc_utils.c **** }
