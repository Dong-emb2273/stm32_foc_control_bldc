 458:Core/Src/foc_utils.c **** void foc_auto_calibration(foc_t *hfoc) {
 459:Core/Src/foc_utils.c ****     printf("Starting Pole Pairs And Order Phase...\r\n");
 460:Core/Src/foc_utils.c **** 
 461:Core/Src/foc_utils.c ****     const float SWEEP_CYCLES = 20.0f; 
 462:Core/Src/foc_utils.c ****     const float W_CAL = TWO_PI / 0.2f; 
 463:Core/Src/foc_utils.c ****     const float SWEEP_TIME_SEC = (SWEEP_CYCLES * TWO_PI) / W_CAL; 
 464:Core/Src/foc_utils.c ****     const uint32_t step_delay_ms = 5; 
 465:Core/Src/foc_utils.c ****     const uint32_t total_steps = (uint32_t)(SWEEP_TIME_SEC * 1000.0f / step_delay_ms);
 466:Core/Src/foc_utils.c **** 
 467:Core/Src/foc_utils.c ****     // ==========================================
 468:Core/Src/foc_utils.c ****    for(int i = 0; i < 50; i++) {
 469:Core/Src/foc_utils.c ****         ENCODER_GetActualDegree(&encoder);
 470:Core/Src/foc_utils.c ****         osDelay(1); 
 471:Core/Src/foc_utils.c ****     }
 472:Core/Src/foc_utils.c **** 
 473:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, VD_CAL, 0.0f, 0.0f);
 474:Core/Src/foc_utils.c **** 
 475:Core/Src/foc_utils.c ****     osDelay(1000); 
ARM GAS  /tmp/ccQpMlaK.s 			page 42


 476:Core/Src/foc_utils.c ****     
