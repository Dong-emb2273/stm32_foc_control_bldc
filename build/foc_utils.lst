 549:Core/Src/foc_utils.c ****         float theta_e = 0.0f;
 550:Core/Src/foc_utils.c **** 
 551:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, vd, vq, theta_e);
 552:Core/Src/foc_utils.c **** 
