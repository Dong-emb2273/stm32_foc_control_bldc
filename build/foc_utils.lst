 495:Core/Src/foc_utils.c ****         float elec_angle = W_CAL * elapsed_sec;
 496:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, 0.0f, elec_angle);
 497:Core/Src/foc_utils.c ****         ENCODER_GetActualDegree(&encoder); 
