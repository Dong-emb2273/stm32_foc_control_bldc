 429:Core/Src/foc_utils.c ****     
 430:Core/Src/foc_utils.c **** 
 431:Core/Src/foc_utils.c ****     }
 432:Core/Src/foc_utils.c ****     
 433:Core/Src/foc_utils.c ****     for (int i = 0; i < ERROR_LUT_SIZE; i++) {
 434:Core/Src/foc_utils.c ****         if (error_temp[i] == 0) {
 435:Core/Src/foc_utils.c ****         int last_i = i - 1;
 436:Core/Src/foc_utils.c ****         int next_i = i + 1;
 437:Core/Src/foc_utils.c ****         if (last_i < 0) last_i += ERROR_LUT_SIZE;
