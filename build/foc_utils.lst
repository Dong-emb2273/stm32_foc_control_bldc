 253:Core/Src/foc_utils.c ****     float elec_rad = DEG_TO_RAD(mech_deg * hfoc->pole_pairs);
 254:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, VD_CAL, VQ_CAL, elec_rad);
