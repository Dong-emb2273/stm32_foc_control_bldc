 389:Core/Src/foc_utils.c **** void foc_cal_encoder_misalignment(foc_t *hfoc) {
 390:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, VD_CAL, VQ_CAL, 0.0f);
 391:Core/Src/foc_utils.c ****     osDelay(500);
 392:Core/Src/foc_utils.c ****     float rad_offset = 0.0f;
 393:Core/Src/foc_utils.c ****     for (int i = 0; i < CAL_ITERATION; i++) {
 394:Core/Src/foc_utils.c ****         rad_offset += DEG_TO_RAD(*hfoc->angle_filtered);
 395:Core/Src/foc_utils.c ****         osDelay(1);
 396:Core/Src/foc_utils.c ****     }
 397:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, 0.0f, 0.0f, 0.0f);
 398:Core/Src/foc_utils.c ****     rad_offset = rad_offset / (float)CAL_ITERATION;
 399:Core/Src/foc_utils.c ****     ENCDER_OFFSET = rad_offset;
 400:Core/Src/foc_utils.c ****     printf("Encoder Mechanical Offset (rad): %f\r\n", ENCDER_OFFSET);
 401:Core/Src/foc_utils.c **** 
 402:Core/Src/foc_utils.c **** }
