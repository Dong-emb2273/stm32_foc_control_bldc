 264:Core/Src/foc_utils.c **** 
 265:Core/Src/foc_utils.c ****     hfoc->id_ref = 0.0f;
 266:Core/Src/foc_utils.c ****     hfoc->iq_ref = iq_ff + cmd->kp * (pos - hfoc->actual_angle) + cmd->kd * (vel - hfoc->actual_rpm
 267:Core/Src/foc_utils.c ****     foc_torque_control_update(hfoc);
 268:Core/Src/foc_utils.c **** }
 269:Core/Src/foc_utils.c **** //
 270:Core/Src/foc_utils.c **** void foc_control_loop(foc_t *hfoc) {
 271:Core/Src/foc_utils.c ****     if (hfoc == NULL) return;
 272:Core/Src/foc_utils.c ****         
 273:Core/Src/foc_utils.c ****     if (POWER_FLAG == 1) {
 274:Core/Src/foc_utils.c ****         // printf("Power voltage is too low: %.2f V\r\n", hfoc->v_bus);
 275:Core/Src/foc_utils.c ****         return;
 276:Core/Src/foc_utils.c ****     }
 277:Core/Src/foc_utils.c ****     if (encoder.is_connected == 0) {
 278:Core/Src/foc_utils.c ****         DRV8323_Set_PWM(&hfoc->drv8323s, 0, 0, 0); // Stop PWM output
 279:Core/Src/foc_utils.c ****         return;
 280:Core/Src/foc_utils.c ****     }
 281:Core/Src/foc_utils.c **** 
 282:Core/Src/foc_utils.c ****     switch (hfoc->control_mode) {
 283:Core/Src/foc_utils.c ****         case TORQUE_CONTROL_MODE: {
 284:Core/Src/foc_utils.c ****             hfoc->id_ref = 0.0f;
 285:Core/Src/foc_utils.c ****             hfoc->iq_ref = SPOINT_TOR;
 286:Core/Src/foc_utils.c ****             foc_torque_control_update(hfoc);
 287:Core/Src/foc_utils.c ****             break;
 288:Core/Src/foc_utils.c ****         }
 289:Core/Src/foc_utils.c ****         case POSITION_CONTROL_MODE: {
 290:Core/Src/foc_utils.c ****             if (foc_torque_control_update(hfoc) == 1) {
 291:Core/Src/foc_utils.c ****                 hfoc->actual_angle = ENCODER_GetActualDegree(&encoder);
 292:Core/Src/foc_utils.c ****                 foc_calc_mech_pos_encoder(hfoc, hfoc->actual_angle);
 293:Core/Src/foc_utils.c ****                 foc_position_control_update(hfoc, SPOINT_POS);
 294:Core/Src/foc_utils.c ****             }
 295:Core/Src/foc_utils.c ****             break;
 296:Core/Src/foc_utils.c ****         }	
 297:Core/Src/foc_utils.c ****         case SPEED_CONTROL_MODE: {
 298:Core/Src/foc_utils.c ****             if (foc_torque_control_update(hfoc) == 1) {
 299:Core/Src/foc_utils.c ****                 foc_speed_control_update(hfoc, SPOINT_VEL);
ARM GAS  /tmp/ccSMSZuh.s 			page 26


 300:Core/Src/foc_utils.c ****             }
 301:Core/Src/foc_utils.c ****             break;
 302:Core/Src/foc_utils.c ****         }
 303:Core/Src/foc_utils.c ****         case IMPEDANCE_CONTROL_MODE: {
 304:Core/Src/foc_utils.c ****             hfoc->actual_angle = ENCODER_GetActualDegree(&encoder);
 305:Core/Src/foc_utils.c ****             foc_calc_mech_pos_encoder(hfoc, hfoc->actual_angle);
 306:Core/Src/foc_utils.c ****             foc_impedance_control(&joint_cmd, hfoc);
 307:Core/Src/foc_utils.c ****             break;
 308:Core/Src/foc_utils.c ****         }
 309:Core/Src/foc_utils.c ****         default:
 310:Core/Src/foc_utils.c ****                     
 311:Core/Src/foc_utils.c ****             break;
 312:Core/Src/foc_utils.c ****                 
 313:Core/Src/foc_utils.c ****     }
 314:Core/Src/foc_utils.c **** }
