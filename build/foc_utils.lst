 330:Core/Src/foc_utils.c **** void foc_cal_encoder(foc_t *hfoc) {
 331:Core/Src/foc_utils.c ****     memset(error_temp, 0, sizeof(error_temp));
 332:Core/Src/foc_utils.c **** 
 333:Core/Src/foc_utils.c ****     printf("Starting Encoder Calibration Task...\r\n");
 334:Core/Src/foc_utils.c ****     foc_cal_encoder_misalignment(hfoc);
 335:Core/Src/foc_utils.c **** 
 336:Core/Src/foc_utils.c ****     for (int i = 0; i < ERROR_LUT_SIZE; i++) {
 337:Core/Src/foc_utils.c ****         float mech_deg = (float)i * (360.0f / (float)ERROR_LUT_SIZE);
 338:Core/Src/foc_utils.c ****         float elec_rad = DEG_TO_RAD(mech_deg * PPAIRS);
 339:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, VQ_CAL, elec_rad);
 340:Core/Src/foc_utils.c ****         osDelay(5);
 341:Core/Src/foc_utils.c **** 
 342:Core/Src/foc_utils.c ****         float mech_rad = hfoc->m_angle_rad;
 343:Core/Src/foc_utils.c ****         float raw_delta = elec_rad - hfoc->e_angle_rad;
 344:Core/Src/foc_utils.c ****         float delta = elec_rad - hfoc->e_angle_rad_comp;
 345:Core/Src/foc_utils.c ****         
 346:Core/Src/foc_utils.c ****         raw_delta -= TWO_PI * floorf((raw_delta + PI) / TWO_PI);
 347:Core/Src/foc_utils.c ****         delta -= TWO_PI * floorf((delta + PI) / TWO_PI);
 348:Core/Src/foc_utils.c ****         
 349:Core/Src/foc_utils.c ****         float lut_pos = (mech_rad / TWO_PI) * ERROR_LUT_SIZE;
 350:Core/Src/foc_utils.c ****         int index = (int)(lut_pos);
 351:Core/Src/foc_utils.c **** 
 352:Core/Src/foc_utils.c ****         while (index < 0) {
 353:Core/Src/foc_utils.c ****         index += ERROR_LUT_SIZE;
 354:Core/Src/foc_utils.c ****         }
 355:Core/Src/foc_utils.c ****         index %= ERROR_LUT_SIZE;
 356:Core/Src/foc_utils.c **** 
 357:Core/Src/foc_utils.c ****         error_temp[index] = raw_delta;
 358:Core/Src/foc_utils.c ****     
 359:Core/Src/foc_utils.c **** 
 360:Core/Src/foc_utils.c ****     }
 361:Core/Src/foc_utils.c ****     
 362:Core/Src/foc_utils.c ****     for (int i = 0; i < ERROR_LUT_SIZE; i++) {
 363:Core/Src/foc_utils.c ****         if (error_temp[i] == 0) {
 364:Core/Src/foc_utils.c ****         int last_i = i - 1;
 365:Core/Src/foc_utils.c ****         int next_i = i + 1;
 366:Core/Src/foc_utils.c ****         if (last_i < 0) last_i += ERROR_LUT_SIZE;
 367:Core/Src/foc_utils.c ****         if (next_i > ERROR_LUT_SIZE) next_i -= ERROR_LUT_SIZE;
 368:Core/Src/foc_utils.c ****         error_temp[i] = (error_temp[last_i] + error_temp[next_i]) / 2.0f;
 369:Core/Src/foc_utils.c ****         }
 370:Core/Src/foc_utils.c ****     }
 371:Core/Src/foc_utils.c **** 
 372:Core/Src/foc_utils.c ****     memcpy(m_config.encd_error_comp, error_temp, sizeof(error_temp));
 373:Core/Src/foc_utils.c **** 
