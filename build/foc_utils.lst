 434:Core/Src/foc_utils.c ****     for (int i = 0; i < ERROR_LUT_SIZE; i++) {
 435:Core/Src/foc_utils.c ****         if (error_temp[i] == 0) {
 436:Core/Src/foc_utils.c ****         int last_i = i - 1;
 437:Core/Src/foc_utils.c ****         int next_i = i + 1;
 438:Core/Src/foc_utils.c ****         if (last_i < 0) last_i += ERROR_LUT_SIZE;
 439:Core/Src/foc_utils.c ****         if (next_i > ERROR_LUT_SIZE) next_i -= ERROR_LUT_SIZE;
 440:Core/Src/foc_utils.c ****         error_temp[i] = (error_temp[last_i] + error_temp[next_i]) / 2.0f;
 441:Core/Src/foc_utils.c ****         }
 442:Core/Src/foc_utils.c ****     }
 443:Core/Src/foc_utils.c **** 
 444:Core/Src/foc_utils.c ****     memcpy(m_config.encd_error_comp, error_temp, sizeof(error_temp));
