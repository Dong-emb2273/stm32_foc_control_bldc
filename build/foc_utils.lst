 409:Core/Src/foc_utils.c ****         float elec_rad = DEG_TO_RAD(mech_deg * PPAIRS);
 410:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, VQ_CAL, elec_rad);
 411:Core/Src/foc_utils.c ****         osDelay(5);
 412:Core/Src/foc_utils.c **** 
 413:Core/Src/foc_utils.c ****         float mech_rad = hfoc->m_angle_rad;
 414:Core/Src/foc_utils.c ****         float raw_delta = elec_rad - hfoc->e_angle_rad;
 415:Core/Src/foc_utils.c ****         float delta = elec_rad - hfoc->e_angle_rad_comp;
 416:Core/Src/foc_utils.c ****         
 417:Core/Src/foc_utils.c ****         raw_delta -= TWO_PI * floorf((raw_delta + PI) / TWO_PI);
 418:Core/Src/foc_utils.c ****         delta -= TWO_PI * floorf((delta + PI) / TWO_PI);
 419:Core/Src/foc_utils.c ****         
 420:Core/Src/foc_utils.c ****         float lut_pos = (mech_rad / TWO_PI) * ERROR_LUT_SIZE;
 421:Core/Src/foc_utils.c ****         int index = (int)(lut_pos);
 422:Core/Src/foc_utils.c **** 
 423:Core/Src/foc_utils.c ****         while (index < 0) {
 424:Core/Src/foc_utils.c ****         index += ERROR_LUT_SIZE;
 425:Core/Src/foc_utils.c ****         }
