 475:Core/Src/foc_utils.c ****         osDelay(1); 
 476:Core/Src/foc_utils.c ****     }
 477:Core/Src/foc_utils.c **** 
 478:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, VD_CAL, 0.0f, 0.0f);
 479:Core/Src/foc_utils.c **** 
