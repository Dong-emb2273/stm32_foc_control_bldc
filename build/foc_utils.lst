 260:Core/Src/foc_utils.c **** void foc_impedance_control(JointCommand_t *cmd, foc_t *hfoc) {
 261:Core/Src/foc_utils.c ****     float pos = RAD_TO_DEG(cmd->p_des)*GR;
 262:Core/Src/foc_utils.c ****     float vel = RADS_TO_RPM(cmd->v_des)*GR;
