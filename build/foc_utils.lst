 256:Core/Src/foc_utils.c **** 
 257:Core/Src/foc_utils.c ****     float mech_rad = hfoc->m_angle_rad;
 258:Core/Src/foc_utils.c ****     float raw_delta = elec_rad - hfoc->e_angle_rad;
 259:Core/Src/foc_utils.c ****     float delta = elec_rad - hfoc->e_angle_rad_comp;
 260:Core/Src/foc_utils.c ****     
 261:Core/Src/foc_utils.c ****     raw_delta -= TWO_PI * floorf((raw_delta + PI) / TWO_PI);
 262:Core/Src/foc_utils.c ****     delta -= TWO_PI * floorf((delta + PI) / TWO_PI);
 263:Core/Src/foc_utils.c ****     
 264:Core/Src/foc_utils.c ****     float lut_pos = (mech_rad / TWO_PI) * ERROR_LUT_SIZE;
 265:Core/Src/foc_utils.c ****     int index = (int)(lut_pos);
 266:Core/Src/foc_utils.c **** 
 267:Core/Src/foc_utils.c ****     while (index < 0) {
 268:Core/Src/foc_utils.c ****       index += ERROR_LUT_SIZE;
 269:Core/Src/foc_utils.c ****     }
 270:Core/Src/foc_utils.c ****     index %= ERROR_LUT_SIZE;
 271:Core/Src/foc_utils.c **** 
 272:Core/Src/foc_utils.c ****     error_temp[index] = raw_delta;
 273:Core/Src/foc_utils.c ****     
 274:Core/Src/foc_utils.c ****     // debug
 275:Core/Src/foc_utils.c ****     float buffer_val[2];
 276:Core/Src/foc_utils.c ****     // buffer_val[0] = raw_delta;
 277:Core/Src/foc_utils.c ****     // buffer_val[1] = delta;
 278:Core/Src/foc_utils.c ****     buffer_val[0] = delta;
 279:Core/Src/foc_utils.c **** 
 280:Core/Src/foc_utils.c ****   }
 281:Core/Src/foc_utils.c ****   
 282:Core/Src/foc_utils.c ****   for (int i = 0; i < ERROR_LUT_SIZE; i++) {
 283:Core/Src/foc_utils.c ****     if (error_temp[i] == 0) {
 284:Core/Src/foc_utils.c ****       int last_i = i - 1;
 285:Core/Src/foc_utils.c ****       int next_i = i + 1;
 286:Core/Src/foc_utils.c ****       if (last_i < 0) last_i += ERROR_LUT_SIZE;
