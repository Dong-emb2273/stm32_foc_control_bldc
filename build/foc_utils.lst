 402:Core/Src/foc_utils.c **** void foc_cal_encoder(foc_t *hfoc) {
 403:Core/Src/foc_utils.c ****     memset(error_temp, 0, sizeof(error_temp));
 404:Core/Src/foc_utils.c **** 
 405:Core/Src/foc_utils.c ****     printf("Starting Encoder Calibration Task...\r\n");
 406:Core/Src/foc_utils.c ****     foc_cal_encoder_misalignment(hfoc);
 407:Core/Src/foc_utils.c **** 
 408:Core/Src/foc_utils.c ****     for (int i = 0; i < ERROR_LUT_SIZE; i++) {
 409:Core/Src/foc_utils.c ****         float mech_deg = (float)i * (360.0f / (float)ERROR_LUT_SIZE);
 410:Core/Src/foc_utils.c ****         float elec_rad = DEG_TO_RAD(mech_deg * PPAIRS);
 411:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, VQ_CAL, elec_rad);
 412:Core/Src/foc_utils.c ****         osDelay(5);
 413:Core/Src/foc_utils.c **** 
 414:Core/Src/foc_utils.c ****         float mech_rad = hfoc->m_angle_rad;
 415:Core/Src/foc_utils.c ****         float raw_delta = elec_rad - hfoc->e_angle_rad;
 416:Core/Src/foc_utils.c ****         float delta = elec_rad - hfoc->e_angle_rad_comp;
 417:Core/Src/foc_utils.c ****         
 418:Core/Src/foc_utils.c ****         raw_delta -= TWO_PI * floorf((raw_delta + PI) / TWO_PI);
 419:Core/Src/foc_utils.c ****         delta -= TWO_PI * floorf((delta + PI) / TWO_PI);
 420:Core/Src/foc_utils.c ****         
 421:Core/Src/foc_utils.c ****         float lut_pos = (mech_rad / TWO_PI) * ERROR_LUT_SIZE;
 422:Core/Src/foc_utils.c ****         int index = (int)(lut_pos);
 423:Core/Src/foc_utils.c **** 
 424:Core/Src/foc_utils.c ****         while (index < 0) {
 425:Core/Src/foc_utils.c ****         index += ERROR_LUT_SIZE;
 426:Core/Src/foc_utils.c ****         }
 427:Core/Src/foc_utils.c ****         index %= ERROR_LUT_SIZE;
 428:Core/Src/foc_utils.c **** 
 429:Core/Src/foc_utils.c ****         error_temp[index] = raw_delta;
 430:Core/Src/foc_utils.c ****     
 431:Core/Src/foc_utils.c **** 
 432:Core/Src/foc_utils.c ****     }
 433:Core/Src/foc_utils.c ****     
