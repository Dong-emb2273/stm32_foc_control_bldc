 390:Core/Src/foc_utils.c ****     for (int i = 0; i < CAL_ITERATION; i++) {
 391:Core/Src/foc_utils.c ****         rad_offset += DEG_TO_RAD(*hfoc->angle_filtered);
 392:Core/Src/foc_utils.c ****         osDelay(1);
 393:Core/Src/foc_utils.c ****     }
 394:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, 0.0f, 0.0f, 0.0f);
 395:Core/Src/foc_utils.c ****     rad_offset = rad_offset / (float)CAL_ITERATION;
 396:Core/Src/foc_utils.c ****     ENCDER_OFFSET = rad_offset;
