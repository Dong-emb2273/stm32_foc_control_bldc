 370:Core/Src/foc_utils.c **** void foc_auto_calibration_update(foc_t *hfoc) {
 371:Core/Src/foc_utils.c ****     static uint32_t cal_start_time = 0;
 372:Core/Src/foc_utils.c ****     static float actual_theta_start = 0.0f;
 373:Core/Src/foc_utils.c ****     static uint8_t cal_started = 0; 
 374:Core/Src/foc_utils.c **** 
 375:Core/Src/foc_utils.c ****     if (cal_started == 0) {
 376:Core/Src/foc_utils.c ****         cal_start_time = HAL_GetTick();
 377:Core/Src/foc_utils.c ****         cal_started = 1;
 378:Core/Src/foc_utils.c ****     }
 379:Core/Src/foc_utils.c **** 
 380:Core/Src/foc_utils.c ****     uint32_t current_time = HAL_GetTick();
 381:Core/Src/foc_utils.c ****     float elapsed_sec = (current_time - cal_start_time) / 1000.0f;
 382:Core/Src/foc_utils.c **** 
 383:Core/Src/foc_utils.c ****     const float SWEEP_CYCLES = 20.0f; 
 384:Core/Src/foc_utils.c ****     const float T1 = 1.0f; 
 385:Core/Src/foc_utils.c ****     const float W_CAL = TWO_PI / 0.2f; 
 386:Core/Src/foc_utils.c ****     const float SWEEP_TIME = (SWEEP_CYCLES * TWO_PI) / W_CAL;
 387:Core/Src/foc_utils.c **** 
 388:Core/Src/foc_utils.c ****     if (elapsed_sec < T1) {
 389:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, 0.0f, 0.0f);
 390:Core/Src/foc_utils.c ****         actual_theta_start = ENCODER_GetActualDegree(&encoder);
 391:Core/Src/foc_utils.c ****     } 
 392:Core/Src/foc_utils.c ****     else if (elapsed_sec < T1 + SWEEP_TIME) {
 393:Core/Src/foc_utils.c ****         float elec_angle = W_CAL * (elapsed_sec - T1);
 394:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, 0.0f, elec_angle);
 395:Core/Src/foc_utils.c ****         ENCODER_GetActualDegree(&encoder);
 396:Core/Src/foc_utils.c ****     } 
 397:Core/Src/foc_utils.c ****     else {
 398:Core/Src/foc_utils.c ****         float actual_theta_end = ENCODER_GetActualDegree(&encoder);
 399:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, 0.0f, 0.0f, 0.0f);
 400:Core/Src/foc_utils.c ****     
 401:Core/Src/foc_utils.c ****         float delta_mech = actual_theta_end - actual_theta_start;
 402:Core/Src/foc_utils.c ****         
 403:Core/Src/foc_utils.c ****         if (fabs(delta_mech) > 0.1f) {
 404:Core/Src/foc_utils.c ****             hfoc->pole_pairs = round((SWEEP_CYCLES * 360.0f)/ fabs(delta_mech));
 405:Core/Src/foc_utils.c ****             printf("Pole Pairs: %d\r\n", hfoc->pole_pairs);
 406:Core/Src/foc_utils.c ****         }
 407:Core/Src/foc_utils.c ****         if (delta_mech > 0) {
 408:Core/Src/foc_utils.c ****             hfoc->sensor_dir = NORMAL_DIR;
 409:Core/Src/foc_utils.c ****             printf("Phase order & Sensor match (NORMAL)\r\n");
 410:Core/Src/foc_utils.c ****         } else {
 411:Core/Src/foc_utils.c ****             hfoc->sensor_dir = REVERSE_DIR;
 412:Core/Src/foc_utils.c ****             printf("Phase order & Sensor mismatched! Swapping (REVERSE)\r\n");
ARM GAS  /tmp/ccQUVXVz.s 			page 31


 413:Core/Src/foc_utils.c ****         }
 414:Core/Src/foc_utils.c ****         hfoc->done_orderphase = 1; // Done calibration
 415:Core/Src/foc_utils.c ****         cal_started = 0;
 416:Core/Src/foc_utils.c ****         cal_start_time = 0;
 417:Core/Src/foc_utils.c ****         actual_theta_start = 0.0f;
 418:Core/Src/foc_utils.c ****     }
 419:Core/Src/foc_utils.c **** }
