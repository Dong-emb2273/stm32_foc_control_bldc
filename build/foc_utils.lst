 556:Core/Src/foc_utils.c ****         float id, iq;
 557:Core/Src/foc_utils.c ****         pre_calc_sin_cos(theta_e, &sin_theta, &cos_theta);
 558:Core/Src/foc_utils.c ****         clarke_park_transform(hfoc->ia, hfoc->ib, sin_theta, cos_theta, &id, &iq);
 559:Core/Src/foc_utils.c **** 
 560:Core/Src/foc_utils.c ****         if (hfoc->meas_inj_n >= wt) {
