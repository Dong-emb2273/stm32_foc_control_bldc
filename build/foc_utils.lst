 423:Core/Src/foc_utils.c **** void foc_auto_calibration(foc_t *hfoc) {
 424:Core/Src/foc_utils.c ****     printf("Starting RTOS Calibration Task...\r\n");
 425:Core/Src/foc_utils.c **** 
 426:Core/Src/foc_utils.c ****     const float SWEEP_CYCLES = 20.0f; 
 427:Core/Src/foc_utils.c ****     const float W_CAL = TWO_PI / 0.2f; 
 428:Core/Src/foc_utils.c ****     const float SWEEP_TIME_SEC = (SWEEP_CYCLES * TWO_PI) / W_CAL; 
 429:Core/Src/foc_utils.c ****     const uint32_t step_delay_ms = 5; 
 430:Core/Src/foc_utils.c ****     const uint32_t total_steps = (uint32_t)(SWEEP_TIME_SEC * 1000.0f / step_delay_ms);
 431:Core/Src/foc_utils.c **** 
 432:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, VD_CAL, 0.0f, 0.0f);
 433:Core/Src/foc_utils.c ****     osDelay(1000); 
 434:Core/Src/foc_utils.c ****     float actual_theta_start = ENCODER_GetActualDegree(&encoder);
 435:Core/Src/foc_utils.c ****     for (uint32_t i = 0; i < total_steps; i++) {
 436:Core/Src/foc_utils.c ****         float elapsed_sec = (float)i * step_delay_ms / 1000.0f; 
 437:Core/Src/foc_utils.c ****         float elec_angle = W_CAL * elapsed_sec;
 438:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, 0.0f, elec_angle);
 439:Core/Src/foc_utils.c ****         ENCODER_GetActualDegree(&encoder);
 440:Core/Src/foc_utils.c ****         osDelay(step_delay_ms); 
 441:Core/Src/foc_utils.c ****     }
 442:Core/Src/foc_utils.c **** 
 443:Core/Src/foc_utils.c ****     float actual_theta_end = ENCODER_GetActualDegree(&encoder);
 444:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, 0.0f, 0.0f, 0.0f);
 445:Core/Src/foc_utils.c ****     float delta_mech = actual_theta_end - actual_theta_start;
 446:Core/Src/foc_utils.c ****     if (fabs(delta_mech) > 0.1f) {
 447:Core/Src/foc_utils.c ****         hfoc->pole_pairs = round((SWEEP_CYCLES * 360.0f) / fabs(delta_mech));
 448:Core/Src/foc_utils.c ****         printf("Pole Pairs: %d\r\n", hfoc->pole_pairs);
 449:Core/Src/foc_utils.c ****     }
 450:Core/Src/foc_utils.c ****     if (delta_mech > 0) {
 451:Core/Src/foc_utils.c ****         hfoc->sensor_dir = NORMAL_DIR;
 452:Core/Src/foc_utils.c ****         printf("Phase order & Sensor match (NORMAL)\r\n");
 453:Core/Src/foc_utils.c ****     } else {
 454:Core/Src/foc_utils.c ****         hfoc->sensor_dir = REVERSE_DIR;
 455:Core/Src/foc_utils.c ****         printf("Phase order & Sensor mismatched! Swapping (REVERSE)\r\n");
 456:Core/Src/foc_utils.c ****     }
 457:Core/Src/foc_utils.c **** 
 458:Core/Src/foc_utils.c **** 
 459:Core/Src/foc_utils.c ****     hfoc->done_orderphase = 1; 
 460:Core/Src/foc_utils.c ****     printf("Calibration Complete!\r\n");
 461:Core/Src/foc_utils.c ****     
 462:Core/Src/foc_utils.c ****     // Lưu ý: Nếu bạn gọi hàm này trong 1 Task riêng biệt, 
 463:Core/Src/foc_utils.c ****     // bạn có thể dùng vTaskDelete(NULL) ở đây để hủy Task sau khi chạy xong (nế
 464:Core/Src/foc_utils.c **** }
