 399:Core/Src/foc_utils.c **** void foc_cal_encoder_misalignment(foc_t *hfoc) {
 400:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, VD_CAL, VQ_CAL, 0.0f);
 401:Core/Src/foc_utils.c ****     osDelay(500);
 402:Core/Src/foc_utils.c ****     float rad_offset = 0.0f;
 403:Core/Src/foc_utils.c ****     for (int i = 0; i < CAL_ITERATION; i++) {
 404:Core/Src/foc_utils.c ****         rad_offset += DEG_TO_RAD(*hfoc->angle_filtered);
 405:Core/Src/foc_utils.c ****         osDelay(1);
 406:Core/Src/foc_utils.c ****     }
 407:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, 0.0f, 0.0f, 0.0f);
 408:Core/Src/foc_utils.c ****     rad_offset = rad_offset / (float)CAL_ITERATION;
 409:Core/Src/foc_utils.c ****     ENCDER_OFFSET = rad_offset;
 410:Core/Src/foc_utils.c ****     printf("Encoder Mechanical Offset (rad): %f\r\n", ENCDER_OFFSET);
 411:Core/Src/foc_utils.c **** 
 412:Core/Src/foc_utils.c **** }
