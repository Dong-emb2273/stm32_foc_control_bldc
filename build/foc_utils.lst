 386:Core/Src/foc_utils.c **** void foc_cal_encoder_misalignment(foc_t *hfoc) {
 387:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, VD_CAL, VQ_CAL, 0.0f);
 388:Core/Src/foc_utils.c ****     osDelay(500);
