 430:Core/Src/foc_utils.c ****         int last_i = i - 1;
 431:Core/Src/foc_utils.c ****         int next_i = i + 1;
 432:Core/Src/foc_utils.c ****         if (last_i < 0) last_i += ERROR_LUT_SIZE;
