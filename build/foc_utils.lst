 440:Core/Src/foc_utils.c **** void foc_auto_calibration(foc_t *hfoc) {
 441:Core/Src/foc_utils.c ****     printf("Starting Pole Pairs And Order Phase...\r\n");
 442:Core/Src/foc_utils.c **** 
 443:Core/Src/foc_utils.c ****     const float SWEEP_CYCLES = 20.0f; 
 444:Core/Src/foc_utils.c ****     const float W_CAL = TWO_PI / 0.2f; 
 445:Core/Src/foc_utils.c ****     const float SWEEP_TIME_SEC = (SWEEP_CYCLES * TWO_PI) / W_CAL; 
 446:Core/Src/foc_utils.c ****     const uint32_t step_delay_ms = 5; 
ARM GAS  /tmp/cc8Invf0.s 			page 39


 447:Core/Src/foc_utils.c ****     const uint32_t total_steps = (uint32_t)(SWEEP_TIME_SEC * 1000.0f / step_delay_ms);
 448:Core/Src/foc_utils.c **** 
 449:Core/Src/foc_utils.c ****     // ==========================================
 450:Core/Src/foc_utils.c ****    for(int i = 0; i < 50; i++) {
 451:Core/Src/foc_utils.c ****         ENCODER_GetActualDegree(&encoder);
 452:Core/Src/foc_utils.c ****         osDelay(1); 
 453:Core/Src/foc_utils.c ****     }
 454:Core/Src/foc_utils.c **** 
 455:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, VD_CAL, 0.0f, 0.0f);
 456:Core/Src/foc_utils.c **** 
 457:Core/Src/foc_utils.c ****     osDelay(1000); 
 458:Core/Src/foc_utils.c ****     
 459:Core/Src/foc_utils.c ****     // ==========================================
 460:Core/Src/foc_utils.c ****     encoder.output_angle_ovf = 0;
 461:Core/Src/foc_utils.c ****     encoder.output_prev_angle = encoder.angle_filtered; // Góc thô sau khi lọc nội bộ
 462:Core/Src/foc_utils.c ****     encoder.output_angle_filtered = encoder.angle_filtered; // Ép biến actual nhảy thẳng đ�
 463:Core/Src/foc_utils.c **** 
 464:Core/Src/foc_utils.c **** 
 465:Core/Src/foc_utils.c ****     float actual_theta_start = ENCODER_GetActualDegree(&encoder);
 466:Core/Src/foc_utils.c ****     
 467:Core/Src/foc_utils.c ****     
 468:Core/Src/foc_utils.c ****     for (uint32_t i = 0; i < total_steps; i++) {
 469:Core/Src/foc_utils.c ****         float elapsed_sec = (float)i * step_delay_ms / 1000.0f; 
 470:Core/Src/foc_utils.c ****         float elec_angle = W_CAL * elapsed_sec;
 471:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, 0.0f, elec_angle);
 472:Core/Src/foc_utils.c ****         ENCODER_GetActualDegree(&encoder); // Gọi liên tục để bù tràn
 473:Core/Src/foc_utils.c ****         osDelay(step_delay_ms); 
 474:Core/Src/foc_utils.c ****     }
 475:Core/Src/foc_utils.c **** 
 476:Core/Src/foc_utils.c ****   
 477:Core/Src/foc_utils.c ****     float actual_theta_end = ENCODER_GetActualDegree(&encoder);
 478:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, 0.0f, 0.0f, 0.0f); // Tắt áp
 479:Core/Src/foc_utils.c ****     
 480:Core/Src/foc_utils.c **** 
 481:Core/Src/foc_utils.c ****     float delta_mech = actual_theta_end - actual_theta_start;
 482:Core/Src/foc_utils.c ****     
 483:Core/Src/foc_utils.c ****     if (fabs(delta_mech) > 0.1f) {
 484:Core/Src/foc_utils.c ****         PPAIRS = round((SWEEP_CYCLES * 360.0f) / fabs(delta_mech));
 485:Core/Src/foc_utils.c ****         printf("Pole Pairs: %d\r\n", PPAIRS);
 486:Core/Src/foc_utils.c ****     }
 487:Core/Src/foc_utils.c ****     
 488:Core/Src/foc_utils.c ****    
 489:Core/Src/foc_utils.c ****     if (delta_mech > 0) {
 490:Core/Src/foc_utils.c ****         DIR_PHASE = NORMAL_DIR;
 491:Core/Src/foc_utils.c ****         printf("Phase order & Sensor match (NORMAL)\r\n");
 492:Core/Src/foc_utils.c ****     } else {
 493:Core/Src/foc_utils.c ****         DIR_PHASE = REVERSE_DIR;
 494:Core/Src/foc_utils.c ****         printf("Phase order & Sensor mismatched! Swapping (REVERSE)\r\n");
 495:Core/Src/foc_utils.c ****     }
 496:Core/Src/foc_utils.c **** 
 497:Core/Src/foc_utils.c ****     hfoc->done_orderphase = 1; 
 498:Core/Src/foc_utils.c ****     printf("Calibration Complete!\r\n");
 499:Core/Src/foc_utils.c **** }
