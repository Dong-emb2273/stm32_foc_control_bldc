 478:Core/Src/foc_utils.c ****     encoder.output_angle_ovf = 0;
 479:Core/Src/foc_utils.c ****     encoder.output_prev_angle = encoder.angle_filtered; // Góc thô sau khi lọc nội bộ
 480:Core/Src/foc_utils.c ****     encoder.output_angle_filtered = encoder.angle_filtered; // Ép biến actual nhảy thẳng đ�
 481:Core/Src/foc_utils.c **** 
 482:Core/Src/foc_utils.c **** 
 483:Core/Src/foc_utils.c ****     float actual_theta_start = ENCODER_GetActualDegree(&encoder);
 484:Core/Src/foc_utils.c ****     
 485:Core/Src/foc_utils.c **** 
 486:Core/Src/foc_utils.c ****     for (uint32_t i = 0; i < total_steps; i++) {
 487:Core/Src/foc_utils.c ****         float elapsed_sec = (float)i * step_delay_ms / 1000.0f; 
 488:Core/Src/foc_utils.c ****         float elec_angle = W_CAL * elapsed_sec;
 489:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, 0.0f, elec_angle);
 490:Core/Src/foc_utils.c ****         ENCODER_GetActualDegree(&encoder); 
 491:Core/Src/foc_utils.c ****         osDelay(step_delay_ms); 
