 275:Core/Src/foc_utils.c **** void foc_control_loop(foc_t *hfoc) {
 276:Core/Src/foc_utils.c ****     if (hfoc == NULL) return;
 277:Core/Src/foc_utils.c ****         
 278:Core/Src/foc_utils.c ****     if (RF_POWER) {
 279:Core/Src/foc_utils.c ****         // printf("Power voltage is too low: %.2f V\r\n", hfoc->v_bus);
 280:Core/Src/foc_utils.c ****         return;
 281:Core/Src/foc_utils.c ****     }
 282:Core/Src/foc_utils.c ****     if (encoder.is_connected == 0) {
 283:Core/Src/foc_utils.c ****         DRV8323_Set_PWM(&hfoc->drv8323s, 0, 0, 0); // Stop PWM output
 284:Core/Src/foc_utils.c ****         return;
 285:Core/Src/foc_utils.c ****     }
 286:Core/Src/foc_utils.c **** 
 287:Core/Src/foc_utils.c ****     switch (hfoc->control_mode) {
 288:Core/Src/foc_utils.c ****         case TORQUE_CONTROL_MODE: {
 289:Core/Src/foc_utils.c ****             hfoc->id_ref = 0.0f;
 290:Core/Src/foc_utils.c ****             hfoc->iq_ref = SPOINT_TOR;
 291:Core/Src/foc_utils.c ****             foc_torque_control_update(hfoc);
 292:Core/Src/foc_utils.c ****             break;
 293:Core/Src/foc_utils.c ****         }
 294:Core/Src/foc_utils.c ****         case POSITION_CONTROL_MODE: {
 295:Core/Src/foc_utils.c ****             if (foc_torque_control_update(hfoc) == 1) {
 296:Core/Src/foc_utils.c ****                 hfoc->actual_angle = ENCODER_GetActualDegree(&encoder);
 297:Core/Src/foc_utils.c ****                 foc_calc_mech_pos_encoder(hfoc, hfoc->actual_angle);
 298:Core/Src/foc_utils.c ****                 foc_position_control_update(hfoc, SPOINT_POS);
 299:Core/Src/foc_utils.c ****             }
 300:Core/Src/foc_utils.c ****             break;
 301:Core/Src/foc_utils.c ****         }	
 302:Core/Src/foc_utils.c ****         case SPEED_CONTROL_MODE: {
 303:Core/Src/foc_utils.c ****             if (foc_torque_control_update(hfoc) == 1) {
 304:Core/Src/foc_utils.c ****                 foc_speed_control_update(hfoc, SPOINT_VEL);
 305:Core/Src/foc_utils.c ****             }
 306:Core/Src/foc_utils.c ****             break;
 307:Core/Src/foc_utils.c ****         }
 308:Core/Src/foc_utils.c ****         case IMPEDANCE_CONTROL_MODE: {
 309:Core/Src/foc_utils.c ****             hfoc->actual_angle = ENCODER_GetActualDegree(&encoder);
 310:Core/Src/foc_utils.c ****             foc_calc_mech_pos_encoder(hfoc, hfoc->actual_angle);
 311:Core/Src/foc_utils.c ****             foc_impedance_control(&joint_cmd, hfoc);
 312:Core/Src/foc_utils.c ****             break;
 313:Core/Src/foc_utils.c ****         }
