 526:Core/Src/foc_utils.c **** void meas_inj_dq_process(foc_t *hfoc, float ts) {
 527:Core/Src/foc_utils.c ****     const uint32_t wt = 256; // waiting time
 528:Core/Src/foc_utils.c **** 
