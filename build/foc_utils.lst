 466:Core/Src/foc_utils.c **** void foc_auto_cal_encoder_update(foc_t *hfoc) {
 467:Core/Src/foc_utils.c ****     // 1. Khai báo các biến static để lưu trạng thái giữa các vòng lặp ngắt
