 383:Core/Src/foc_utils.c **** void foc_cal_encoder(foc_t *hfoc) {
 384:Core/Src/foc_utils.c ****     memset(error_temp, 0, sizeof(error_temp));
 385:Core/Src/foc_utils.c **** 
 386:Core/Src/foc_utils.c ****     printf("Starting Encoder Calibration Task...\r\n");
 387:Core/Src/foc_utils.c ****     foc_cal_encoder_misalignment(hfoc);
 388:Core/Src/foc_utils.c **** 
 389:Core/Src/foc_utils.c ****     for (int i = 0; i < ERROR_LUT_SIZE; i++) {
 390:Core/Src/foc_utils.c ****         float mech_deg = (float)i * (360.0f / (float)ERROR_LUT_SIZE);
 391:Core/Src/foc_utils.c ****         float elec_rad = DEG_TO_RAD(mech_deg * PPAIRS);
 392:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, VQ_CAL, elec_rad);
 393:Core/Src/foc_utils.c ****         osDelay(5);
 394:Core/Src/foc_utils.c **** 
 395:Core/Src/foc_utils.c ****         float mech_rad = hfoc->m_angle_rad;
 396:Core/Src/foc_utils.c ****         float raw_delta = elec_rad - hfoc->e_angle_rad;
 397:Core/Src/foc_utils.c ****         float delta = elec_rad - hfoc->e_angle_rad_comp;
 398:Core/Src/foc_utils.c ****         
 399:Core/Src/foc_utils.c ****         raw_delta -= TWO_PI * floorf((raw_delta + PI) / TWO_PI);
 400:Core/Src/foc_utils.c ****         delta -= TWO_PI * floorf((delta + PI) / TWO_PI);
 401:Core/Src/foc_utils.c ****         
 402:Core/Src/foc_utils.c ****         float lut_pos = (mech_rad / TWO_PI) * ERROR_LUT_SIZE;
 403:Core/Src/foc_utils.c ****         int index = (int)(lut_pos);
 404:Core/Src/foc_utils.c **** 
 405:Core/Src/foc_utils.c ****         while (index < 0) {
 406:Core/Src/foc_utils.c ****         index += ERROR_LUT_SIZE;
 407:Core/Src/foc_utils.c ****         }
 408:Core/Src/foc_utils.c ****         index %= ERROR_LUT_SIZE;
 409:Core/Src/foc_utils.c **** 
 410:Core/Src/foc_utils.c ****         error_temp[index] = raw_delta;
 411:Core/Src/foc_utils.c ****     
 412:Core/Src/foc_utils.c **** 
 413:Core/Src/foc_utils.c ****     }
 414:Core/Src/foc_utils.c ****     
 415:Core/Src/foc_utils.c ****     for (int i = 0; i < ERROR_LUT_SIZE; i++) {
ARM GAS  /tmp/cc8Invf0.s 			page 38


 416:Core/Src/foc_utils.c ****         if (error_temp[i] == 0) {
 417:Core/Src/foc_utils.c ****         int last_i = i - 1;
 418:Core/Src/foc_utils.c ****         int next_i = i + 1;
 419:Core/Src/foc_utils.c ****         if (last_i < 0) last_i += ERROR_LUT_SIZE;
 420:Core/Src/foc_utils.c ****         if (next_i > ERROR_LUT_SIZE) next_i -= ERROR_LUT_SIZE;
 421:Core/Src/foc_utils.c ****         error_temp[i] = (error_temp[last_i] + error_temp[next_i]) / 2.0f;
 422:Core/Src/foc_utils.c ****         }
 423:Core/Src/foc_utils.c ****     }
 424:Core/Src/foc_utils.c **** 
 425:Core/Src/foc_utils.c ****     memcpy(m_config.encd_error_comp, error_temp, sizeof(error_temp));
