 539:Core/Src/foc_utils.c **** void meas_inj_dq_process(foc_t *hfoc, float ts) {
 540:Core/Src/foc_utils.c ****     const uint32_t wt = 256; // waiting time
 541:Core/Src/foc_utils.c **** 
 542:Core/Src/foc_utils.c ****     if (hfoc->meas_inj_start_flag) {
