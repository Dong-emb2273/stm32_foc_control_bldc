 262:Core/Src/foc_utils.c ****     foc_torque_control_update(hfoc);
 263:Core/Src/foc_utils.c **** }
 264:Core/Src/foc_utils.c **** //
 265:Core/Src/foc_utils.c **** void foc_control_loop(foc_t *hfoc) {
 266:Core/Src/foc_utils.c ****     if (hfoc == NULL) return;
 267:Core/Src/foc_utils.c ****         
 268:Core/Src/foc_utils.c ****     if (RF_POWER) {
 269:Core/Src/foc_utils.c ****         // printf("Power voltage is too low: %.2f V\r\n", hfoc->v_bus);
 270:Core/Src/foc_utils.c ****         return;
 271:Core/Src/foc_utils.c ****     }
 272:Core/Src/foc_utils.c ****     if (encoder.is_connected == 0) {
 273:Core/Src/foc_utils.c ****         DRV8323_Set_PWM(&hfoc->drv8323s, 0, 0, 0); // Stop PWM output
 274:Core/Src/foc_utils.c ****         return;
 275:Core/Src/foc_utils.c ****     }
 276:Core/Src/foc_utils.c **** 
 277:Core/Src/foc_utils.c ****     switch (hfoc->control_mode) {
 278:Core/Src/foc_utils.c ****         case TORQUE_CONTROL_MODE: {
 279:Core/Src/foc_utils.c ****             hfoc->id_ref = 0.0f;
 280:Core/Src/foc_utils.c ****             hfoc->iq_ref = SPOINT_TOR;
 281:Core/Src/foc_utils.c ****             foc_torque_control_update(hfoc);
 282:Core/Src/foc_utils.c ****             break;
 283:Core/Src/foc_utils.c ****         }
 284:Core/Src/foc_utils.c ****         case POSITION_CONTROL_MODE: {
 285:Core/Src/foc_utils.c ****             if (foc_torque_control_update(hfoc) == 1) {
 286:Core/Src/foc_utils.c ****                 hfoc->actual_angle = ENCODER_GetActualDegree(&encoder);
 287:Core/Src/foc_utils.c ****                 foc_calc_mech_pos_encoder(hfoc, hfoc->actual_angle);
 288:Core/Src/foc_utils.c ****                 foc_position_control_update(hfoc, SPOINT_POS);
 289:Core/Src/foc_utils.c ****             }
 290:Core/Src/foc_utils.c ****             break;
 291:Core/Src/foc_utils.c ****         }	
 292:Core/Src/foc_utils.c ****         case SPEED_CONTROL_MODE: {
 293:Core/Src/foc_utils.c ****             if (foc_torque_control_update(hfoc) == 1) {
 294:Core/Src/foc_utils.c ****                 foc_speed_control_update(hfoc, SPOINT_VEL);
 295:Core/Src/foc_utils.c ****             }
 296:Core/Src/foc_utils.c ****             break;
 297:Core/Src/foc_utils.c ****         }
 298:Core/Src/foc_utils.c ****         case IMPEDANCE_CONTROL_MODE: {
 299:Core/Src/foc_utils.c ****             hfoc->actual_angle = ENCODER_GetActualDegree(&encoder);
 300:Core/Src/foc_utils.c ****             foc_calc_mech_pos_encoder(hfoc, hfoc->actual_angle);
 301:Core/Src/foc_utils.c ****             foc_impedance_control(&joint_cmd, hfoc);
 302:Core/Src/foc_utils.c ****             break;
 303:Core/Src/foc_utils.c ****         }
 304:Core/Src/foc_utils.c ****         default:
 305:Core/Src/foc_utils.c ****                     
 306:Core/Src/foc_utils.c ****             break;
 307:Core/Src/foc_utils.c ****                 
 308:Core/Src/foc_utils.c ****     }
 309:Core/Src/foc_utils.c **** }
