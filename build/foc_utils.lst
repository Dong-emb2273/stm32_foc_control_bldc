 463:Core/Src/foc_utils.c **** void foc_auto_calibration(foc_t *hfoc) {
 464:Core/Src/foc_utils.c ****     printf("Starting Pole Pairs And Order Phase...\r\n");
 465:Core/Src/foc_utils.c **** 
 466:Core/Src/foc_utils.c ****     const float SWEEP_CYCLES = 20.0f; 
 467:Core/Src/foc_utils.c ****     const float W_CAL = TWO_PI / 0.2f; 
 468:Core/Src/foc_utils.c ****     const float SWEEP_TIME_SEC = (SWEEP_CYCLES * TWO_PI) / W_CAL; 
 469:Core/Src/foc_utils.c ****     const uint32_t step_delay_ms = 5; 
 470:Core/Src/foc_utils.c ****     const uint32_t total_steps = (uint32_t)(SWEEP_TIME_SEC * 1000.0f / step_delay_ms);
 471:Core/Src/foc_utils.c **** 
