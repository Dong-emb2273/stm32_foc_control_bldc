 297:Core/Src/foc_utils.c **** 
 298:Core/Src/foc_utils.c **** cal_state_t current_cal_state = CAL_IDLE;
 299:Core/Src/foc_utils.c **** uint32_t cal_start_time = 0;
 300:Core/Src/foc_utils.c **** float theta_start = 0.0f;
 301:Core/Src/foc_utils.c **** 
 302:Core/Src/foc_utils.c **** // Hàm này gọi định kỳ trong ngắt (ví dụ ADC_IRQHandler)
 303:Core/Src/foc_utils.c **** void foc_auto_calibration_update(foc_t *hfoc) {
 304:Core/Src/foc_utils.c ****     if (current_cal_state == CAL_IDLE || current_cal_state == CAL_DONE) return;
 305:Core/Src/foc_utils.c **** 	
 306:Core/Src/foc_utils.c ****     uint32_t current_time = HAL_GetTick(); // Hoặc dùng get_dt_us()
 307:Core/Src/foc_utils.c ****     float elapsed_sec = (current_time - cal_start_time) / 1000.0f;
 308:Core/Src/foc_utils.c **** 
 309:Core/Src/foc_utils.c ****     const float T1 = 1.0f; // 1 giây để khóa rotor
 310:Core/Src/foc_utils.c ****     const float W_CAL = TWO_PI / 2.0f; // Vận tốc quét (hoàn thành 2PI trong 2s)
 311:Core/Src/foc_utils.c **** 
 312:Core/Src/foc_utils.c ****     if (elapsed_sec < T1) {
 313:Core/Src/foc_utils.c ****         // Giai đoạn 1: Khóa Rotor
 314:Core/Src/foc_utils.c ****         current_cal_state = CAL_ALIGNING;
 315:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, 0.0f, 0.0f);
 316:Core/Src/foc_utils.c ****         theta_start = ENCODER_GetDegree(&encoder);
 317:Core/Src/foc_utils.c ****     } 
 318:Core/Src/foc_utils.c ****     else if (elapsed_sec < T1 + (TWO_PI / W_CAL)) {
 319:Core/Src/foc_utils.c ****         // Giai đoạn 2: Quét 1 vòng điện (Không dùng HAL_Delay)
 320:Core/Src/foc_utils.c ****         current_cal_state = CAL_SWEEPING;
 321:Core/Src/foc_utils.c ****         float elec_angle = W_CAL * (elapsed_sec - T1);
 322:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, 0.0f, elec_angle);
 323:Core/Src/foc_utils.c ****     } 
 324:Core/Src/foc_utils.c ****     else {
 325:Core/Src/foc_utils.c ****         // Giai đoạn 3: Kết thúc và tính toán
 326:Core/Src/foc_utils.c ****         float theta_end = ENCODER_GetDegree(&encoder);
 327:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, 0.0f, 0.0f, 0.0f);
 328:Core/Src/foc_utils.c ****         
 329:Core/Src/foc_utils.c ****         float delta_mech = theta_end - theta_start;
 330:Core/Src/foc_utils.c ****         
 331:Core/Src/foc_utils.c ****         if (delta_mech > 180.0f) {
 332:Core/Src/foc_utils.c ****             delta_mech -= 360.0f;
 333:Core/Src/foc_utils.c ****         } else if (delta_mech < -180.0f) {
 334:Core/Src/foc_utils.c ****             delta_mech += 360.0f;
 335:Core/Src/foc_utils.c ****         }
 336:Core/Src/foc_utils.c **** 
 337:Core/Src/foc_utils.c ****         // 2. Tính số cặp cực (dựa trên độ lớn)
 338:Core/Src/foc_utils.c ****         if (fabs(delta_mech) > 0.1f) {
 339:Core/Src/foc_utils.c ****             hfoc->pole_pairs = round(360.0f / fabs(delta_mech));
 340:Core/Src/foc_utils.c ****             printf("Pole Pairs: %d\r\n", hfoc->pole_pairs);
ARM GAS  /tmp/ccgbQbGQ.s 			page 24


 341:Core/Src/foc_utils.c ****         }
 342:Core/Src/foc_utils.c **** 
 343:Core/Src/foc_utils.c ****         // 3. Xác định chiều quay (dựa trên dấu của delta)
 344:Core/Src/foc_utils.c ****         // Nếu quét điện áp tiến (thuận) mà góc cơ học tiến (delta > 0) -> Cùng 
 345:Core/Src/foc_utils.c ****         if (delta_mech > 0) {
 346:Core/Src/foc_utils.c ****             hfoc->sensor_dir = REVERSE_DIR;
 347:Core/Src/foc_utils.c ****             printf("Phase order & Sensor match (NORMAL)\r\n");
 348:Core/Src/foc_utils.c ****         } else {
 349:Core/Src/foc_utils.c ****             hfoc->sensor_dir = NORMAL_DIR;
 350:Core/Src/foc_utils.c ****             printf("Phase order & Sensor mismatched! Swapping (REVERSE)\r\n");
 351:Core/Src/foc_utils.c ****         }
 352:Core/Src/foc_utils.c ****         current_cal_state = CAL_DONE; // Hoàn thành
 353:Core/Src/foc_utils.c ****     }
 354:Core/Src/foc_utils.c **** }
