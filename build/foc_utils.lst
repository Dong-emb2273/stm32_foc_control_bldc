 459:Core/Src/foc_utils.c **** void foc_auto_calibration(foc_t *hfoc) {
 460:Core/Src/foc_utils.c ****     printf("Starting Pole Pairs And Order Phase...\r\n");
 461:Core/Src/foc_utils.c **** 
 462:Core/Src/foc_utils.c ****     const float SWEEP_CYCLES = 20.0f; 
 463:Core/Src/foc_utils.c ****     const float W_CAL = TWO_PI / 0.2f; 
 464:Core/Src/foc_utils.c ****     const float SWEEP_TIME_SEC = (SWEEP_CYCLES * TWO_PI) / W_CAL; 
ARM GAS  /tmp/ccPRuC7G.s 			page 41


 465:Core/Src/foc_utils.c ****     const uint32_t step_delay_ms = 5; 
 466:Core/Src/foc_utils.c ****     const uint32_t total_steps = (uint32_t)(SWEEP_TIME_SEC * 1000.0f / step_delay_ms);
 467:Core/Src/foc_utils.c **** 
 468:Core/Src/foc_utils.c ****     // ==========================================
 469:Core/Src/foc_utils.c ****    for(int i = 0; i < 50; i++) {
 470:Core/Src/foc_utils.c ****         ENCODER_GetActualDegree(&encoder);
 471:Core/Src/foc_utils.c ****         osDelay(1); 
 472:Core/Src/foc_utils.c ****     }
 473:Core/Src/foc_utils.c **** 
 474:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, VD_CAL, 0.0f, 0.0f);
 475:Core/Src/foc_utils.c **** 
 476:Core/Src/foc_utils.c ****     osDelay(1000); 
 477:Core/Src/foc_utils.c ****     
 478:Core/Src/foc_utils.c ****     // ==========================================
 479:Core/Src/foc_utils.c ****     encoder.output_angle_ovf = 0;
 480:Core/Src/foc_utils.c ****     encoder.output_prev_angle = encoder.angle_filtered; // Góc thô sau khi lọc nội bộ
 481:Core/Src/foc_utils.c ****     encoder.output_angle_filtered = encoder.angle_filtered; // Ép biến actual nhảy thẳng đ�
 482:Core/Src/foc_utils.c **** 
 483:Core/Src/foc_utils.c **** 
 484:Core/Src/foc_utils.c ****     float actual_theta_start = ENCODER_GetActualDegree(&encoder);
 485:Core/Src/foc_utils.c ****     
 486:Core/Src/foc_utils.c ****     // printf("Starting angle: %f degrees\r\n", actual_theta_start);
 487:Core/Src/foc_utils.c ****     // printf("Starting angle: %f degrees\r\n", M_ZERO);
 488:Core/Src/foc_utils.c **** 
 489:Core/Src/foc_utils.c ****     for (uint32_t i = 0; i < total_steps; i++) {
 490:Core/Src/foc_utils.c ****         float elapsed_sec = (float)i * step_delay_ms / 1000.0f; 
 491:Core/Src/foc_utils.c ****         float elec_angle = W_CAL * elapsed_sec;
 492:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, 0.0f, elec_angle);
 493:Core/Src/foc_utils.c ****         ENCODER_GetActualDegree(&encoder); 
 494:Core/Src/foc_utils.c ****         osDelay(step_delay_ms); 
 495:Core/Src/foc_utils.c ****     }
 496:Core/Src/foc_utils.c **** 
 497:Core/Src/foc_utils.c ****   
 498:Core/Src/foc_utils.c ****     float actual_theta_end = ENCODER_GetActualDegree(&encoder);
 499:Core/Src/foc_utils.c ****     
 500:Core/Src/foc_utils.c ****     // printf("Ending angle: %f degrees\r\n", actual_theta_end);
 501:Core/Src/foc_utils.c **** 
 502:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, 0.0f, 0.0f, 0.0f); 
 503:Core/Src/foc_utils.c ****     
 504:Core/Src/foc_utils.c **** 
 505:Core/Src/foc_utils.c ****     float delta_mech = actual_theta_end - actual_theta_start;
 506:Core/Src/foc_utils.c ****     
 507:Core/Src/foc_utils.c ****     if (fabs(delta_mech) > 0.1f) {
 508:Core/Src/foc_utils.c ****         PPAIRS = round((SWEEP_CYCLES * 360.0f) / fabs(delta_mech));
 509:Core/Src/foc_utils.c ****         printf("Pole Pairs: %d\r\n", PPAIRS);
 510:Core/Src/foc_utils.c ****     }
 511:Core/Src/foc_utils.c ****     
 512:Core/Src/foc_utils.c ****    
 513:Core/Src/foc_utils.c ****     if (delta_mech > 0) {
 514:Core/Src/foc_utils.c ****         DIR_PHASE = NORMAL_DIR;
 515:Core/Src/foc_utils.c ****         printf("Phase order & Sensor match (NORMAL)\r\n");
 516:Core/Src/foc_utils.c ****     } else {
 517:Core/Src/foc_utils.c ****         DIR_PHASE = REVERSE_DIR;
 518:Core/Src/foc_utils.c ****         printf("Phase order & Sensor mismatched! Swapping (REVERSE)\r\n");
 519:Core/Src/foc_utils.c ****     }
