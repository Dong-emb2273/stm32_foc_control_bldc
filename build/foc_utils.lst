 526:Core/Src/foc_utils.c **** void meas_inj_dq_process(foc_t *hfoc, float ts) {
 527:Core/Src/foc_utils.c ****     const uint32_t wt = 256; // waiting time
 528:Core/Src/foc_utils.c **** 
 529:Core/Src/foc_utils.c ****     if (hfoc->meas_inj_start_flag) {
 530:Core/Src/foc_utils.c ****         float vd = 0.0f, vq = 0.0f;
 531:Core/Src/foc_utils.c ****         if (hfoc->meas_inj_target == RS) {
 532:Core/Src/foc_utils.c ****             vd = hfoc->meas_inj_amp;
 533:Core/Src/foc_utils.c ****             vq = 0.0f;
 534:Core/Src/foc_utils.c ****         }
 535:Core/Src/foc_utils.c ****         else {
 536:Core/Src/foc_utils.c ****             float angle = hfoc->meas_inj_omega * hfoc->meas_inj_n * ts;
 537:Core/Src/foc_utils.c ****             float v_inj = hfoc->meas_inj_amp * fast_sin(angle);
 538:Core/Src/foc_utils.c ****             if (hfoc->meas_inj_target == LD) {
 539:Core/Src/foc_utils.c ****                 vd = v_inj;
 540:Core/Src/foc_utils.c ****                 vq = 0.0f;
 541:Core/Src/foc_utils.c ****             }
 542:Core/Src/foc_utils.c ****             else if (hfoc->meas_inj_target == LQ) {
 543:Core/Src/foc_utils.c ****                 vd = 0.0f;
