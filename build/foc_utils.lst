 568:Core/Src/foc_utils.c ****             }
 569:Core/Src/foc_utils.c ****         }
 570:Core/Src/foc_utils.c **** 
 571:Core/Src/foc_utils.c ****         hfoc->meas_inj_n++;
 572:Core/Src/foc_utils.c ****         if (hfoc->meas_inj_n >= (MAX_I_SAMPLE + wt)) {
 573:Core/Src/foc_utils.c ****             hfoc->meas_inj_n = 0;
 574:Core/Src/foc_utils.c ****             hfoc->meas_inj_start_flag = 0;
