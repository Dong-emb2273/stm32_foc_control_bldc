 415:Core/Src/foc_utils.c **** void foc_cal_encoder(foc_t *hfoc) {
 416:Core/Src/foc_utils.c ****     memset(error_temp, 0, sizeof(error_temp));
 417:Core/Src/foc_utils.c **** 
 418:Core/Src/foc_utils.c ****     printf("Starting Encoder Calibration Task...\r\n");
 419:Core/Src/foc_utils.c ****     foc_cal_encoder_misalignment(hfoc);
 420:Core/Src/foc_utils.c **** 
 421:Core/Src/foc_utils.c ****     for (int i = 0; i < ERROR_LUT_SIZE; i++) {
 422:Core/Src/foc_utils.c ****         float mech_deg = (float)i * (360.0f / (float)ERROR_LUT_SIZE);
 423:Core/Src/foc_utils.c ****         float elec_rad = DEG_TO_RAD(mech_deg * PPAIRS);
 424:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, VD_CAL, VQ_CAL, elec_rad);
 425:Core/Src/foc_utils.c ****         osDelay(5);
 426:Core/Src/foc_utils.c **** 
 427:Core/Src/foc_utils.c ****         float mech_rad = hfoc->m_angle_rad;
 428:Core/Src/foc_utils.c ****         float raw_delta = elec_rad - hfoc->e_angle_rad;
 429:Core/Src/foc_utils.c ****         float delta = elec_rad - hfoc->e_angle_rad_comp;
 430:Core/Src/foc_utils.c ****         
 431:Core/Src/foc_utils.c ****         raw_delta -= TWO_PI * floorf((raw_delta + PI) / TWO_PI);
 432:Core/Src/foc_utils.c ****         delta -= TWO_PI * floorf((delta + PI) / TWO_PI);
 433:Core/Src/foc_utils.c ****         
 434:Core/Src/foc_utils.c ****         float lut_pos = (mech_rad / TWO_PI) * ERROR_LUT_SIZE;
 435:Core/Src/foc_utils.c ****         int index = (int)(lut_pos);
 436:Core/Src/foc_utils.c **** 
ARM GAS  /tmp/ccJlR9LD.s 			page 41


 437:Core/Src/foc_utils.c ****         while (index < 0) {
 438:Core/Src/foc_utils.c ****         index += ERROR_LUT_SIZE;
 439:Core/Src/foc_utils.c ****         }
 440:Core/Src/foc_utils.c ****         index %= ERROR_LUT_SIZE;
 441:Core/Src/foc_utils.c **** 
 442:Core/Src/foc_utils.c ****         error_temp[index] = raw_delta;
 443:Core/Src/foc_utils.c ****     
 444:Core/Src/foc_utils.c **** 
 445:Core/Src/foc_utils.c ****     }
 446:Core/Src/foc_utils.c ****     
 447:Core/Src/foc_utils.c ****     for (int i = 0; i < ERROR_LUT_SIZE; i++) {
 448:Core/Src/foc_utils.c ****         if (error_temp[i] == 0) {
 449:Core/Src/foc_utils.c ****         int last_i = i - 1;
 450:Core/Src/foc_utils.c ****         int next_i = i + 1;
 451:Core/Src/foc_utils.c ****         if (last_i < 0) last_i += ERROR_LUT_SIZE;
 452:Core/Src/foc_utils.c ****         if (next_i > ERROR_LUT_SIZE) next_i -= ERROR_LUT_SIZE;
 453:Core/Src/foc_utils.c ****         error_temp[i] = (error_temp[last_i] + error_temp[next_i]) / 2.0f;
 454:Core/Src/foc_utils.c ****         }
 455:Core/Src/foc_utils.c ****     }
 456:Core/Src/foc_utils.c **** 
 457:Core/Src/foc_utils.c ****     memcpy(m_config.encd_error_comp, error_temp, sizeof(error_temp));
 458:Core/Src/foc_utils.c **** 
 459:Core/Src/foc_utils.c ****     open_loop_voltage_control(hfoc, 0.0f, 0.0f, 0.0f);
 460:Core/Src/foc_utils.c **** 
 461:Core/Src/foc_utils.c ****     hfoc->done_cal_encoder = 1;
 462:Core/Src/foc_utils.c **** }
