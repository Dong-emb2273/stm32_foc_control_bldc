 481:Core/Src/foc_utils.c ****     
 482:Core/Src/foc_utils.c ****     // ==========================================
 483:Core/Src/foc_utils.c ****     encoder.output_angle_ovf = 0;
 484:Core/Src/foc_utils.c ****     encoder.output_prev_angle = encoder.angle_filtered; // Góc thô sau khi lọc nội bộ
 485:Core/Src/foc_utils.c ****     encoder.output_angle_filtered = encoder.angle_filtered; // Ép biến actual nhảy thẳng đ�
 486:Core/Src/foc_utils.c **** 
 487:Core/Src/foc_utils.c **** 
 488:Core/Src/foc_utils.c ****     float actual_theta_start = ENCODER_GetActualDegree(&encoder);
 489:Core/Src/foc_utils.c ****     
 490:Core/Src/foc_utils.c ****     // printf("Starting angle: %f degrees\r\n", actual_theta_start);
 491:Core/Src/foc_utils.c ****     // printf("Starting angle: %f degrees\r\n", M_ZERO);
 492:Core/Src/foc_utils.c **** 
 493:Core/Src/foc_utils.c ****     for (uint32_t i = 0; i < total_steps; i++) {
