 520:Core/Src/foc_utils.c **** void meas_inj_dq_process(foc_t *hfoc, float ts) {
 521:Core/Src/foc_utils.c ****     const uint32_t wt = 256; // waiting time
 522:Core/Src/foc_utils.c **** 
 523:Core/Src/foc_utils.c ****     if (hfoc->meas_inj_start_flag) {
 524:Core/Src/foc_utils.c ****         float vd = 0.0f, vq = 0.0f;
 525:Core/Src/foc_utils.c ****         if (hfoc->meas_inj_target == RS) {
 526:Core/Src/foc_utils.c ****             vd = hfoc->meas_inj_amp;
 527:Core/Src/foc_utils.c ****             vq = 0.0f;
 528:Core/Src/foc_utils.c ****         }
 529:Core/Src/foc_utils.c ****         else {
 530:Core/Src/foc_utils.c ****             float angle = hfoc->meas_inj_omega * hfoc->meas_inj_n * ts;
 531:Core/Src/foc_utils.c ****             float v_inj = hfoc->meas_inj_amp * fast_sin(angle);
 532:Core/Src/foc_utils.c ****             if (hfoc->meas_inj_target == LD) {
 533:Core/Src/foc_utils.c ****                 vd = v_inj;
 534:Core/Src/foc_utils.c ****                 vq = 0.0f;
 535:Core/Src/foc_utils.c ****             }
 536:Core/Src/foc_utils.c ****             else if (hfoc->meas_inj_target == LQ) {
 537:Core/Src/foc_utils.c ****                 vd = 0.0f;
 538:Core/Src/foc_utils.c ****                 vq = v_inj;
 539:Core/Src/foc_utils.c ****             }
 540:Core/Src/foc_utils.c ****         }
 541:Core/Src/foc_utils.c **** 
 542:Core/Src/foc_utils.c ****         // float theta_e = hfoc->e_angle_rad_comp;
 543:Core/Src/foc_utils.c ****         float theta_e = 0.0f;
 544:Core/Src/foc_utils.c **** 
 545:Core/Src/foc_utils.c ****         open_loop_voltage_control(hfoc, vd, vq, theta_e);
 546:Core/Src/foc_utils.c **** 
 547:Core/Src/foc_utils.c ****         DRV8323_Get_Current(&hfoc->drv8323s, &hfoc->ia, &hfoc->ib, &hfoc->ic);
 548:Core/Src/foc_utils.c **** 
 549:Core/Src/foc_utils.c ****         float sin_theta, cos_theta;
 550:Core/Src/foc_utils.c ****         float id, iq;
 551:Core/Src/foc_utils.c ****         pre_calc_sin_cos(theta_e, &sin_theta, &cos_theta);
 552:Core/Src/foc_utils.c ****         clarke_park_transform(hfoc->ia, hfoc->ib, sin_theta, cos_theta, &id, &iq);
 553:Core/Src/foc_utils.c **** 
 554:Core/Src/foc_utils.c ****         if (hfoc->meas_inj_n >= wt) {
 555:Core/Src/foc_utils.c ****             if (hfoc->meas_inj_target == RS || hfoc->meas_inj_target == LD) {
 556:Core/Src/foc_utils.c ****                 Vd_buff[hfoc->meas_inj_n - wt] = vd;
ARM GAS  /tmp/ccO68Utc.s 			page 43


 557:Core/Src/foc_utils.c ****                 Id_buff[hfoc->meas_inj_n - wt] = id;
 558:Core/Src/foc_utils.c ****             }
 559:Core/Src/foc_utils.c ****             else if (hfoc->meas_inj_target == LQ) {
 560:Core/Src/foc_utils.c ****                 Vq_buff[hfoc->meas_inj_n - wt] = vq;
 561:Core/Src/foc_utils.c ****                 Iq_buff[hfoc->meas_inj_n - wt] = iq;
 562:Core/Src/foc_utils.c ****             }
 563:Core/Src/foc_utils.c ****         }
 564:Core/Src/foc_utils.c **** 
 565:Core/Src/foc_utils.c ****         hfoc->meas_inj_n++;
 566:Core/Src/foc_utils.c ****         if (hfoc->meas_inj_n >= (MAX_I_SAMPLE + wt)) {
 567:Core/Src/foc_utils.c ****             hfoc->meas_inj_n = 0;
 568:Core/Src/foc_utils.c ****             hfoc->meas_inj_start_flag = 0;
 569:Core/Src/foc_utils.c ****             open_loop_voltage_control(hfoc, 0, 0, 0);
 570:Core/Src/foc_utils.c ****         }
 571:Core/Src/foc_utils.c ****     }
