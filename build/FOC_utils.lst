  61:Lib/FOC/FOC_utils.c ****     pid_reset(&hfoc->pos_ctrl);
  62:Lib/FOC/FOC_utils.c ****     pid_reset(&hfoc->fw_ctrl);
  63:Lib/FOC/FOC_utils.c ****     if (hfoc->foc_mode != FOC_MODE_SENSORED) {
  64:Lib/FOC/FOC_utils.c ****         if (hfoc->foc_mode == FOC_MODE_SENSORLESS_SMO_HFI_NEW) {
  65:Lib/FOC/FOC_utils.c ****             hfi_reset(&hfoc->hfi);
  66:Lib/FOC/FOC_utils.c ****         }
  67:Lib/FOC/FOC_utils.c ****         else if (hfoc->foc_mode == FOC_MODE_SENSORLESS_SMO_HFI) {
  68:Lib/FOC/FOC_utils.c ****             hfi_lpf_reset(&hfoc->hfi_lpf);
  69:Lib/FOC/FOC_utils.c ****         } 
  70:Lib/FOC/FOC_utils.c **** 
  71:Lib/FOC/FOC_utils.c ****         hfoc->pd_time = 20;
  72:Lib/FOC/FOC_utils.c ****         hfoc->pd_v_pulse = 0.0f;
  73:Lib/FOC/FOC_utils.c ****         hfoc->pd_state = P_DET_START;
  74:Lib/FOC/FOC_utils.c ****     }
  75:Lib/FOC/FOC_utils.c ****     switch(hfoc->motor_mode) {
  76:Lib/FOC/FOC_utils.c ****         case MOTOR_MODE_TORQUE_CONTROL: {
  77:Lib/FOC/FOC_utils.c ****             foc_set_current_set_point(hfoc, 0);
  78:Lib/FOC/FOC_utils.c ****             break;
  79:Lib/FOC/FOC_utils.c ****         }
  80:Lib/FOC/FOC_utils.c ****         case MOTOR_MODE_SPEED_CONTROL: {
  81:Lib/FOC/FOC_utils.c ****             foc_set_speed_set_point(hfoc, 0);
  82:Lib/FOC/FOC_utils.c ****             break;
  83:Lib/FOC/FOC_utils.c ****         }
  84:Lib/FOC/FOC_utils.c ****         case MOTOR_MODE_POSITION_CONTROL: {
