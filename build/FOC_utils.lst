 108:Lib/FOC/FOC_utils.c ****         float error = hfoc->rpm_ref - hfoc->actual_rpm;
 109:Lib/FOC/FOC_utils.c ****         hfoc->Is_ref = pi_control(&hfoc->speed_ctrl, error);
 110:Lib/FOC/FOC_utils.c ****     }
