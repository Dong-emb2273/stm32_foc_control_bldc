  55:Lib/FOC/FOC_utils.c **** void foc_reset(foc_t *hfoc) {
  56:Lib/FOC/FOC_utils.c ****     s_curve_reset(&hfoc->trajectory, hfoc->actual_angle);
  57:Lib/FOC/FOC_utils.c ****     hfoc->pos_ref = hfoc->actual_angle;
  58:Lib/FOC/FOC_utils.c ****     pid_reset(&hfoc->id_ctrl);
  59:Lib/FOC/FOC_utils.c ****     pid_reset(&hfoc->iq_ctrl);
