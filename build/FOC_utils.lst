 589:Lib/FOC/FOC_utils.c **** __attribute__((section(".ramfunc"), noinline))
 590:Lib/FOC/FOC_utils.c **** void foc_update(foc_t *hfoc, float Ts) {
 591:Lib/FOC/FOC_utils.c ****     foc_sensored_calc_electric_angle(hfoc);
 592:Lib/FOC/FOC_utils.c ****     foc_get_mech_degree(hfoc);
 593:Lib/FOC/FOC_utils.c ****     // foc start delay
 594:Lib/FOC/FOC_utils.c ****     if (!hfoc->start_foc) {
 595:Lib/FOC/FOC_utils.c ****         hfoc->init_tick++;
 596:Lib/FOC/FOC_utils.c ****         if (hfoc->init_tick > (uint32_t)(0.5f / Ts)) {
 597:Lib/FOC/FOC_utils.c ****             hfoc->start_foc = 1;
 598:Lib/FOC/FOC_utils.c ****             foc_reset(hfoc);
 599:Lib/FOC/FOC_utils.c ****         }
 600:Lib/FOC/FOC_utils.c ****         return;
 601:Lib/FOC/FOC_utils.c ****     }
 602:Lib/FOC/FOC_utils.c ****     // voltage protection
 603:Lib/FOC/FOC_utils.c ****     if (vbus_update(&hfoc->vbus_prot, hfoc->v_bus)) {
 604:Lib/FOC/FOC_utils.c ****         uint8_t vbus_fault = vbus_get_fault(&hfoc->vbus_prot);
 605:Lib/FOC/FOC_utils.c ****         if (vbus_fault != VBUS_FAULT_NONE) {
 606:Lib/FOC/FOC_utils.c ****             foc_disable(hfoc);
 607:Lib/FOC/FOC_utils.c ****             if (vbus_fault & VBUS_FAULT_UV) {
ARM GAS  /tmp/ccHqBJHk.s 			page 48


 608:Lib/FOC/FOC_utils.c ****                 hfoc->error_flag = FOC_ERROR_UNDER_VOLTAGE;
 609:Lib/FOC/FOC_utils.c ****             }
 610:Lib/FOC/FOC_utils.c ****             else if (vbus_fault & VBUS_FAULT_OV) {
 611:Lib/FOC/FOC_utils.c ****                 hfoc->error_flag = FOC_ERROR_OVER_VOLTAGE;
 612:Lib/FOC/FOC_utils.c ****             }
 613:Lib/FOC/FOC_utils.c ****             return;
 614:Lib/FOC/FOC_utils.c ****         }
 615:Lib/FOC/FOC_utils.c ****         else {
 616:Lib/FOC/FOC_utils.c ****             foc_enable(hfoc);
 617:Lib/FOC/FOC_utils.c ****         }
 618:Lib/FOC/FOC_utils.c ****     }
 619:Lib/FOC/FOC_utils.c ****     foc_trajectory_update(hfoc, Ts);
 620:Lib/FOC/FOC_utils.c ****     switch (hfoc->motor_mode) {
 621:Lib/FOC/FOC_utils.c ****         case MOTOR_MODE_TORQUE_CONTROL: {
 622:Lib/FOC/FOC_utils.c ****             foc_current_control_update(hfoc, Ts);
 623:Lib/FOC/FOC_utils.c ****             break;
 624:Lib/FOC/FOC_utils.c ****         }
 625:Lib/FOC/FOC_utils.c ****         case MOTOR_MODE_VOLTAGE_CONTROL: {
 626:Lib/FOC/FOC_utils.c ****             foc_voltage_control_update(hfoc);
 627:Lib/FOC/FOC_utils.c ****             break;
 628:Lib/FOC/FOC_utils.c ****         }
 629:Lib/FOC/FOC_utils.c ****         case MOTOR_MODE_SPEED_CONTROL: {
 630:Lib/FOC/FOC_utils.c ****             foc_speed_control_update(hfoc, Ts);
 631:Lib/FOC/FOC_utils.c ****             break;
 632:Lib/FOC/FOC_utils.c ****         }
 633:Lib/FOC/FOC_utils.c ****         case MOTOR_MODE_POSITION_CONTROL: {
 634:Lib/FOC/FOC_utils.c ****             foc_position_control_update(hfoc, Ts);
 635:Lib/FOC/FOC_utils.c ****             break;
 636:Lib/FOC/FOC_utils.c ****         }
 637:Lib/FOC/FOC_utils.c ****         case MOTOR_MODE_IMPEDANCE_CONTROL: {
 638:Lib/FOC/FOC_utils.c ****             foc_impedance_control_update(hfoc, Ts);
 639:Lib/FOC/FOC_utils.c ****             break;
 640:Lib/FOC/FOC_utils.c ****         }
 641:Lib/FOC/FOC_utils.c ****         default:
 642:Lib/FOC/FOC_utils.c ****             break;
 643:Lib/FOC/FOC_utils.c ****     }
 644:Lib/FOC/FOC_utils.c **** }
