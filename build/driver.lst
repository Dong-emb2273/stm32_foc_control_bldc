 408:Lib/Driver/driver.c **** 
 409:Lib/Driver/driver.c **** void ADC_DMA_CONFIG(void) {
 410:Lib/Driver/driver.c **** 	// 1. Bật Clock cho cả 3 ADC
 411:Lib/Driver/driver.c **** 	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
 412:Lib/Driver/driver.c **** 	RCC->APB2ENR |= RCC_APB2ENR_ADC1EN | RCC_APB2ENR_ADC2EN | RCC_APB2ENR_ADC3EN;
 413:Lib/Driver/driver.c **** 
 414:Lib/Driver/driver.c **** 	// 2. Cấu hình GPIO (PA0, PA1, PA2) -> Analog
 415:Lib/Driver/driver.c **** 	GPIOA->MODER |= 0x3FFF; 
 416:Lib/Driver/driver.c **** 	GPIOA->PUPDR &= ~0x3FFF;
 417:Lib/Driver/driver.c **** 
 418:Lib/Driver/driver.c **** 	// 3. Cấu hình chung cho khối ADC (ADC_CCR)
 419:Lib/Driver/driver.c **** 	// ADCPRE = 01 (Chia 4 -> 21MHz)
 420:Lib/Driver/driver.c **** 	// MULTI = 10101 (Triple Injected simultaneous mode only) - Xem RM0090 Table 62
 421:Lib/Driver/driver.c **** 	// DMA = 0 (Không cần DMA cho Injected)
 422:Lib/Driver/driver.c **** 	ADC->CCR = (1 << ADC_CCR_ADCPRE_Pos) | 
 423:Lib/Driver/driver.c **** 						 (0x15 << ADC_CCR_MULTI_Pos); 
 424:Lib/Driver/driver.c **** 
 425:Lib/Driver/driver.c **** 	// --- CẤU HÌNH ADC1 (Master - Pha A) ---
 426:Lib/Driver/driver.c **** 	ADC1->CR1 = ADC_CR1_SCAN | ADC_CR1_JEOCIE; // Bật ngắt JEOC ở Master
 427:Lib/Driver/driver.c **** 	ADC1->CR2 = 0; // Trigger cài bên dưới
 428:Lib/Driver/driver.c **** 	
 429:Lib/Driver/driver.c **** 	// Trigger từ TIM1_CC4, Rising Edge
 430:Lib/Driver/driver.c **** 	ADC1->CR2 |= (0 << ADC_CR2_JEXTSEL_Pos) | (2 << ADC_CR2_JEXTEN_Pos); 
 431:Lib/Driver/driver.c **** 	
ARM GAS  /tmp/cc50ZnNR.s 			page 14


 432:Lib/Driver/driver.c **** 	// Chuỗi Injected: 3 chuyển đổi (JL = 2)
 433:Lib/Driver/driver.c **** 	ADC1->JSQR = (2 << ADC_JSQR_JL_Pos)   |  // JL = 2 (Đọc 3 kênh)
 434:Lib/Driver/driver.c **** 	             (0 << ADC_JSQR_JSQ2_Pos) |  // Lượt 1: Channel 0 (PA0)
 435:Lib/Driver/driver.c **** 	             (4 << ADC_JSQR_JSQ3_Pos) |  // Lượt 2: Channel 4 (PA4)
 436:Lib/Driver/driver.c **** 	             (6 << ADC_JSQR_JSQ4_Pos);   // Lượt 3: Channel 6 (PA6)
 437:Lib/Driver/driver.c **** 	
 438:Lib/Driver/driver.c **** 	// Sample Time: 15 Cycles (010)
 439:Lib/Driver/driver.c **** 	ADC1->SMPR2 = (3 << ADC_SMPR2_SMP0_Pos) | 
 440:Lib/Driver/driver.c **** 	              (3 << ADC_SMPR2_SMP4_Pos) | 
 441:Lib/Driver/driver.c **** 	              (3 << ADC_SMPR2_SMP6_Pos);
 442:Lib/Driver/driver.c **** 
 443:Lib/Driver/driver.c **** 
 444:Lib/Driver/driver.c **** 	// --- CẤU HÌNH ADC2 (Slave 1 - Pha B) ---
 445:Lib/Driver/driver.c **** 	ADC2->CR1 = ADC_CR1_SCAN; // Không cần bật ngắt ở Slave
 446:Lib/Driver/driver.c **** 	ADC2->CR2 = 0; // Slave không cần cài Trigger (nó nghe theo Master)
 447:Lib/Driver/driver.c **** 	
 448:Lib/Driver/driver.c **** 	// Chuỗi Injected: 3 chuyển đổi (JL = 2)
 449:Lib/Driver/driver.c **** 	ADC2->JSQR = (2 << ADC_JSQR_JL_Pos)   |  // JL = 2 (Đọc 3 kênh)
 450:Lib/Driver/driver.c **** 	             (1 << ADC_JSQR_JSQ2_Pos) |  // Lượt 1: Channel 1 (PA1)
 451:Lib/Driver/driver.c **** 	             (5 << ADC_JSQR_JSQ3_Pos) |  // Lượt 2: Channel 5 (PA5)
 452:Lib/Driver/driver.c **** 	             (5 << ADC_JSQR_JSQ4_Pos);   // Lượt 3: Channel 5 (Lặp lại cho đủ chuỗi)
 453:Lib/Driver/driver.c **** 	
 454:Lib/Driver/driver.c **** 	// Sample Time: 15 Cycles
 455:Lib/Driver/driver.c **** 	ADC2->SMPR2 = (3 << ADC_SMPR2_SMP1_Pos) | 
 456:Lib/Driver/driver.c **** 	              (3 << ADC_SMPR2_SMP5_Pos);
 457:Lib/Driver/driver.c **** 
 458:Lib/Driver/driver.c **** 
 459:Lib/Driver/driver.c **** 	// --- CẤU HÌNH ADC3 (Slave 2 - Pha C) ---
 460:Lib/Driver/driver.c **** 	ADC3->CR1 = ADC_CR1_SCAN;
 461:Lib/Driver/driver.c **** 	ADC3->CR2 = 0;
 462:Lib/Driver/driver.c **** 	
 463:Lib/Driver/driver.c **** 	// Chuỗi Injected: 3 chuyển đổi (JL = 2)
 464:Lib/Driver/driver.c **** 	ADC3->JSQR = (2 << ADC_JSQR_JL_Pos)   |  // JL = 2 (Đọc 3 kênh)
 465:Lib/Driver/driver.c **** 	             (2 << ADC_JSQR_JSQ2_Pos) |  // Lượt 1: Channel 2 (PA2)
 466:Lib/Driver/driver.c **** 	             (3 << ADC_JSQR_JSQ3_Pos) |  // Lượt 2: Channel 3 (PA3)
 467:Lib/Driver/driver.c **** 	             (3 << ADC_JSQR_JSQ4_Pos);   // Lượt 3: Channel 3 (Lặp lại cho đủ chuỗi)
 468:Lib/Driver/driver.c **** 	
 469:Lib/Driver/driver.c **** 	// Sample Time: 15 Cycles
 470:Lib/Driver/driver.c **** 	ADC3->SMPR2 = (3 << ADC_SMPR2_SMP2_Pos) | 
 471:Lib/Driver/driver.c **** 	              (3 << ADC_SMPR2_SMP3_Pos);
 472:Lib/Driver/driver.c **** 
 473:Lib/Driver/driver.c **** 	// ---- BẬT VÀ KÍCH HOAT ----
 474:Lib/Driver/driver.c **** 	NVIC_SetPriority(ADC_IRQn, 6);
 475:Lib/Driver/driver.c **** 	NVIC_EnableIRQ(ADC_IRQn);
 476:Lib/Driver/driver.c **** 
 477:Lib/Driver/driver.c **** 	ADC1->CR2 |= ADC_CR2_ADON;
 478:Lib/Driver/driver.c **** 	ADC2->CR2 |= ADC_CR2_ADON;
 479:Lib/Driver/driver.c **** 	ADC3->CR2 |= ADC_CR2_ADON;
 480:Lib/Driver/driver.c **** }
 481:Lib/Driver/driver.c **** 
 482:Lib/Driver/driver.c **** #endif
