 278:Core/Src/driver.c **** 
 279:Core/Src/driver.c **** 
 280:Core/Src/driver.c **** // =================================================1=========
 281:Core/Src/driver.c **** // 					CONFIG TIM & PWM ( EDIT HERE )
 282:Core/Src/driver.c **** // ==========================================================
 283:Core/Src/driver.c **** #ifdef __TIM_CONFIG__
 284:Core/Src/driver.c **** 
 285:Core/Src/driver.c **** void TIM_PWM_DMA_CONFIG(void) {
 286:Core/Src/driver.c **** 	// 1. B?t Clock 
 287:Core/Src/driver.c **** 	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN | RCC_AHB1ENR_GPIOBEN | RCC_AHB1ENR_GPIOCEN;
 288:Core/Src/driver.c **** 	RCC->AHB1ENR |= RCC_AHB1ENR_DMA2EN; 
 289:Core/Src/driver.c **** 	RCC->APB2ENR |= RCC_APB2ENR_TIM1EN;
 290:Core/Src/driver.c **** 
 291:Core/Src/driver.c **** 	// 2. GPIO Config 
 292:Core/Src/driver.c **** 
 293:Core/Src/driver.c **** 	GPIO_TIM_PWM_INIT();
 294:Core/Src/driver.c **** 	
 295:Core/Src/driver.c **** 	TIM1->CR1 &= ~TIM_CR1_CEN;
 296:Core/Src/driver.c **** 	
 297:Core/Src/driver.c **** 
 298:Core/Src/driver.c **** 	TIM1->CR1 &= ~TIM_CR1_CMS;
 299:Core/Src/driver.c **** 	TIM1->CR1 |= TIM_CR1_CMS_0; 
 300:Core/Src/driver.c **** 	
 301:Core/Src/driver.c **** 	// Auto-reload preload enable (ARPE)
 302:Core/Src/driver.c **** 	TIM1->CR1 |= TIM_CR1_ARPE;
 303:Core/Src/driver.c **** 
 304:Core/Src/driver.c **** 	TIM1->RCR = 0;
 305:Core/Src/driver.c **** 
 306:Core/Src/driver.c **** 	TIM1->CCMR1 = 0;
 307:Core/Src/driver.c **** 	TIM1->CCMR2 = 0;
 308:Core/Src/driver.c **** // CH4 ở chế độ PWM Mode 1 (110)
 309:Core/Src/driver.c **** 	TIM1->CCMR2 &= ~TIM_CCMR2_OC4M;
 310:Core/Src/driver.c **** 	TIM1->CCMR2 |= (6U << TIM_CCMR2_OC4M_Pos);
 311:Core/Src/driver.c **** 	// CH1: PWM Mode 1 (110), Preload Enable (OC1PE)
 312:Core/Src/driver.c **** 	TIM1->CCMR1 |= (6U << TIM_CCMR1_OC1M_Pos) | TIM_CCMR1_OC1PE;
 313:Core/Src/driver.c **** 	// CH2: PWM Mode 1 (110), Preload Enable (OC2PE)
 314:Core/Src/driver.c **** 	TIM1->CCMR1 |= (6U << TIM_CCMR1_OC2M_Pos) | TIM_CCMR1_OC2PE;
 315:Core/Src/driver.c **** 	// CH3: PWM Mode 1 (110), Preload Enable (OC3PE)
 316:Core/Src/driver.c **** 	TIM1->CCMR2 |= (6U << TIM_CCMR1_OC1M_Pos) | TIM_CCMR2_OC3PE; 
 317:Core/Src/driver.c **** 
ARM GAS  /tmp/ccAVb8bN.s 			page 12


 318:Core/Src/driver.c **** 	// 5. Channel Enable (CCER)
 319:Core/Src/driver.c **** 	// CH1, CH1N, CH2, CH2N, CH3, CH3N, CH4
 320:Core/Src/driver.c **** 
 321:Core/Src/driver.c **** 	TIM1->CCER |= (TIM_CCER_CC1E | TIM_CCER_CC1NE |
 322:Core/Src/driver.c **** 								 TIM_CCER_CC2E | TIM_CCER_CC2NE | 
 323:Core/Src/driver.c **** 								 TIM_CCER_CC3E | TIM_CCER_CC3NE |
 324:Core/Src/driver.c **** 								 TIM_CCER_CC4E);
 325:Core/Src/driver.c **** 
 326:Core/Src/driver.c **** 	// 6. Break & Deadtime (BDTR)
 327:Core/Src/driver.c **** 	TIM1->BDTR = 0; // Reset
 328:Core/Src/driver.c **** 	
 329:Core/Src/driver.c **** 	TIM1->BDTR |= TIM_BDTR_OSSI | TIM_BDTR_OSSR;
 330:Core/Src/driver.c **** 
 331:Core/Src/driver.c **** 	// DEADTIME (DTG):
 332:Core/Src/driver.c **** 	TIM1->BDTR &= ~TIM_BDTR_DTG; 
 333:Core/Src/driver.c **** 	TIM1->BDTR |= (5 << TIM_BDTR_DTG_Pos);
 334:Core/Src/driver.c **** 	// MOE: Main Output Enable 
 335:Core/Src/driver.c **** 	TIM1->BDTR |= TIM_BDTR_MOE;
 336:Core/Src/driver.c **** 	// 7. Interrupt & DMA Request
 337:Core/Src/driver.c **** 	TIM1->EGR |= TIM_EGR_UG;
 338:Core/Src/driver.c ****     
 339:Core/Src/driver.c **** 	// 2. PHẢI XÓA CỜ NGẮT NGAY LẬP TỨC
 340:Core/Src/driver.c **** 	// Để tránh việc CPU nhảy vào ngắt ngay khi cho phép NVIC
 341:Core/Src/driver.c **** 	TIM1->SR = 0; // Xóa sạch mọi cờ báo trạng thái (đặc biệt là TIM_SR_UIF)
 342:Core/Src/driver.c **** 
 343:Core/Src/driver.c **** 	// 3. Bây giờ mới được phép bật ngắt trong Timer
 344:Core/Src/driver.c **** //	TIM1->DIER |= TIM_DIER_UIE;
 345:Core/Src/driver.c **** // 9. Enable Counter
 346:Core/Src/driver.c **** //	TIM1->CR1 |= TIM_CR1_CEN;
 347:Core/Src/driver.c **** 	
 348:Core/Src/driver.c **** 	// NVIC Config
 349:Core/Src/driver.c **** //	NVIC_SetPriority(TIM1_UP_TIM10_IRQn, 4);
 350:Core/Src/driver.c **** //	NVIC_EnableIRQ(TIM1_UP_TIM10_IRQn);
 351:Core/Src/driver.c **** }
 352:Core/Src/driver.c **** //
 353:Core/Src/driver.c **** 
 354:Core/Src/driver.c **** void TIM_COUNTER_ENABLE(TIM_TypeDef *Timx){
 355:Core/Src/driver.c **** 	Timx->CR1 |= TIM_CR1_CEN;
 356:Core/Src/driver.c **** 	
 357:Core/Src/driver.c **** }
 358:Core/Src/driver.c **** //
 359:Core/Src/driver.c **** 
 360:Core/Src/driver.c **** void TIM_COUNT_US_CONFIG(void){
 361:Core/Src/driver.c **** 	RCC->APB2ENR |= RCC_APB2ENR_TIM10EN;
 362:Core/Src/driver.c **** 
 363:Core/Src/driver.c **** 	TIM10->PSC = 167;
 364:Core/Src/driver.c **** 	TIM10->ARR = 0xFFFF;
 365:Core/Src/driver.c **** 	TIM10->EGR |= TIM_EGR_UG;
 366:Core/Src/driver.c **** 
 367:Core/Src/driver.c **** }
 368:Core/Src/driver.c **** //
 369:Core/Src/driver.c **** 
 370:Core/Src/driver.c **** void TIM_IQR_MS_CONGFIG(){
 371:Core/Src/driver.c **** 	RCC->APB1ENR |= RCC_APB1ENR_TIM3EN;
 372:Core/Src/driver.c **** 	TIM3->PSC = 839;  
 373:Core/Src/driver.c **** 	TIM3->ARR = 999;  
 374:Core/Src/driver.c **** 	TIM3->EGR |= TIM_EGR_UG;
ARM GAS  /tmp/ccAVb8bN.s 			page 13


 375:Core/Src/driver.c **** 	TIM3->SR &= ~TIM_SR_UIF;
 376:Core/Src/driver.c **** 	TIM3->DIER |= TIM_DIER_UIE; 
 377:Core/Src/driver.c **** 	NVIC_SetPriority(TIM3_IRQn, 6);
 378:Core/Src/driver.c **** 	NVIC_EnableIRQ(TIM3_IRQn);     
 379:Core/Src/driver.c **** }
 380:Core/Src/driver.c **** //
 381:Core/Src/driver.c **** #endif
 382:Core/Src/driver.c **** 
 383:Core/Src/driver.c **** 
 384:Core/Src/driver.c **** 
 385:Core/Src/driver.c **** // ==========================================================
 386:Core/Src/driver.c **** //				  CONFIG ADC & DMA ( EDIT HERE )
 387:Core/Src/driver.c **** // ==========================================================
 388:Core/Src/driver.c **** #ifdef __ADC_CONFIG__
 389:Core/Src/driver.c **** 
 390:Core/Src/driver.c **** void ADC_DMA_CONFIG(void) {
 391:Core/Src/driver.c **** 	// 1. Bật Clock cho cả 3 ADC
 392:Core/Src/driver.c **** 	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
 393:Core/Src/driver.c **** 	RCC->APB2ENR |= RCC_APB2ENR_ADC1EN | RCC_APB2ENR_ADC2EN | RCC_APB2ENR_ADC3EN;
 394:Core/Src/driver.c **** 
 395:Core/Src/driver.c **** 	// 2. Cấu hình GPIO (PA0, PA1, PA2) -> Analog
 396:Core/Src/driver.c **** 	GPIOA->MODER |= 0x3FFF; 
 397:Core/Src/driver.c **** 	GPIOA->PUPDR &= ~0x3FFF;
 398:Core/Src/driver.c **** 
 399:Core/Src/driver.c **** 	// 3. Cấu hình chung cho khối ADC (ADC_CCR)
 400:Core/Src/driver.c **** 	// ADCPRE = 01 (Chia 4 -> 21MHz)
 401:Core/Src/driver.c **** 	// MULTI = 10101 (Triple Injected simultaneous mode only) - Xem RM0090 Table 62
 402:Core/Src/driver.c **** 	// DMA = 0 (Không cần DMA cho Injected)
 403:Core/Src/driver.c **** 	ADC->CCR = (1 << ADC_CCR_ADCPRE_Pos) | 
 404:Core/Src/driver.c **** 						 (0x15 << ADC_CCR_MULTI_Pos); 
 405:Core/Src/driver.c **** 
 406:Core/Src/driver.c **** 	// --- CẤU HÌNH ADC1 (Master - Pha A) ---
 407:Core/Src/driver.c **** 	ADC1->CR1 = ADC_CR1_SCAN | ADC_CR1_JEOCIE; // Bật ngắt JEOC ở Master
 408:Core/Src/driver.c **** 	ADC1->CR2 = 0; // Trigger cài bên dưới
 409:Core/Src/driver.c **** 	
 410:Core/Src/driver.c **** 	// Trigger từ TIM1_CC4, Rising Edge
 411:Core/Src/driver.c **** 	ADC1->CR2 |= (0 << ADC_CR2_JEXTSEL_Pos) | (2 << ADC_CR2_JEXTEN_Pos); 
 412:Core/Src/driver.c **** 	
 413:Core/Src/driver.c **** 	// Chuỗi Injected: 3 chuyển đổi (JL = 2)
 414:Core/Src/driver.c **** 	ADC1->JSQR = (2 << ADC_JSQR_JL_Pos)   |  // JL = 2 (Đọc 3 kênh)
 415:Core/Src/driver.c **** 	             (0 << ADC_JSQR_JSQ2_Pos) |  // Lượt 1: Channel 0 (PA0)
 416:Core/Src/driver.c **** 	             (4 << ADC_JSQR_JSQ3_Pos) |  // Lượt 2: Channel 4 (PA4)
 417:Core/Src/driver.c **** 	             (6 << ADC_JSQR_JSQ4_Pos);   // Lượt 3: Channel 6 (PA6)
 418:Core/Src/driver.c **** 	
 419:Core/Src/driver.c **** 	// Sample Time: 15 Cycles (010)
 420:Core/Src/driver.c **** 	ADC1->SMPR2 = (3 << ADC_SMPR2_SMP0_Pos) | 
 421:Core/Src/driver.c **** 	              (3 << ADC_SMPR2_SMP4_Pos) | 
 422:Core/Src/driver.c **** 	              (3 << ADC_SMPR2_SMP6_Pos);
 423:Core/Src/driver.c **** 
 424:Core/Src/driver.c **** 
 425:Core/Src/driver.c **** 	// --- CẤU HÌNH ADC2 (Slave 1 - Pha B) ---
 426:Core/Src/driver.c **** 	ADC2->CR1 = ADC_CR1_SCAN; // Không cần bật ngắt ở Slave
 427:Core/Src/driver.c **** 	ADC2->CR2 = 0; // Slave không cần cài Trigger (nó nghe theo Master)
 428:Core/Src/driver.c **** 	
 429:Core/Src/driver.c **** 	// Chuỗi Injected: 3 chuyển đổi (JL = 2)
 430:Core/Src/driver.c **** 	ADC2->JSQR = (2 << ADC_JSQR_JL_Pos)   |  // JL = 2 (Đọc 3 kênh)
 431:Core/Src/driver.c **** 	             (1 << ADC_JSQR_JSQ2_Pos) |  // Lượt 1: Channel 1 (PA1)
ARM GAS  /tmp/ccAVb8bN.s 			page 14


 432:Core/Src/driver.c **** 	             (5 << ADC_JSQR_JSQ3_Pos) |  // Lượt 2: Channel 5 (PA5)
 433:Core/Src/driver.c **** 	             (5 << ADC_JSQR_JSQ4_Pos);   // Lượt 3: Channel 5 (Lặp lại cho đủ chuỗi)
 434:Core/Src/driver.c **** 	
 435:Core/Src/driver.c **** 	// Sample Time: 15 Cycles
 436:Core/Src/driver.c **** 	ADC2->SMPR2 = (3 << ADC_SMPR2_SMP1_Pos) | 
 437:Core/Src/driver.c **** 	              (3 << ADC_SMPR2_SMP5_Pos);
 438:Core/Src/driver.c **** 
 439:Core/Src/driver.c **** 
 440:Core/Src/driver.c **** 	// --- CẤU HÌNH ADC3 (Slave 2 - Pha C) ---
 441:Core/Src/driver.c **** 	ADC3->CR1 = ADC_CR1_SCAN;
 442:Core/Src/driver.c **** 	ADC3->CR2 = 0;
 443:Core/Src/driver.c **** 	
 444:Core/Src/driver.c **** 	// Chuỗi Injected: 3 chuyển đổi (JL = 2)
 445:Core/Src/driver.c **** 	ADC3->JSQR = (2 << ADC_JSQR_JL_Pos)   |  // JL = 2 (Đọc 3 kênh)
 446:Core/Src/driver.c **** 	             (2 << ADC_JSQR_JSQ2_Pos) |  // Lượt 1: Channel 2 (PA2)
 447:Core/Src/driver.c **** 	             (3 << ADC_JSQR_JSQ3_Pos) |  // Lượt 2: Channel 3 (PA3)
 448:Core/Src/driver.c **** 	             (3 << ADC_JSQR_JSQ4_Pos);   // Lượt 3: Channel 3 (Lặp lại cho đủ chuỗi)
 449:Core/Src/driver.c **** 	
 450:Core/Src/driver.c **** 	// Sample Time: 15 Cycles
 451:Core/Src/driver.c **** 	ADC3->SMPR2 = (3 << ADC_SMPR2_SMP2_Pos) | 
 452:Core/Src/driver.c **** 	              (3 << ADC_SMPR2_SMP3_Pos);
 453:Core/Src/driver.c **** 
 454:Core/Src/driver.c **** 	// ---- BẬT VÀ KÍCH HOAT ----
 455:Core/Src/driver.c **** 	NVIC_SetPriority(ADC_IRQn, 6);
 456:Core/Src/driver.c **** 	NVIC_EnableIRQ(ADC_IRQn);
 457:Core/Src/driver.c **** 
 458:Core/Src/driver.c **** 	ADC1->CR2 |= ADC_CR2_ADON;
 459:Core/Src/driver.c **** 	ADC2->CR2 |= ADC_CR2_ADON;
 460:Core/Src/driver.c **** 	ADC3->CR2 |= ADC_CR2_ADON;
 461:Core/Src/driver.c **** }
