 304:Lib/Driver/driver.c **** void TIM_PWM_DMA_CONFIG(void) {
 305:Lib/Driver/driver.c **** 	// 1. B?t Clock 
 306:Lib/Driver/driver.c **** 	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN | RCC_AHB1ENR_GPIOBEN | RCC_AHB1ENR_GPIOCEN;
 307:Lib/Driver/driver.c **** 	RCC->AHB1ENR |= RCC_AHB1ENR_DMA2EN; 
 308:Lib/Driver/driver.c **** 	RCC->APB2ENR |= RCC_APB2ENR_TIM1EN;
 309:Lib/Driver/driver.c **** 
 310:Lib/Driver/driver.c **** 	// 2. GPIO Config 
 311:Lib/Driver/driver.c **** 
 312:Lib/Driver/driver.c **** 	GPIO_TIM_PWM_INIT();
 313:Lib/Driver/driver.c **** 	
 314:Lib/Driver/driver.c **** 	TIM1->CR1 &= ~TIM_CR1_CEN;
 315:Lib/Driver/driver.c **** 	
 316:Lib/Driver/driver.c **** 
 317:Lib/Driver/driver.c **** 	TIM1->CR1 &= ~TIM_CR1_CMS;
ARM GAS  /tmp/cc50ZnNR.s 			page 12


 318:Lib/Driver/driver.c **** 	TIM1->CR1 |= TIM_CR1_CMS_0; 
 319:Lib/Driver/driver.c **** 	
 320:Lib/Driver/driver.c **** 	// Auto-reload preload enable (ARPE)
 321:Lib/Driver/driver.c **** 	TIM1->CR1 |= TIM_CR1_ARPE;
 322:Lib/Driver/driver.c **** 
 323:Lib/Driver/driver.c **** 	TIM1->RCR = 0;
 324:Lib/Driver/driver.c **** 
 325:Lib/Driver/driver.c **** 	TIM1->CCMR1 = 0;
 326:Lib/Driver/driver.c **** 	TIM1->CCMR2 = 0;
 327:Lib/Driver/driver.c **** // CH4 ở chế độ PWM Mode 1 (110)
 328:Lib/Driver/driver.c **** 	TIM1->CCMR2 &= ~TIM_CCMR2_OC4M;
 329:Lib/Driver/driver.c **** 	TIM1->CCMR2 |= (6U << TIM_CCMR2_OC4M_Pos);
 330:Lib/Driver/driver.c **** 	// CH1: PWM Mode 1 (110), Preload Enable (OC1PE)
 331:Lib/Driver/driver.c **** 	TIM1->CCMR1 |= (6U << TIM_CCMR1_OC1M_Pos) | TIM_CCMR1_OC1PE;
 332:Lib/Driver/driver.c **** 	// CH2: PWM Mode 1 (110), Preload Enable (OC2PE)
 333:Lib/Driver/driver.c **** 	TIM1->CCMR1 |= (6U << TIM_CCMR1_OC2M_Pos) | TIM_CCMR1_OC2PE;
 334:Lib/Driver/driver.c **** 	// CH3: PWM Mode 1 (110), Preload Enable (OC3PE)
 335:Lib/Driver/driver.c **** 	TIM1->CCMR2 |= (6U << TIM_CCMR1_OC1M_Pos) | TIM_CCMR2_OC3PE; 
 336:Lib/Driver/driver.c **** 
 337:Lib/Driver/driver.c **** 	// 5. Channel Enable (CCER)
 338:Lib/Driver/driver.c **** 	// CH1, CH1N, CH2, CH2N, CH3, CH3N, CH4
 339:Lib/Driver/driver.c **** 
 340:Lib/Driver/driver.c **** 	TIM1->CCER |= (TIM_CCER_CC1E | TIM_CCER_CC1NE |
 341:Lib/Driver/driver.c **** 								 TIM_CCER_CC2E | TIM_CCER_CC2NE | 
 342:Lib/Driver/driver.c **** 								 TIM_CCER_CC3E | TIM_CCER_CC3NE |
 343:Lib/Driver/driver.c **** 								 TIM_CCER_CC4E);
 344:Lib/Driver/driver.c **** 
 345:Lib/Driver/driver.c **** 	// 6. Break & Deadtime (BDTR)
 346:Lib/Driver/driver.c **** 	TIM1->BDTR = 0; // Reset
 347:Lib/Driver/driver.c **** 	
 348:Lib/Driver/driver.c **** 	TIM1->BDTR |= TIM_BDTR_OSSI | TIM_BDTR_OSSR;
 349:Lib/Driver/driver.c **** 
 350:Lib/Driver/driver.c **** 	// DEADTIME (DTG):
 351:Lib/Driver/driver.c **** 	TIM1->BDTR &= ~TIM_BDTR_DTG; 
 352:Lib/Driver/driver.c **** 	TIM1->BDTR |= (5 << TIM_BDTR_DTG_Pos);
 353:Lib/Driver/driver.c **** 	// MOE: Main Output Enable 
 354:Lib/Driver/driver.c **** 	TIM1->BDTR |= TIM_BDTR_MOE;
 355:Lib/Driver/driver.c **** 	// 7. Interrupt & DMA Request
 356:Lib/Driver/driver.c **** 	TIM1->EGR |= TIM_EGR_UG;
 357:Lib/Driver/driver.c ****     
 358:Lib/Driver/driver.c **** 	// 2. PHẢI XÓA CỜ NGẮT NGAY LẬP TỨC
 359:Lib/Driver/driver.c **** 	// Để tránh việc CPU nhảy vào ngắt ngay khi cho phép NVIC
 360:Lib/Driver/driver.c **** 	TIM1->SR = 0; // Xóa sạch mọi cờ báo trạng thái (đặc biệt là TIM_SR_UIF)
 361:Lib/Driver/driver.c **** 
 362:Lib/Driver/driver.c **** 	// 3. Bây giờ mới được phép bật ngắt trong Timer
 363:Lib/Driver/driver.c **** //	TIM1->DIER |= TIM_DIER_UIE;
 364:Lib/Driver/driver.c **** // 9. Enable Counter
 365:Lib/Driver/driver.c **** //	TIM1->CR1 |= TIM_CR1_CEN;
 366:Lib/Driver/driver.c **** 	
 367:Lib/Driver/driver.c **** 	// NVIC Config
 368:Lib/Driver/driver.c **** //	NVIC_SetPriority(TIM1_UP_TIM10_IRQn, 4);
 369:Lib/Driver/driver.c **** //	NVIC_EnableIRQ(TIM1_UP_TIM10_IRQn);
 370:Lib/Driver/driver.c **** }
 371:Lib/Driver/driver.c **** //
 372:Lib/Driver/driver.c **** 
 373:Lib/Driver/driver.c **** void TIM_COUNTER_ENABLE(TIM_TypeDef *Timx){
 374:Lib/Driver/driver.c **** 	Timx->CR1 |= TIM_CR1_CEN;
ARM GAS  /tmp/cc50ZnNR.s 			page 13


 375:Lib/Driver/driver.c **** 	
 376:Lib/Driver/driver.c **** }
 377:Lib/Driver/driver.c **** //
 378:Lib/Driver/driver.c **** 
 379:Lib/Driver/driver.c **** void TIM_COUNT_US_CONFIG(void){
 380:Lib/Driver/driver.c **** 	RCC->APB2ENR |= RCC_APB2ENR_TIM10EN;
 381:Lib/Driver/driver.c **** 
 382:Lib/Driver/driver.c **** 	TIM10->PSC = 167;
 383:Lib/Driver/driver.c **** 	TIM10->ARR = 0xFFFF;
 384:Lib/Driver/driver.c **** 	TIM10->EGR |= TIM_EGR_UG;
 385:Lib/Driver/driver.c **** 
 386:Lib/Driver/driver.c **** }
 387:Lib/Driver/driver.c **** //
 388:Lib/Driver/driver.c **** 
 389:Lib/Driver/driver.c **** void TIM_IQR_MS_CONGFIG(){
 390:Lib/Driver/driver.c **** 	RCC->APB1ENR |= RCC_APB1ENR_TIM3EN;
 391:Lib/Driver/driver.c **** 	TIM3->PSC = 839;  
 392:Lib/Driver/driver.c **** 	TIM3->ARR = 999;  
 393:Lib/Driver/driver.c **** 	TIM3->EGR |= TIM_EGR_UG;
 394:Lib/Driver/driver.c **** 	TIM3->SR &= ~TIM_SR_UIF;
 395:Lib/Driver/driver.c **** 	TIM3->DIER |= TIM_DIER_UIE; 
 396:Lib/Driver/driver.c **** 	NVIC_SetPriority(TIM3_IRQn, 6);
 397:Lib/Driver/driver.c **** 	NVIC_EnableIRQ(TIM3_IRQn);     
 398:Lib/Driver/driver.c **** }
