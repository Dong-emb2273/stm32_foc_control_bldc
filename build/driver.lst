 897:Core/Src/driver.c **** void CRC_DMA_CONFIG(void){
 898:Core/Src/driver.c ****    
 899:Core/Src/driver.c **** 	RCC->AHB1ENR |= RCC_AHB1ENR_CRCEN;
 900:Core/Src/driver.c **** 	RCC->AHB1ENR |= RCC_AHB1ENR_DMA2EN;
 901:Core/Src/driver.c **** 
 902:Core/Src/driver.c **** 	CRC->CR |= CRC_CR_RESET;
 903:Core/Src/driver.c **** 	
 904:Core/Src/driver.c **** 	CRC_DMA_STREAM->CR = 0;
 905:Core/Src/driver.c **** 	while(CRC_DMA_STREAM->CR & DMA_SxCR_EN);
 906:Core/Src/driver.c **** 
 907:Core/Src/driver.c **** 	CRC_DMA_STREAM->M0AR = (uint32_t)&(CRC->DR);
 908:Core/Src/driver.c **** 	CRC_DMA_STREAM->CR |= (0 << DMA_SxCR_CHSEL_Pos) | // Kênh nào cũng được trong M2M
 909:Core/Src/driver.c **** 												(2 << DMA_SxCR_PL_Pos)    | // Priority: High (để tính cho nhanh)
 910:Core/Src/driver.c **** 												(2 << DMA_SxCR_MSIZE_Pos) | // Đích (M0AR): 32-bit (Word)
 911:Core/Src/driver.c **** 												(2 << DMA_SxCR_PSIZE_Pos) | // Nguồn (PAR): 32-bit (Word)
 912:Core/Src/driver.c **** 												(0 << DMA_SxCR_MINC_Pos)  | // Đích (CRC->DR): KHÔNG tăng địa chỉ (MINC=0)
 913:Core/Src/driver.c **** 												(1 << DMA_SxCR_PINC_Pos)  | // Nguồn (Buffer): CÓ tăng địa chỉ (PINC=1)
 914:Core/Src/driver.c **** 												(2 << DMA_SxCR_DIR_Pos);    // DIR = 10: Memory-to-Memory Mode
 915:Core/Src/driver.c **** 												
 916:Core/Src/driver.c **** }
 917:Core/Src/driver.c **** //
 918:Core/Src/driver.c **** 
 919:Core/Src/driver.c **** uint32_t CRC_Calculate_DMA(uint8_t *pBuffer, uint32_t length){
 920:Core/Src/driver.c **** 	CRC->CR |= CRC_CR_RESET;
 921:Core/Src/driver.c **** 
 922:Core/Src/driver.c **** 	CRC_DMA_STREAM->CR &= ~DMA_SxCR_EN;
 923:Core/Src/driver.c **** 	while(CRC_DMA_STREAM->CR & DMA_SxCR_EN);
 924:Core/Src/driver.c **** 
 925:Core/Src/driver.c **** 	CRC_DMA_CLR_REG |= CRC_DMA_CTCIF_FLAG;
 926:Core/Src/driver.c **** 	CRC_DMA_STREAM->PAR = (uint32_t)pBuffer;
 927:Core/Src/driver.c **** 	CRC_DMA_STREAM->NDTR = length;
 928:Core/Src/driver.c **** 	CRC_DMA_STREAM->CR |= DMA_SxCR_EN;
 929:Core/Src/driver.c **** 
 930:Core/Src/driver.c **** 	while (!(CRC_DMA_STAT_REG & CRC_DMA_TCIF_FLAG));
 931:Core/Src/driver.c **** 	
 932:Core/Src/driver.c **** 	return CRC->DR;
 933:Core/Src/driver.c **** }
